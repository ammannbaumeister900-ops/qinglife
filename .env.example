# Java API
QINGLIFE_DB_URL=jdbc:mysql://127.0.0.1:3306/qinglife?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
QINGLIFE_DB_USERNAME=qinglife
QINGLIFE_DB_PASSWORD=
QINGLIFE_REDIS_PASSWORD=
QINGLIFE_JWT_SECRET=change-me-before-running
QINGLIFE_ADMIN_TOKEN_EXPIRE_MINUTES=480
QINGLIFE_APP_TOKEN_EXPIRE_MINUTES=1440

# Monitoring
QINGLIFE_DRUID_USERNAME=admin
QINGLIFE_DRUID_PASSWORD=
QINGLIFE_MONITOR_USERNAME=admin
QINGLIFE_MONITOR_PASSWORD=

# Object storage; configure only the provider in use
QINGLIFE_OSS_PROVIDER=disabled
QINGLIFE_OSS_ENDPOINT=
QINGLIFE_OSS_BUCKET=
QINGLIFE_OSS_HTTPS=true
QINGLIFE_OSS_ALLOW_INSECURE_INTERNAL=false
QINGLIFE_OSS_ACCESS_KEY=
QINGLIFE_OSS_SECRET_KEY=
QINGLIFE_OSS_ACCESS_KEY_ID=
QINGLIFE_OSS_ACCESS_KEY_SECRET=
QINGLIFE_OSS_SECRET_ID=

# Connection and mini-program authentication
QINGLIFE_REDIS_HOST=127.0.0.1
QINGLIFE_REDIS_PORT=6379
QINGLIFE_REDIS_SSL=false
# Set true only for a password-protected Redis on a verified private/loopback network.
QINGLIFE_REDIS_ALLOW_INSECURE_INTERNAL=false
QINGLIFE_WECHAT_ENABLED=false
QINGLIFE_WECHAT_APP_ID=
QINGLIFE_WECHAT_APP_SECRET=
QINGLIFE_PUBLIC_IMAGE_BASE_URL=https://static.example.invalid/
QINGLIFE_MAX_HTTP_POST_SIZE=20MB
QINGLIFE_MAX_FILE_SIZE=10MB
QINGLIFE_MAX_REQUEST_SIZE=20MB
# Set SPRING_PROFILES_ACTIVE=prod for production. The prod startup guard refuses
# empty database/Redis passwords, long-lived tokens, unreviewed OSS settings,
# an example/short JWT secret, insecure public endpoints, or broad Actuator exposure.
