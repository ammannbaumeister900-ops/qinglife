/* 轻生活前端产品设计规范 V1.1 · 呼吸的纸面 */

page {
  /* 基础色 */
  --ql-bg: #F6F1E8;
  --ql-bg-deep: #EDE6D7;
  --ql-surface: #FFFCF7;
  --ql-ink: #26231F;
  --ql-ink-light: #6B6560;
  --ql-ink-ghost: #9A938A;
  --ql-border: rgba(74, 61, 49, 0.12);
  /* 品牌与情绪色 */
  --ql-clay: #B78369;
  --ql-clay-deep: #A85B3A;
  --ql-clay-soft: #D8C1AD;
  --ql-sage: #A6B6A2;
  --ql-sage-deep: #7C8F78;
  --ql-mist: #C3D0D6;
  --ql-lavender: #C8BDC9;
  --ql-warning: #A87C3E;
  --ql-disabled: #AAA39C;
  /* tinted 纸卡底 */
  --ql-tint-sage: #EDF1EA;
  --ql-tint-clay: #F2E6DC;
  --ql-tint-mist: #EAF0F1;
  --ql-tint-lavender: #EEE8EF;
  /* 圆角与阴影 */
  --ql-radius-card: 44rpx;
  --ql-radius-inner: 36rpx;
  --ql-radius-control: 32rpx;
  --ql-shadow-card: 0 28rpx 76rpx rgba(70, 52, 36, 0.07);
  --ql-shadow-hero: 0 28rpx 76rpx rgba(70, 52, 36, 0.08);
  /* 页面空气层主色（各频道覆写） */
  --ql-air-a: rgba(216, 193, 173, 0.30);
  --ql-air-b: rgba(166, 182, 162, 0.18);
  /* 字体栈 */
  --ql-serif: "Songti SC", "STSong", "SimSun", serif;

  min-height: 100%;
  background: var(--ql-bg);
  color: var(--ql-ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

button {
  box-sizing: border-box;
  font: inherit;
}

button::after { border: none; }

/* ---------- 页面骨架：晨光落在纸面 ---------- */

.page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 48rpx calc(190rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(155deg, rgba(255, 250, 236, 0.96) 0%, rgba(246, 241, 232, 0.96) 100%),
    url("data:image/png;base64,"),
    var(--ql-bg);
  animation: none;
}

/* 空气层：独立伪元素以承载呼吸透明度动效 */
.page::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    radial-gradient(circle at 94% 3%, var(--ql-air-a), transparent 27%),
    radial-gradient(circle at 2% 48%, var(--ql-air-b), transparent 31%);
  pointer-events: none;
  animation: ql-air-breathe 12s ease-in-out infinite;
}

@keyframes ql-air-breathe {
  0%, 100% { opacity: 0.88; }
  50% { opacity: 1; }
}

@keyframes page-soft-enter {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- 字体秩序 ----------
   刊头 64-72 宋 / 情绪 Display 52-60 宋 / 页面题 42-44 宋
   分区 30 黑 600 / 卡题 32 黑 600 / 正文 27 / 说明 23-24 / 注记 20-22 */

.hero-title {
  font-family: var(--ql-serif);
  font-weight: 500;
  line-height: 1.4;
}

/* ---------- 刊物刊头（首页） ---------- */

.masthead {
  position: relative;
  margin-bottom: 40rpx;
}

.masthead-title {
  font-family: var(--ql-serif);
  font-size: 72rpx;
  font-weight: 500;
  letter-spacing: 22rpx;
  line-height: 1.2;
}

.masthead-brand {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.masthead-subtitle {
  margin-top: 10rpx;
  color: var(--ql-ink-ghost);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.masthead-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 18rpx;
  color: var(--ql-ink-light);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.masthead-rule {
  height: 1rpx;
  margin-top: 22rpx;
  background: linear-gradient(90deg, var(--ql-ink) 0 64rpx, var(--ql-border) 64rpx 100%);
}

/* ---------- 直排文字（签名式点缀，每页一处） ---------- */

.vertical {
  writing-mode: vertical-rl;
  font-family: var(--ql-serif);
  letter-spacing: 10rpx;
}

/* ---------- 档案编号分区头：01 ───── 近期轻体营 ---------- */

.index-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 52rpx 0 26rpx;
}

.index-num {
  color: var(--ql-clay);
  font-family: var(--ql-serif);
  font-size: 34rpx;
  line-height: 1;
}

.index-rule {
  height: 1rpx;
  flex: 1;
  background: var(--ql-border);
}

.index-label {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.index-note {
  color: var(--ql-ink-ghost);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* 兼容旧结构 */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 48rpx 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-note {
  color: var(--ql-ink-ghost);
  font-size: 22rpx;
}

/* ---------- 品牌行（次频道页顶） ---------- */

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.brand-cn {
  font-family: var(--ql-serif);
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
}

.brand-en,
.eyebrow {
  color: var(--ql-clay-deep);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.avatar {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  background: var(--ql-clay);
  color: var(--ql-surface);
}

/* ---------- 情绪标题区 ---------- */

.hero {
  position: relative;
  margin-bottom: 36rpx;
}

.hero-title {
  margin: 14rpx 0 18rpx;
  font-size: 52rpx;
}

.hero-copy,
.muted {
  color: var(--ql-ink-light);
  font-size: 27rpx;
  line-height: 1.75;
}

.hero-side {
  position: absolute;
  top: 0;
  right: 0;
  color: var(--ql-ink-ghost);
  font-size: 24rpx;
}

/* ---------- 卡片 ---------- */

.card {
  position: relative;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  border-radius: var(--ql-radius-card);
  background:
    radial-gradient(circle at 100% 0, rgba(226, 209, 193, 0.18), transparent 32%),
    rgba(255, 252, 247, 0.86);
  box-shadow: var(--ql-shadow-card);
}

.card.sage { background: radial-gradient(circle at 96% 4%, rgba(255,255,255,.55), transparent 30%), var(--ql-tint-sage); }
.card.clay { background: radial-gradient(circle at 96% 4%, rgba(255,255,255,.52), transparent 30%), var(--ql-tint-clay); }
.card.mist { background: radial-gradient(circle at 96% 4%, rgba(255,255,255,.55), transparent 30%), var(--ql-tint-mist); }
.card.lavender { background: radial-gradient(circle at 96% 4%, rgba(255,255,255,.52), transparent 30%), var(--ql-tint-lavender); }

.card-title {
  margin: 12rpx 0 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.card-copy {
  color: var(--ql-ink-light);
  font-size: 28rpx;
  line-height: 1.7;
}

/* ---------- 印章（档案印记，品牌签名） ---------- */

.seal {
  display: flex;
  box-sizing: border-box;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(168, 91, 58, 0.8);
  border-radius: 18rpx 24rpx 20rpx 26rpx;
  background: radial-gradient(circle, rgba(183, 131, 105, 0.1), rgba(255, 252, 247, 0.34));
  color: var(--ql-clay-deep);
  font-family: var(--ql-serif);
  font-size: 30rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 252, 247, 0.86);
  transform: rotate(-3deg);
}

.stamp {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 6rpx 18rpx;
  border: 2rpx solid rgba(183, 131, 105, 0.55);
  border-radius: 10rpx;
  color: var(--ql-clay-deep);
  font-family: var(--ql-serif);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  transform: rotate(-4deg);
}

/* ---------- 按钮：全站唯一语言 ---------- */

.primary,
.secondary,
.text-button {
  box-sizing: border-box;
  min-height: 100rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
  border-radius: var(--ql-radius-control);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 100rpx;
  transition: opacity 180ms ease, transform 180ms ease;
}

.primary {
  background: var(--ql-ink);
  color: var(--ql-surface);
}

.primary:active,
.secondary:active,
.text-button:active,
.chip:active,
.concern-tab:active,
.experience-tab:active {
  opacity: 0.86;
  transform: scale(0.98);
}

.secondary {
  border: 1rpx solid var(--ql-border);
  background: rgba(255, 252, 247, 0.8);
  color: var(--ql-ink);
}

.text-button {
  background: transparent;
  color: var(--ql-clay-deep);
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.button-row button {
  flex: 1;
}

/* ---------- 标签与来源 ---------- */

.pill,
.source-badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--ql-tint-sage);
  color: var(--ql-sage-deep);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.pill.warning { background: rgba(168, 124, 62, 0.1); color: var(--ql-warning); }
.pill.disabled { background: rgba(170, 163, 156, 0.14); color: var(--ql-disabled); }
.pill.mist { background: rgba(195, 208, 214, 0.36); color: #596B73; }

.source-badge.demo {
  background: var(--ql-tint-clay);
  color: var(--ql-clay-deep);
}

/* ---------- 选项 ---------- */

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.chip {
  box-sizing: border-box;
  min-height: 88rpx;
  width: auto;
  margin: 0;
  padding: 16rpx 28rpx;
  border: 1rpx solid var(--ql-border);
  border-radius: 999rpx;
  background: rgba(255, 252, 247, 0.9);
  color: var(--ql-ink-light);
  font-size: 28rpx;
  line-height: 1.4;
  transition: opacity 180ms ease, transform 180ms ease, background 180ms ease;
}

.chip.active {
  border-color: rgba(155, 111, 88, 0.4);
  background: var(--ql-tint-clay);
  color: var(--ql-clay-deep);
  font-weight: 500;
}

/* ---------- 表单 ---------- */

.field {
  margin-top: 28rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--ql-border);
  border-radius: var(--ql-radius-inner);
  background: rgba(255, 252, 247, 0.92);
  color: var(--ql-ink);
  font-size: 28rpx;
}

.input {
  height: 96rpx;
  padding: 0 28rpx;
}

.textarea {
  min-height: 200rpx;
  padding: 26rpx 28rpx;
  line-height: 1.7;
}

/* ---------- 列表 ---------- */

.check-row,
.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(74, 61, 49, 0.08);
}

.check-row:last-child,
.list-row:last-child {
  border-bottom: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.list-note {
  display: block;
  margin-top: 8rpx;
  color: var(--ql-ink-light);
  font-size: 23rpx;
  line-height: 1.55;
}

/* ---------- 隐私提示 ---------- */

.privacy-note {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: var(--ql-radius-inner);
  background: rgba(238, 232, 239, 0.66);
  color: #665C68;
  font-size: 24rpx;
  line-height: 1.65;
}

/* ---------- 空态 / 分隔 / 进度 ---------- */

.empty,
.empty-state {
  padding: 72rpx 30rpx;
  text-align: center;
  color: var(--ql-ink-ghost);
  font-size: 25rpx;
}

.empty-state {
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--ql-radius-card);
  background: rgba(255, 252, 247, 0.7);
}

.empty-title {
  color: var(--ql-ink);
  font-family: var(--ql-serif);
  font-size: 32rpx;
  line-height: 1.5;
}

.empty-copy {
  margin-top: 12rpx;
  color: var(--ql-ink-light);
  font-size: 24rpx;
  line-height: 1.65;
}

.empty-action {
  width: auto;
  min-height: 88rpx;
  margin: 28rpx auto 0;
  padding: 0 30rpx;
  border: 1rpx solid var(--ql-border);
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.92);
  color: var(--ql-clay-deep);
  font-size: 26rpx;
  line-height: 88rpx;
}

.divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: rgba(74, 61, 49, 0.09);
}

.progress {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 40rpx;
}

.progress-item {
  height: 8rpx;
  flex: 1;
  border-radius: 999rpx;
  background: rgba(74, 61, 49, 0.12);
}

.progress-item.active {
  background: var(--ql-clay);
}

.safe-bottom { height: 40rpx; }

/* ---------- 编辑感纸页（统一视觉体系） ---------- */

.editorial-page .hero {
  box-sizing: border-box;
  margin-bottom: 32rpx;
  padding: 42rpx 84rpx 42rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  border-radius: var(--ql-radius-card);
  background:
    radial-gradient(circle at 90% 6%, rgba(255, 245, 218, 0.6), transparent 28%),
    linear-gradient(150deg, rgba(255, 252, 247, 0.94), rgba(238, 229, 217, 0.88));
  box-shadow: var(--ql-shadow-hero);
}

.editorial-page .hero .hero-side {
  top: 40rpx;
  right: 30rpx;
  font-size: 23rpx;
}

.editorial-page .hero-title {
  font-size: 46rpx;
  letter-spacing: 1rpx;
}

/* 各频道空气层主色倾向 */
.home-page { --ql-air-a: rgba(216, 193, 173, 0.32); --ql-air-b: rgba(166, 182, 162, 0.18); }
.camp-page { --ql-air-a: rgba(166, 182, 162, 0.26); --ql-air-b: rgba(216, 193, 173, 0.20); }
.content-page { --ql-air-a: rgba(195, 208, 214, 0.32); --ql-air-b: rgba(216, 193, 173, 0.18); }
.friends-page { --ql-air-a: rgba(200, 189, 201, 0.30); --ql-air-b: rgba(195, 208, 214, 0.18); }
.mine-page { --ql-air-a: rgba(200, 189, 201, 0.30); --ql-air-b: rgba(216, 193, 173, 0.18); }
.camp-flow-page { --ql-air-a: rgba(166, 182, 162, 0.24); --ql-air-b: rgba(216, 193, 173, 0.20); }
.friend-flow-page { --ql-air-a: rgba(200, 189, 201, 0.28); --ql-air-b: rgba(166, 182, 162, 0.16); }
.mine-flow-page { --ql-air-a: rgba(200, 189, 201, 0.28); --ql-air-b: rgba(195, 208, 214, 0.16); }

@media (prefers-reduced-motion: reduce) {
  .page,
  .page::before {
    animation: none;
  }
}

/* Stable refresh and consistent multiline button alignment. */
.primary, .secondary, .text-button { display: flex; align-items: center; justify-content: center; line-height: 1.45; padding: 20rpx 28rpx; }
.button-row button { min-width: 0; margin-left: 0; margin-right: 0; }
.refresh-note { position: fixed; top: 180rpx; right: 28rpx; z-index: 5; padding: 8rpx 20rpx; border-radius: 24rpx; background: #F6F1E8; color: #857B70; font-size: 22rpx; }
.sample-note { margin: 20rpx 0; padding: 20rpx 24rpx; background: #ECEFE8; border-radius: 20rpx; font-size: 23rpx; color: #65735E; }
.featured-camp { border: 2rpx solid #BA9278; background: #FFF9EF; }
.feature-label { color: #946548; font-size: 24rpx; margin-bottom: 20rpx; }
