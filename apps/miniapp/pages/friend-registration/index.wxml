<view class="registration-page {{mode === 'form' && !submitted ? 'registration-form' : 'registration-record'}}">
  <view wx:if="{{loading}}" class="loading">正在登录并读取轻友档案…</view>
  <view wx:elif="{{loadError}}" class="loading"><view>{{loadError}}</view><button class="text-button" bindtap="onLoad">重新读取</button></view>
  <view wx:elif="{{mode==='history'}}" class="history-page">
    <view class="history-head"><view class="title">过往登记</view><view class="subtitle">每份记录按提交时间保留。提交后 48 小时内可修改，之后仅可查看。</view></view>
    <view wx:if="{{historyLoading}}" class="history-state">正在读取…</view>
    <view wx:elif="{{historyError}}" class="history-state"><view>{{historyError}}</view><button class="text-button" bindtap="openHistory">重试</button></view>
    <view wx:elif="{{!history.length}}" class="history-state">还没有保存过登记。</view>
    <block wx:else>
    <button wx:for="{{history}}" wx:key="id" class="history-card" data-id="{{item.id}}" bindtap="viewAssessment">
      <view class="history-card-top"><text class="history-number">第 {{history.length-index}} 次登记</text><text class="history-arrow">›</text></view>
      <view class="history-date">{{item.submittedAt}}</view><view class="history-date">{{item.sessionNumber ? '第 '+item.sessionNumber+' 期 · '+item.sessionName : '日常登记'}}</view><view class="history-status {{item.canEdit?'editable':''}}">{{item.canEdit?'可修改至 '+item.editableUntil:'已归档 · 仅查看'}}</view>
    </button>
    </block>
    <button class="history-back" bindtap="returnToForm">返回填写</button>
  </view>
  <view wx:elif="{{mode==='detail'}}" class="history-page">
    <view class="history-head"><view class="title">登记记录</view><view class="subtitle">提交于 {{record.submittedAt}}</view><view class="history-status">{{record.canEdit?'可修改至 '+record.editableUntil:'已归档 · 仅查看'}}</view></view>
    <view wx:if="{{!record.profileSnapshotAvailable}}" class="legacy-note">早期登记未单独保存基本信息，以下基本信息来自当前档案；生活与身体状态为当次记录。</view>
    <view wx:for="{{record.sections}}" wx:key="title" class="record-section"><view class="record-section-title">{{item.title}}</view><view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="record-row"><text class="record-label">{{row.label}}</text><text class="record-value">{{row.value}}</text></view></view>
    <button wx:if="{{record.canEdit}}" class="secondary record-edit" bindtap="editAssessment">修改这次登记</button>
    <button class="history-back" bindtap="openHistory">返回过往登记</button>
  </view>
  <view wx:elif="{{submitted}}" class="success-card">
    <view class="success-mark">✓</view><view class="success-title">{{wasEditing?'修改已保存':'登记已保存'}}</view>
    <view class="success-copy">{{wasEditing?'本次修改已保存，提交时间与修改期限保持不变。':'这是你的第 '+assessmentCount+' 次登记，过往记录已保留。'}}</view><view wx:if="{{savedDeadline}}" class="success-deadline">可修改至 {{savedDeadline}}</view>
    <view wx:if="{{sessionContext && !wasEditing}}" class="success-copy">已归入第 {{sessionContext.sessionNumber}} 期登记记录</view>
    <button class="primary" bindtap="backMine">返回我的</button><button class="text-button" bindtap="registerAgain">再登记一次</button><button class="history-entry" bindtap="openHistory">查看过往登记 ›</button>
  </view>
  <block wx:else>
    <view wx:if="{{sessionContext && !editingId}}" class="session-context"><view class="session-context-label">第 {{sessionContext.sessionNumber}} 期 · 轻友登记</view><view class="session-context-name">{{sessionContext.sessionName}}</view><view class="subtitle">本次填写本人状态，保存至历次档案</view></view>
    <view class="head"><view class="form-steps" aria-label="登记第 {{step}} 步，共 4 步"><view class="form-step {{step === 1 ? 'is-current' : step > 1 ? 'is-complete' : ''}}">1 基本信息</view><view class="form-step {{step === 2 ? 'is-current' : step > 2 ? 'is-complete' : ''}}">2 生活习惯</view><view class="form-step {{step === 3 ? 'is-current' : step > 3 ? 'is-complete' : ''}}">3 近期状态</view><view class="form-step {{step === 4 ? 'is-current' : ''}}">4 参加信息</view></view><view class="title">{{step===1?'基本信息':step===2?'生活习惯':step===3?'近期状态':'参加信息'}}</view><view wx:if="{{editingId || step === 1 || step === 4}}" class="subtitle">{{editingId?'正在修改过往登记，可修改至 '+editDeadline:'每次登记单独保存，提交后 48 小时内可修改。'}}</view><button wx:if="{{editingId}}" class="history-entry" bindtap="cancelEdit">取消修改，返回记录</button></view>
    <view wx:if="{{step===1}}" class="section">
      <view class="field" id="friend-name"><text>姓名 *</text><view wx:if="{{formError.target === 'friend-name'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" value="{{form.name}}" data-field="name" bindinput="field" maxlength="30" placeholder="请输入真实姓名" /></view>
      <view class="field" id="friend-nickname"><text>轻生活小名（老轻友选填）</text><view wx:if="{{formError.target === 'friend-nickname'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" value="{{form.nickname}}" data-field="nickname" bindinput="field" maxlength="50" placeholder="选填" /></view>
      <view class="field" id="friend-birthDate"><text>出生年月日 *</text><view wx:if="{{formError.target === 'friend-birthDate'}}" class="form-error">{{formError.message}}</view><picker mode="date" end="{{today}}" value="{{form.birthDate}}" bindchange="pickDate"><view class="picker {{form.birthDate ? '' : 'is-empty'}}">{{form.birthDate || '请选择日期'}}</view></picker></view>
      <view class="field" id="friend-phone"><text>联系电话 *</text><view wx:if="{{formError.target === 'friend-phone'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" value="{{form.phone}}" data-field="phone" bindinput="field" maxlength="24" placeholder="用于服务联系" /></view>
      <view class="two"><view class="field" id="friend-heightCm"><text>身高（cm）*</text><view wx:if="{{formError.target === 'friend-heightCm'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" type="digit" value="{{form.heightCm}}" data-field="heightCm" bindinput="field" placeholder="80–250" /></view><view class="field" id="friend-weightKg"><text>体重（kg）*</text><view wx:if="{{formError.target === 'friend-weightKg'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" type="digit" value="{{form.weightKg}}" data-field="weightKg" bindinput="field" placeholder="如 55.5" /></view></view>
      <view class="field" id="friend-region"><text>省 / 市 *</text><view wx:if="{{formError.target === 'friend-region'}}" class="form-error">{{formError.message}}</view><picker class="city-picker" mode="region" level="city" value="{{form.province?[form.province,form.city]:[]}}" bindchange="pickRegion"><view class="picker region-value {{form.province?'has-value':''}}"><text>{{form.province?form.province+' / '+form.city:'请选择省 / 市'}}</text><text class="picker-arrow">⌄</text></view></picker><view wx:if="{{!form.province && form.city}}" class="legacy-city">上次填写：{{form.city}}，请从选项中重新选择。</view></view>
    </view>
    <view wx:if="{{step===2}}" class="section">
      <view class="question" id="friend-cleanBodyGoals"><view wx:if="{{formError.target === 'friend-cleanBodyGoals'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">清体目的 *</view><text class="selection-hint">可多选</text></view><view class="tags"><button wx:for="{{goals}}" wx:key="*this" class="tag {{cleanBodyGoalSelected[item]?'active':''}}" data-field="cleanBodyGoals" data-value="{{item}}" bindtap="multi" aria-label="{{item + (cleanBodyGoalSelected[item] ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
      <view class="question" id="friend-dietPreference"><view wx:if="{{formError.target === 'friend-dietPreference'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">日常饮食偏好 *</view><text class="selection-hint">单选</text></view><view class="cards"><button wx:for="{{diets}}" wx:key="*this" class="option {{form.dietPreference===item?'active':''}}" data-field="dietPreference" data-value="{{item}}" bindtap="choose" aria-label="{{item + (form.dietPreference===item ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
      <view class="field group-start" id="friend-waterIntakeMl"><text>每日白开水（ml）*</text><view wx:if="{{formError.target === 'friend-waterIntakeMl'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" type="number" value="{{form.waterIntakeMl}}" data-field="waterIntakeMl" bindinput="field" placeholder="例如：1500" /></view>
      <view class="two"><view class="field" id="friend-wakeTime"><text>起床时间 *</text><view wx:if="{{formError.target === 'friend-wakeTime'}}" class="form-error">{{formError.message}}</view><picker mode="time" value="{{form.wakeTime}}" data-field="wakeTime" bindchange="pickTime"><view class="picker {{form.wakeTime ? '' : 'is-empty'}}">{{form.wakeTime||'请选择'}}</view></picker></view><view class="field" id="friend-sleepTime"><text>睡觉时间 *</text><view wx:if="{{formError.target === 'friend-sleepTime'}}" class="form-error">{{formError.message}}</view><picker mode="time" value="{{form.sleepTime}}" data-field="sleepTime" bindchange="pickTime"><view class="picker {{form.sleepTime ? '' : 'is-empty'}}">{{form.sleepTime||'请选择'}}</view></picker></view></view>
      <view class="question group-start" id="friend-bowelStatus"><view wx:if="{{formError.target === 'friend-bowelStatus'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">排便情况 *</view><text class="selection-hint">单选</text></view><view class="cards"><button wx:for="{{bowels}}" wx:key="*this" class="option {{form.bowelStatus===item?'active':''}}" data-field="bowelStatus" data-value="{{item}}" bindtap="choose" aria-label="{{item + (form.bowelStatus===item ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
      <view class="question" id="friend-energyStatus"><view wx:if="{{formError.target === 'friend-energyStatus'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">精力状态 *</view><text class="selection-hint">单选</text></view><view class="cards"><button wx:for="{{energies}}" wx:key="*this" class="option {{form.energyStatus===item?'active':''}}" data-field="energyStatus" data-value="{{item}}" bindtap="choose" aria-label="{{item + (form.energyStatus===item ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
      <view class="question" id="friend-exerciseStatus"><view wx:if="{{formError.target === 'friend-exerciseStatus'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">运动情况 *</view><text class="selection-hint">单选</text></view><view class="cards"><button wx:for="{{exercises}}" wx:key="*this" class="option {{form.exerciseStatus===item?'active':''}}" data-field="exerciseStatus" data-value="{{item}}" bindtap="choose" aria-label="{{item + (form.exerciseStatus===item ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
    </view>
    <view wx:if="{{step===3}}" class="section">
      <view class="question" id="friend-emotionalStatus"><view wx:if="{{formError.target === 'friend-emotionalStatus'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">近期情绪状态 *</view><text class="selection-hint">可多选</text></view><view class="tags"><button wx:for="{{emotions}}" wx:key="*this" class="tag {{emotionSelected[item]?'active':''}}" data-field="emotionalStatus" data-value="{{item}}" bindtap="multi" aria-label="{{item + (emotionSelected[item] ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
      <view class="question" id="friend-healthConditions"><view wx:if="{{formError.target === 'friend-healthConditions'}}" class="form-error">{{formError.message}}</view><view class="question-heading"><view class="question-title">近半年身体情况 *</view><text class="selection-hint">可多选</text></view><view class="selection-help">“无”与其他身体情况互斥。</view><view wx:for="{{healthGroups}}" wx:key="title" class="health-group"><view class="group-title">{{item.title}}</view><view class="tags"><button wx:for="{{item.values}}" wx:for-item="health" wx:key="*this" class="tag {{healthSelected[health]?'active':''}}" data-field="healthConditions" data-value="{{health}}" bindtap="multi" aria-label="{{health + (healthSelected[health] ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{health}}</text></button></view></view></view>
      <view wx:if="{{healthSelected['其他']}}" class="field" id="friend-otherHealthCondition"><text>其他身体情况 *</text><view wx:if="{{formError.target === 'friend-otherHealthCondition'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" value="{{form.otherHealthCondition}}" data-field="otherHealthCondition" bindinput="field" maxlength="500" placeholder="请补充说明" /></view>
      <view class="field group-start" id="friend-medications"><text>正在服用的保健品或药物</text><view wx:if="{{formError.target === 'friend-medications'}}" class="form-error">{{formError.message}}</view><textarea placeholder-class="form-placeholder" value="{{form.medications}}" data-field="medications" bindinput="field" maxlength="2000" placeholder="如没有可不填写"></textarea></view>
      <view class="question"><view class="question-heading"><view class="question-title">是否孕期（女生选填）</view><text class="selection-hint">选填，单选</text></view><view class="cards"><button wx:for="{{pregnancyOptions}}" wx:key="*this" class="option {{form.pregnancyStatus===item?'active':''}}" data-field="pregnancyStatus" data-value="{{item}}" bindtap="choose" aria-label="{{item + (form.pregnancyStatus===item ? '，已选' : '，未选')}}"><view class="choice-mark"></view><text>{{item}}</text></button></view></view>
    </view>
    <view wx:if="{{step===4}}" class="section">
      <view class="field" id="friend-referralSource"><text>了解轻生活的途径 *</text><view wx:if="{{formError.target === 'friend-referralSource'}}" class="form-error">{{formError.message}}</view><input placeholder-class="form-placeholder" value="{{form.referralSource}}" data-field="referralSource" bindinput="field" maxlength="200" placeholder="请填写朋友姓名或实际途径" /></view>
      <view class="field" id="friend-retrainingReason"><text>再次参加的原因（复训轻友选填）</text><view wx:if="{{formError.target === 'friend-retrainingReason'}}" class="form-error">{{formError.message}}</view><textarea placeholder-class="form-placeholder" value="{{form.retrainingReason}}" data-field="retrainingReason" bindinput="field" maxlength="2000" placeholder="填写再次参加的主要原因"></textarea></view>
      <view class="consent-card" id="friend-sensitiveConsent"><view wx:if="{{formError.target === 'friend-sensitiveConsent'}}" class="form-error">{{formError.message}}</view><view class="consent-title">敏感个人信息授权</view><view class="consent-copy">为了建立您的轻友档案，并帮助工作人员了解您参加轻生活期间的基础身体与生活状态，我们需要收集您主动填写的身体情况、健康状态、用药及相关信息。</view><view class="consent-copy">这些信息仅用于轻生活服务、用户档案管理及相关数据分析，并按照权限进行访问和保护。</view><view class="consent-check" bindtap="toggleConsent" role="checkbox" aria-checked="{{form.sensitiveConsent}}"><view class="box {{form.sensitiveConsent?'checked':''}}">{{form.sensitiveConsent?'✓':''}}</view><text>我已阅读并同意上述敏感个人信息的收集与使用</text></view></view>
    </view>
    <button wx:if="{{assessmentCount>0 && !editingId}}" class="history-entry" bindtap="openHistory">过往登记 · {{assessmentCount}} ›</button>
    <view id="friend-submit-error"><view wx:if="{{formError.target === 'friend-submit-error'}}" class="form-error">{{formError.message}}</view></view>
    <view class="actionbar"><button wx:if="{{step>1}}" class="secondary" bindtap="previous">上一步</button><view wx:else class="spacer"></view><button wx:if="{{step<4}}" class="primary" bindtap="next">{{step===1?'下一步：生活习惯':step===2?'下一步：近期状态':'下一步：参加信息'}}</button><button wx:else class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">确认提交</button></view>
  </block>
</view>
