/* Continuous form layout; shared palette and all field/step behavior stay intact. */
.registration-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 36rpx calc(200rpx + env(safe-area-inset-bottom));
  background: var(--ql-bg);
  color: var(--ql-ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.registration-page .head { margin-bottom: 36rpx; }
.registration-page .progress { display: block; height: 4rpx; margin: 0 0 18rpx; overflow: hidden; border-radius: 0; background: var(--ql-bg-deep); }
.registration-page .progress-fill { height: 100%; background: var(--ql-sage-deep); transition: width .2s; }
.registration-page .step-note { color: var(--ql-ink-light); font-size: 24rpx; letter-spacing: 0; }
.registration-page .title { margin-top: 8rpx; font-size: 44rpx; font-weight: 600; line-height: 1.4; }
.registration-page .subtitle { margin-top: 12rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.6; }

.registration-page .section { position: relative; }
.registration-page .field,
.registration-page .question { box-sizing: border-box; margin: 0 0 32rpx; padding: 0; border: none; border-radius: 0; background: transparent; }
.registration-page .field > text,
.registration-page .question-title { display: block; margin-bottom: 10rpx; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.registration-page .question-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.registration-page .question-heading .question-title { flex: 1; margin: 0; font-size: 30rpx; font-weight: 600; }
.registration-page .selection-hint { flex: none; color: var(--ql-ink-light); font-size: 22rpx; line-height: 1.5; white-space: nowrap; }
.registration-page .selection-help { margin: 4rpx 0 24rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.6; }
.registration-page .group-start { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid var(--ql-border); }

.registration-page .field input,
.registration-page .field textarea,
.registration-page .picker { box-sizing: border-box; width: 100%; min-height: 44px; padding: 14rpx 0; border: none; border-bottom: 1rpx solid var(--ql-ink-light); border-radius: 0; background: transparent; color: var(--ql-ink); font-size: 28rpx; line-height: 1.6; }
.registration-page .field input { height: 88rpx; }
.registration-page .field textarea { height: 172rpx; padding-top: 12rpx; }
.registration-page .form-placeholder,
.registration-page .picker.is-empty { color: var(--ql-ink-light); }
.registration-page .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx; margin-bottom: 32rpx; }
.registration-page .two .field { min-width: 0; margin-bottom: 0; }

.registration-page .tags { display: flex; flex-wrap: wrap; gap: 10rpx 14rpx; }
.registration-page .cards { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10rpx 14rpx; }
.registration-page .tag,
.registration-page .option { display: flex; align-items: center; justify-content: flex-start; gap: 12rpx; box-sizing: border-box; width: auto; min-width: 0; min-height: 44px; margin: 0; padding: 14rpx 12rpx; border: 1rpx solid transparent; border-radius: 8rpx; background: transparent; color: var(--ql-ink); font-size: 28rpx; font-weight: 400; line-height: 1.5; text-align: left; }
.registration-page .tag::after,
.registration-page .option::after { border: none; }
.registration-page .tag:active,
.registration-page .option:active { opacity: .8; }
.registration-page .tag.active,
.registration-page .option.active { background: var(--ql-tint-sage); font-weight: 600; }
.registration-page .choice-mark { position: relative; flex: none; box-sizing: border-box; width: 30rpx; height: 30rpx; border: 2rpx solid var(--ql-ink-light); }
.registration-page .option .choice-mark { border-radius: 50%; }
.registration-page .option.active .choice-mark { border-color: var(--ql-ink); }
.registration-page .option.active .choice-mark::after { content: ''; position: absolute; inset: 6rpx; border-radius: 50%; background: var(--ql-ink); }
.registration-page .tag .choice-mark { border-radius: 4rpx; }
.registration-page .tag.active .choice-mark { border-color: var(--ql-ink); background: var(--ql-ink); }
.registration-page .tag.active .choice-mark::after { content: '✓'; display: flex; height: 100%; align-items: center; justify-content: center; color: var(--ql-surface); font-size: 22rpx; line-height: 1; }
.registration-page .health-group { margin-top: 24rpx; }
.registration-page .health-group .tags { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx 12rpx; }
.registration-page .tag text,
.registration-page .option text { min-width: 0; overflow-wrap: break-word; }
.registration-page .group-title { margin-bottom: 12rpx; color: var(--ql-ink); font-size: 28rpx; font-weight: 600; line-height: 1.5; letter-spacing: 0; }

.registration-page .consent-card { margin-top: 40rpx; padding: 28rpx 0 0; border: none; border-top: 1rpx solid var(--ql-border); border-radius: 0; background: transparent; }
.registration-page .consent-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.registration-page .consent-copy { margin-top: 16rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.8; }
.registration-page .consent-check { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 28rpx; padding: 12rpx 0; font-size: 28rpx; line-height: 1.65; }
.registration-page .box { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; width: 36rpx; height: 36rpx; margin-top: 4rpx; border: 2rpx solid var(--ql-ink-light); border-radius: 4rpx; background: transparent; color: var(--ql-surface); font-size: 26rpx; }
.registration-page .box.checked { border-color: var(--ql-ink); background: var(--ql-ink); }
.registration-page .form-error { margin: 8rpx 0 12rpx; color: #9E5234; font-size: 28rpx; line-height: 1.6; }

.registration-page .actionbar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; gap: 20rpx; padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--ql-border); background: var(--ql-bg); }
.registration-page .actionbar button { flex: 1; min-width: 0; min-height: 48px; margin: 0; border-radius: 12rpx; font-size: 28rpx; }
.registration-page .spacer { flex: 1; }
.registration-page .loading { padding: 160rpx 0; color: var(--ql-ink-light); text-align: center; }
.registration-page .success-card { margin-top: 96rpx; padding: 40rpx 28rpx; border-radius: 16rpx; background: var(--ql-surface); text-align: center; }
.registration-page .success-mark { display: flex; width: 72rpx; height: 72rpx; margin: 0 auto 20rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--ql-tint-sage); color: var(--ql-ink); font-size: 36rpx; }
.registration-page .success-title { font-size: 38rpx; font-weight: 600; line-height: 1.5; }
.registration-page .success-copy { margin: 16rpx 0 28rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.7; }
.registration-page .success-card .primary,
.registration-page .success-card .text-button { border-radius: 12rpx; }

@media (prefers-reduced-motion: reduce) {
  .registration-page .progress-fill { transition: none; }
}

@media (max-width: 350px) {
  .registration-page .health-group .tags { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .registration-page .field > text,
  .registration-page .field input,
  .registration-page .field textarea,
  .registration-page .picker,
  .registration-page .tag,
  .registration-page .option,
  .registration-page .group-title,
  .registration-page .consent-copy,
  .registration-page .consent-check,
  .registration-page .form-error { font-size: 14px; }
  .registration-page .question-heading .question-title { font-size: 15px; }
  .registration-page .subtitle,
  .registration-page .step-note,
  .registration-page .selection-hint,
  .registration-page .selection-help { font-size: 12px; }
}


.region-value{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:88rpx}.region-value.has-value{color:var(--ql-ink)}.picker-arrow{flex-shrink:0;color:var(--ql-ink-ghost);font-size:28rpx}.legacy-city,.success-deadline{margin-top:14rpx;color:var(--ql-ink-ghost);font-size:22rpx;line-height:1.6}
.registration-page button.history-entry,.registration-page button.history-back{display:flex;align-items:center;justify-content:center;width:auto;min-height:88rpx;margin:12rpx auto 0;padding:12rpx 20rpx;background:transparent;color:var(--ql-ink-ghost);font-size:23rpx;line-height:1.5}.registration-page button.history-back{color:var(--ql-sage-deep);margin-top:24rpx}.history-head{margin-bottom:32rpx}.history-head .title{font-size:44rpx}.history-state{padding:70rpx 0;color:var(--ql-ink-light);font-size:26rpx;text-align:center}
.registration-page button.history-card{display:block;width:100%;margin:0 0 20rpx;padding:28rpx 30rpx;border:1rpx solid var(--ql-border);border-radius:24rpx;background:var(--ql-surface);color:var(--ql-ink);text-align:left;line-height:1.5}.history-card-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.history-number{font-size:28rpx;font-weight:500}.history-arrow{color:var(--ql-ink-ghost);font-size:30rpx}.history-date{margin-top:12rpx;font-size:25rpx;color:var(--ql-ink-light)}.history-status{margin-top:12rpx;color:var(--ql-ink-ghost);font-size:22rpx;line-height:1.6}.history-status.editable{color:var(--ql-sage-deep)}
.record-section{margin-bottom:22rpx;padding:28rpx;border:1rpx solid var(--ql-border);border-radius:24rpx;background:var(--ql-surface)}.record-section-title{padding-bottom:20rpx;border-bottom:1rpx solid var(--ql-border);font-size:28rpx;font-weight:500}.record-row{display:flex;align-items:flex-start;gap:20rpx;padding-top:20rpx;font-size:24rpx;line-height:1.7}.record-label{flex:0 0 150rpx;color:var(--ql-ink-light)}.record-value{flex:1;min-width:0;overflow-wrap:anywhere;white-space:pre-wrap}.legacy-note{margin-bottom:22rpx;padding:24rpx;background:var(--ql-tint-sage);border-radius:20rpx;color:var(--ql-ink-light);font-size:23rpx;line-height:1.7}.registration-page button.record-edit{width:100%;min-height:88rpx;margin:30rpx 0 0}.success-deadline{margin-bottom:24rpx}

.session-context{padding:28rpx 32rpx;margin-bottom:32rpx;background:#efe4dc;border-radius:18rpx}.session-context-label{color:#9a7867;font-size:23rpx;letter-spacing:2rpx}.session-context-name{font-family:serif;font-size:32rpx;margin:14rpx 0}
