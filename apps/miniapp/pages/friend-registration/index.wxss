.registration-page{box-sizing:border-box;min-height:100vh;padding:44rpx 40rpx 180rpx;background:var(--ql-bg);color:var(--ql-ink)}
.head{margin-bottom:34rpx}.progress{height:8rpx;overflow:hidden;border-radius:8rpx;background:var(--ql-bg-deep)}.progress-fill{height:100%;border-radius:8rpx;background:var(--ql-sage-deep);transition:width .25s}.step-note{margin-top:22rpx;color:var(--ql-clay-deep);font-size:23rpx;letter-spacing:4rpx}.title{margin-top:6rpx;font-family:var(--ql-serif);font-size:52rpx}.subtitle{margin-top:8rpx;color:var(--ql-ink-light);font-size:24rpx}
.section{position:relative}.field,.question,.consent-card{box-sizing:border-box;margin-bottom:22rpx;padding:30rpx;border:1rpx solid var(--ql-border);border-radius:30rpx;background:var(--ql-surface)}.field>text,.question-title{display:block;margin-bottom:18rpx;font-size:25rpx;font-weight:600}.field input,.field textarea,.picker{box-sizing:border-box;width:100%;min-height:76rpx;padding:16rpx 20rpx;border-radius:20rpx;background:var(--ql-bg);font-size:27rpx}.field textarea{height:180rpx}.picker{color:var(--ql-ink-light)}.two{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tags,.cards{display:flex;flex-wrap:wrap;gap:14rpx}.tag,.option{width:auto;min-width:120rpx;margin:0;padding:14rpx 24rpx;border:1rpx solid var(--ql-border);border-radius:999rpx;background:var(--ql-bg);font-size:24rpx;line-height:1.4}.option{flex:1;min-width:42%;border-radius:22rpx}.tag.active,.option.active{border-color:var(--ql-sage-deep);background:var(--ql-tint-sage);color:var(--ql-sage-deep);font-weight:600}.health-group{margin-top:26rpx}.group-title{margin-bottom:12rpx;color:var(--ql-ink-ghost);font-size:21rpx;letter-spacing:2rpx}
.consent-card{padding:34rpx;background:var(--ql-tint-sage)}.consent-title{font-family:var(--ql-serif);font-size:34rpx}.consent-copy{margin-top:18rpx;color:var(--ql-ink-light);font-size:24rpx;line-height:1.8}.consent-check{display:flex;align-items:flex-start;gap:18rpx;margin-top:26rpx;font-size:25rpx}.box{display:flex;width:40rpx;height:40rpx;flex:none;align-items:center;justify-content:center;border:2rpx solid var(--ql-sage-deep);border-radius:9rpx;background:#fff;color:#fff}.box.checked{background:var(--ql-sage-deep)}
.actionbar{position:fixed;z-index:20;right:0;bottom:0;left:0;display:flex;gap:20rpx;padding:20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--ql-border);background:rgba(246,241,232,.96)}.actionbar button{flex:1;margin:0}.spacer{flex:1}.loading{padding:180rpx 0;text-align:center;color:var(--ql-ink-light)}.success-card{margin-top:160rpx;padding:54rpx 40rpx;border-radius:44rpx;background:var(--ql-surface);box-shadow:var(--ql-shadow-card);text-align:center}.success-mark{display:flex;width:100rpx;height:100rpx;margin:0 auto 28rpx;align-items:center;justify-content:center;border-radius:50%;background:var(--ql-tint-sage);color:var(--ql-sage-deep);font-size:52rpx}.success-title{font-family:var(--ql-serif);font-size:48rpx}.success-copy{margin:20rpx 0 36rpx;color:var(--ql-ink-light)}
