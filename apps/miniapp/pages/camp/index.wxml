<launch-splash />
<ql-nav-space title="清体营" />
<view class="page camp-page">
  <view wx:if="{{refreshing}}" class="refresh-note">正在更新…</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取…</view>
  <view wx:if="{{loadError}}" class="empty-state">{{loadError}}<button class="text-button" bindtap="onShow">重试</button></view>
  <block wx:if="{{!loading && !loadError}}">
    <view wx:if="{{arrangementCount}}" class="my-arrangements">
      <view class="arrangements-heading"><view class="camp-section-title">我的安排</view><text class="arrangements-count">{{arrangementCount}} 期</text></view>
      <view wx:for="{{arrangementGroups}}" wx:for-item="group" wx:key="key" class="arrangement-group">
        <view wx:if="{{group.label}}" class="arrangement-group-title">{{group.label}}</view>
        <view wx:for="{{group.rows}}" wx:key="activityId" class="arrangement-item {{index === group.rows.length - 1 ? 'last' : ''}}">
          <button class="arrangement-row" aria-label="{{item.arrangement.name + '，' + item.arrangement.label + '，' + item.arrangement.action}}" data-id="{{item.activityId}}" bindtap="openRegistration">
            <view class="arrangement-top"><text wx:if="{{item.arrangement.period}}">第 {{item.arrangement.period}} 期</text><text wx:else>期次待公布</text><text class="arrangement-status {{item.arrangement.tone}}">{{item.arrangement.label}}</text></view>
            <view class="arrangement-name">{{item.arrangement.name}}</view>
            <view class="arrangement-date">{{item.arrangement.date}}<text wx:if="{{item.arrangement.city}}"> · {{item.arrangement.city}}</text></view>
            <view wx:if="{{item.arrangement.stage || item.arrangement.people}}" class="arrangement-context"><text>{{item.arrangement.stage}}</text><text wx:if="{{item.arrangement.stage && item.arrangement.people}}"> · </text><text>{{item.arrangement.people}}</text></view>
            <view wx:if="{{item.arrangement.peopleNote}}" class="arrangement-note attention">{{item.arrangement.peopleNote}}</view>
            <view wx:if="{{item.arrangement.note}}" class="arrangement-note">{{item.arrangement.note}}</view>
            <view class="arrangement-bottom"><text class="arrangement-payment {{item.arrangement.paymentAttention ? 'attention' : ''}}">{{item.arrangement.payment}}</text><text class="arrangement-action">{{item.arrangement.action}} ›</text></view>
          </button>
          <button wx:if="{{item.arrangement.experience}}" class="past-camp-entry" aria-label="{{'查看' + item.arrangement.name + '体验记录'}}" bindtap="openCurrent">查看体验记录 ›</button>
        </view>
      </view>
    </view>

    <view class="public-camp-heading"><view class="public-camp-title">近期活动</view><text class="public-camp-count">{{openActivities.length}} 期</text></view>
    <scroll-view wx:if="{{openActivities.length > 1 || activeFilter !== 'all'}}" class="camp-filters" scroll-x show-scrollbar="{{false}}">
      <view class="camp-filters-inner"><button wx:for="{{campFilters}}" wx:key="key" class="camp-filter {{activeFilter === item.key ? 'selected' : ''}}" aria-label="{{item.label + '，' + item.count + '期'}}" aria-pressed="{{activeFilter === item.key}}" data-filter="{{item.key}}" bindtap="chooseFilter">{{item.label}}<text wx:if="{{item.key !== 'all'}}"> {{item.count}}</text></button></view>
    </scroll-view>
    <view wx:if="{{activeFilter !== 'all'}}" class="camp-filter-summary"><text>{{activeFilterLabel}} · {{visibleActivities.length}} 期</text><button class="camp-reset" data-filter="all" bindtap="chooseFilter">查看全部</button></view>
    <block wx:for="{{visibleActivities}}" wx:key="id">
      <view class="activity-card {{item.list.featured ? 'featured' : ''}} {{index === visibleActivities.length - 1 ? 'last' : ''}}">
        <view class="activity-meta"><text wx:if="{{item.list.hasPeriod}}">第 {{item.list.period}} 期</text><text wx:else>期次待公布</text><text class="activity-status {{item.list.tone}}">{{item.status}}</text></view>
        <view class="activity-heading">
          <view class="activity-heading-copy"><view class="activity-name">{{item.name}}</view><view wx:if="{{item.list.theme}}" class="activity-theme">{{item.list.theme}}</view></view>
          <view class="camp-template-cover {{item.list.periodSize}}" aria-hidden="true"><text class="camp-cover-brand">轻生活 · 生机清体营</text><text class="camp-cover-number">{{item.list.hasPeriod ? item.list.period : '待公布'}}</text><text wx:if="{{item.list.hasPeriod}}" class="camp-cover-unit">期</text></view>
        </view>
        <view class="activity-details"><view class="activity-date">{{item.list.date}}</view><view class="activity-place">{{item.list.place}}</view></view>
        <view class="activity-prices">
          <view class="price-tier"><text class="price-label">新轻友</text><block wx:if="{{item.list.hasFee}}"><text class="price-currency">¥</text><text class="price-value">{{item.fee}}</text><text class="price-unit">/人</text></block><text wx:else class="price-pending">公开价待公布</text></view>
          <view wx:if="{{item.returningFee != null}}" class="price-tier"><text class="price-label">老轻友</text><block wx:if="{{item.list.hasReturningFee}}"><text class="price-currency">¥</text><text class="price-value">{{item.returningFee}}</text><text class="price-unit">/人</text></block><text wx:else class="price-pending">公开价待公布</text></view>
        </view>
        <view class="activity-actions"><button wx:if="{{item.hasRegistration}}" class="camp-action camp-signup" aria-label="{{'查看' + item.name + '安排与服务'}}" data-id="{{item.id}}" catchtap="signup">查看安排 <text aria-hidden="true">↗</text></button><button wx:else class="camp-action camp-details" aria-label="{{'查看' + item.name + (item.canRegister ? '详情与报名，先查看活动须知' : '详情')}}" data-id="{{item.id}}" catchtap="openActivity">{{item.canRegister ? (item.canReapply ? '重新报名' : '查看详情与报名') : '查看详情'}} <text aria-hidden="true">↗</text></button></view>
        <block wx:if="{{voicePreviews[item.id]}}">
          <view class="camp-voice">
            <view class="camp-voice-heading"><text>轻友心声</text><text wx:if="{{voicePreviews[item.id].count > 1}}" class="camp-voice-count">{{voicePreviews[item.id].index + 1}} / {{voicePreviews[item.id].count}}</text></view>
            <scroll-view wx:if="{{expandedVoices[item.id]}}" id="camp-voices-{{index}}" class="camp-voices-panel" scroll-y show-scrollbar="{{true}}"><view class="camp-voice-note">{{voicePreviews[item.id].text}}</view></scroll-view>
            <view wx:else class="camp-voice-note">{{voicePreviews[item.id].preview}}<text wx:if="{{voicePreviews[item.id].isLong}}">…</text></view>
            <view class="camp-voice-author">{{voicePreviews[item.id].author || '本期轻友'}}<text wx:if="{{voicePreviews[item.id].phase === 'before' || voicePreviews[item.id].phase === 'after'}}"> · {{voicePreviews[item.id].phase === 'before' ? '活动前' : '活动后'}}</text></view>
            <view wx:if="{{voicePreviews[item.id].isLong || voicePreviews[item.id].count > 1}}" class="camp-voice-actions">
              <button wx:if="{{voicePreviews[item.id].isLong}}" class="camp-voice-toggle" aria-expanded="{{!!expandedVoices[item.id]}}" aria-controls="camp-voices-{{index}}" data-id="{{item.id}}" bindtap="toggleVoices">{{expandedVoices[item.id] ? '收起全文' : '阅读全文'}}</button>
              <view wx:if="{{voicePreviews[item.id].count > 1}}" class="camp-voice-switch"><button class="camp-voice-prev" disabled="{{voicePreviews[item.id].index === 0}}" aria-label="上一条轻友心声" data-id="{{item.id}}" data-direction="-1" bindtap="switchVoice">上一条</button><button class="camp-voice-next" disabled="{{voicePreviews[item.id].index === voicePreviews[item.id].count - 1}}" aria-label="下一条轻友心声" data-id="{{item.id}}" data-direction="1" bindtap="switchVoice">下一条</button></view>
            </view>
          </view>
        </block>
        <view wx:if="{{item.showReflectionEntry}}" class="camp-reflection-entry"><button class="reflection-link" data-id="{{item.id}}" disabled="{{!item.reflectionAccess.allowed || reflectionOpening}}" catchtap="openReflection">写心声</button><view wx:if="{{!item.reflectionAccess.allowed}}" class="settlement-note">{{item.reflectionAccess.reason}}</view><button wx:if="{{item.reflectionAccess.retry}}" class="camp-reset" bindtap="onShow">重试</button></view>
      </view>
    </block>
    <view wx:if="{{!openActivities.length}}" class="empty-state"><view class="empty-title">暂无公开活动</view><view class="empty-copy">新的期次公布后会显示在这里。</view></view>
    <view wx:elif="{{!visibleActivities.length}}" class="empty-state"><view class="empty-title">暂无符合条件的活动</view><button class="camp-reset" data-filter="all" bindtap="chooseFilter">查看全部活动</button></view>
  </block>
</view>
