.camp-page { padding: 28rpx 40rpx calc(184rpx + env(safe-area-inset-bottom)); background: var(--ql-bg); }
.camp-page::before { display: none; }
.camp-page .refresh-note { position: static; margin: 0 0 16rpx; text-align: left; }
.camp-page .empty-state .text-button { min-height: 44px; }
.camp-intro { margin: 8rpx 0 32rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.7; }
.camp-section-title { color: var(--ql-ink); font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.my-arrangements { margin-bottom: 32rpx; }
.camp-page button.arrangement-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-height: 48px; margin: 0; padding: 24rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--ql-border); background: transparent; color: var(--ql-ink); text-align: left; white-space: normal; line-height: 1.5; }
.arrangement-copy { flex: 1; min-width: 0; }
.arrangement-top { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.5; }
.arrangement-status { color: var(--ql-clay-deep); }
.arrangement-name { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: 8rpx; font-size: 34rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.arrangement-date { margin-top: 8rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.6; overflow-wrap: break-word; }
.arrangement-action { flex: none; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.5; white-space: nowrap; }
.camp-page button.past-camp-entry { display: flex; align-items: center; justify-content: flex-start; width: auto; min-height: 44px; margin: 12rpx 0 0; padding: 8rpx 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.5; }
.public-camp-heading { margin-bottom: 8rpx; }
.activity-card { margin: 0 0 32rpx; padding: 24rpx 0 32rpx; border-bottom: 1rpx solid var(--ql-border); }
.activity-heading { display: flex; align-items: flex-start; gap: 24rpx; }
.activity-heading-copy { flex: 1; min-width: 0; }
.activity-meta { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.5; }
.activity-status.warning { color: #8B602B; }
.activity-status.unavailable { color: var(--ql-ink-light); }
.activity-name { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: 10rpx; color: var(--ql-ink); font-size: 34rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.activity-theme { margin-top: 8rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.6; overflow-wrap: break-word; }
.activity-cover { display: block; flex: none; width: 152rpx; height: 152rpx; border-radius: 6rpx; }
.activity-details { margin-top: 20rpx; }
.activity-detail { display: flex; align-items: flex-start; gap: 20rpx; margin-top: 8rpx; font-size: 28rpx; line-height: 1.65; }
.activity-detail-label { flex: none; color: var(--ql-ink-light); }
.activity-detail-value { flex: 1; min-width: 0; color: var(--ql-ink); overflow-wrap: break-word; }
.activity-prices { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx 28rpx; margin-top: 20rpx; }
.price-tier { display: inline-flex; align-items: baseline; flex-wrap: wrap; gap: 4rpx; min-width: 0; color: var(--ql-ink); line-height: 1.5; }
.price-label { margin-right: 10rpx; color: var(--ql-ink-light); font-size: 28rpx; }
.price-currency { font-size: 28rpx; }
.price-value { font-size: 34rpx; font-weight: 600; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.price-unit { color: var(--ql-ink-light); font-size: 28rpx; }
.settlement-note { margin-top: 10rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.65; }
.activity-actions { display: flex; align-items: center; gap: 24rpx; margin-top: 18rpx; }
.camp-page button.camp-signup { display: flex; align-items: center; justify-content: center; width: auto; min-width: 140rpx; min-height: 44px; margin: 0; padding: 14rpx 24rpx; border-radius: 10rpx; background: var(--ql-tint-sage); color: var(--ql-ink); font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.camp-page button.camp-signup[disabled] { background: var(--ql-bg-deep); color: var(--ql-ink-light); font-weight: 400; }
.camp-page button.camp-details,
.camp-page button.reflection-link { display: flex; align-items: center; justify-content: flex-start; width: auto; min-height: 44px; margin: 0; padding: 8rpx 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.5; }
.camp-reflection-entry { margin-top: 12rpx; }
.camp-page button.arrangement-row:active,
.camp-page button.camp-signup:active,
.camp-page button.camp-details:active,
.camp-page button.reflection-link:active { opacity: .75; }
@media (max-width: 350px) {
  .camp-intro, .arrangement-top, .arrangement-date, .arrangement-action, .activity-meta,
  .activity-theme, .activity-detail, .price-label, .price-currency, .price-unit, .settlement-note,
  .camp-page button.camp-signup, .camp-page button.camp-details, .camp-page button.reflection-link,
  .camp-page button.past-camp-entry { font-size: 14px; }
}
