<ql-nav-space back />
<view class="page phone-auth-page">
  <view class="auth-field">
    <view class="auth-kicker">轻生活 · 登录</view>
    <view class="auth-title">轻一点，先认识你</view>
    <view class="auth-copy">用微信绑定的手机号登录，用于报名确认与登记联系，不会公开展示。</view>
  </view>

  <view class="auth-body">
    <view class="auth-facts">
      <view class="auth-fact"><text class="auth-fact-label">用途</text><text class="auth-fact-value">确认本人身份、联系报名与登记</text></view>
      <view class="auth-fact"><text class="auth-fact-label">方式</text><text class="auth-fact-value">微信一键授权，无需手动输入</text></view>
    </view>
    <view wx:if="{{notice}}" class="auth-notice" aria-live="polite">{{notice}}</view>
    <button class="auth-primary" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="onPhoneNumber" loading="{{busy}}" disabled="{{busy}}">{{busy ? '正在登录…' : '微信手机号一键登录'}}</button>
    <view class="auth-privacy">登录即表示同意<text class="auth-link" bindtap="openPrivacy">《轻生活隐私保护指引》</text></view>
    <button class="auth-later" bindtap="leave">暂不登录，继续浏览</button>
  </view>
</view>
