<ql-nav-space back title="{{title}}" />
<view class="page personal-page">
  <view class="hero-title">{{title}}</view>
  <view class="card-copy">{{view === 'records' ? '留给自己的文字，只有自己可见。' : '每一段同行，都有自己的节奏。'}}</view>
  <view wx:if="{{loading}}" class="refresh-note">正在读取…</view>
  <view wx:elif="{{error}}" class="card"><view>{{error}}</view><button class="secondary" bindtap="refresh">重试</button></view>
  <view wx:elif="{{!loggedIn}}" class="card"><view class="card-title">登录后查看自己的记录</view><button class="primary" bindtap="login">登录并查看</button></view>
  <block wx:else>
    <view wx:if="{{demo}}" class="sample-note">本地演示模式 · 不代表正式参与档案</view>
    <block wx:if="{{view !== 'records'}}">
      <view wx:for="{{rows}}" wx:key="id" class="card"><view class="pill">{{item.status}} {{item.payment}}</view><view class="card-title">{{item.name}}</view><view class="card-copy">{{item.date}}</view><view class="card-copy">参与人：{{item.participants}}</view><button class="secondary" data-id="{{item.id}}" bindtap="openSession">查看本次安排</button></view>
      <view wx:if="{{!rows.length}}" class="card"><view class="card-title">还没有参与经历</view><view class="card-copy">报名后，可以在这里查看每一期的状态。</view><button class="secondary" bindtap="openCamp">看看轻体营</button></view>
    </block>
    <block wx:if="{{view !== 'experiences'}}">
      <view wx:for="{{records}}" wx:key="id" class="card"><view class="pill">{{item.label}} · 仅自己可见</view><view class="card-title">{{item.name}}</view><view class="card-copy">{{item.note || '这一次，留下了一份状态记录。'}}</view><view wx:if="{{item.energy || item.relaxation}}" class="card-copy">精力 {{item.energy || '未填'}} · 放松 {{item.relaxation || '未填'}}</view></view>
      <view wx:if="{{!records.length}}" class="card"><view class="card-title">给下一次感受留一个位置</view><view class="card-copy">在本次活动安排中保存的个人感受，会汇集到这里。替家人报名不会看到对方的私人记录。</view></view>
    </block>
  </block>
</view>
