<ql-nav-space back title="{{title}}" />
<view class="page personal-page personal-{{view}}">
  <view class="personal-heading">
    <view class="personal-title">{{title}}</view>
    <view wx:if="{{view !== 'experiences'}}" class="personal-intro">{{view === 'records' ? '留给自己的文字，只有自己可见。' : '查看每一期的参与和安排。'}}</view>
  </view>
  <view wx:if="{{loading}}" class="personal-loading">正在读取…</view>
  <view wx:elif="{{error}}" class="personal-state">
    <view class="state-title">暂时无法读取</view>
    <view class="state-copy">{{error}}</view>
    <button class="secondary" bindtap="refresh">重试</button>
  </view>
  <view wx:elif="{{!loggedIn}}" class="personal-state">
    <view class="state-title">登录后查看自己的记录</view>
    <button class="primary" bindtap="login">登录并查看</button>
  </view>
  <block wx:else>
    <view wx:if="{{demo}}" class="sample-note">本地演示模式 · 不代表正式参与档案</view>
    <view wx:if="{{view !== 'records'}}" class="experience-list">
      <view wx:if="{{view !== 'experiences'}}" class="personal-section-title">参与安排</view>
      <view wx:for="{{rows}}" wx:key="id" class="experience-row">
        <view class="entry-title">{{item.name}}</view>
        <view class="entry-meta">{{item.date}}</view>
        <view class="entry-meta">参与人：{{item.participants}}</view>
        <view class="participation-states">
          <view class="participation-state"><text class="state-label">报名</text><text class="state-value">{{item.status}}</text></view>
          <view class="participation-state"><text class="state-label">结算</text><text class="state-value">{{item.settlement}}</text></view>
        </view>
        <button class="text-button session-action" data-id="{{item.id}}" bindtap="openSession">查看本次安排</button>
      </view>
      <view wx:if="{{!rows.length}}" class="personal-state">
        <view class="state-title">还没有参与经历</view>
        <view class="state-copy">报名后，可以在这里查看每一期的状态。</view>
        <button class="secondary" bindtap="openCamp">看看清体营</button>
      </view>
    </view>
    <view wx:if="{{view !== 'experiences'}}" class="record-list">
      <view wx:if="{{view !== 'records'}}" class="personal-section-title">私人记录</view>
      <view wx:for="{{records}}" wx:key="id" class="record-row">
        <view class="entry-title">{{item.name}}</view>
        <view class="record-stage">{{item.label}} · 仅自己可见</view>
        <view wx:if="{{item.note}}" class="record-body">{{item.note}}</view>
        <view wx:if="{{(item.energy >= 1 && item.energy <= 5) || (item.relaxation >= 1 && item.relaxation <= 5)}}" class="record-values"><text wx:if="{{item.energy >= 1 && item.energy <= 5}}">精力 {{item.energy}}/5</text><text wx:if="{{item.relaxation >= 1 && item.relaxation <= 5}}">放松 {{item.relaxation}}/5</text></view>
        <view wx:if="{{item.recordTimeText}}" class="record-time">最近保存 · {{item.recordTimeText}}</view>
      </view>
      <view wx:if="{{!records.length}}" class="personal-state">
        <view class="state-title">还没有私人记录</view>
        <view class="state-copy">在本次活动安排中保存的个人感受，会汇集到这里。替家人报名不会看到对方的私人记录。</view>
      </view>
    </view>
  </block>
</view>
