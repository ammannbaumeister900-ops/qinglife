<launch-splash />
<ql-nav-space title="我的服务" back />
<view class="page mine-flow-page editorial-page">
  <block wx:if="{{view === 'auth'}}">
    <view class="hero"><view class="hero-title">用手机号继续</view><view class="hero-copy">用于识别报名和保护个人记录。</view></view>
    <view class="card">
      <view class="field"><text class="label">手机号</text><input class="input" type="number" maxlength="11" value="{{phoneInput}}" bindinput="onPhoneInput"/></view>
      <view class="field"><text class="label">短信验证码</text><view class="code-row"><input class="input code-input" type="number" maxlength="6" value="{{codeInput}}" placeholder="请输入 6 位验证码" bindinput="onCodeInput"/><button class="code-button" bindtap="sendCode">{{codeSent ? '已发送' : '获取验证码'}}</button></view></view>
      <view class="check-row" bindtap="toggleAgreement"><checkbox checked="{{agreement}}" color="#A6B6A2"/><view class="list-main"><text class="list-title">同意服务必要条款</text><text class="list-note">运营联系和个性化分析会分开选择。</text></view></view>
      <button class="primary" bindtap="login">登录并关联手机号</button>
    </view>
  </block>

  <block wx:elif="{{view === 'habit'}}">
    <view class="hero"><view class="hero-title">愿意再回来，就已经在继续。</view><view class="hero-copy">按有效自然日推进；漏打卡不延长。暂停当天不计入，恢复后从被冻结的计划日继续。</view></view>
    <view class="card sage">
      <view class="card-title">当前 {{state.habit.planLength}} 天计划</view>
      <view class="chips"><button class="chip {{state.habit.planLength === 14 ? 'active' : ''}}" data-value="14" bindtap="setPlanLength">14天</button><button class="chip {{state.habit.planLength === 21 ? 'active' : ''}}" data-value="21" bindtap="setPlanLength">21天</button></view>
      <view wx:if="{{state.habit.status === 'completed'}}" class="card-copy">本次计划已到期结束。</view><button wx:else class="secondary" disabled="{{habitBusy}}" bindtap="togglePause">{{state.habit.paused ? '恢复计划' : '暂停并顺延'}}</button>
    </view>
    <view class="card-copy">只需按自己的节奏继续。已有计划不能直接更改长度。暂停保留真实记录，但暂停日不计入计划进度。</view>
  </block>

  <block wx:elif="{{view === 'collections'}}">
    <view class="hero"><view class="hero-title">我的内容收藏</view></view>
    <soft-loading wx:if="{{collectionsLoading}}" text="正在读取收藏…" />
    <view wx:if="{{collectionsError}}" class="empty-state"><view class="empty-copy">{{collectionsError}}</view><button class="empty-action" bindtap="loadCollections">重试</button></view>
    <view wx:if="{{!collectionsLoading && !collectionsError && !collections.length}}" class="empty-state"><view class="empty-title">还没有收藏内容</view><view class="empty-copy">在轻读遇见想慢慢读的文章，可以先收进这里。</view><button class="empty-action" bindtap="openReading">去轻读看看</button></view>
    <view wx:for="{{collections}}" wx:key="favoriteKey" class="card" data-id="{{item.id}}" data-title="{{item.title}}" data-source="{{item.source}}" bindtap="openArticle"><view class="pill">{{item.category}}</view><view class="card-title">{{item.title}}</view><view class="card-copy">{{item.summary}}</view></view>
  </block>

  <block wx:elif="{{view === 'privacy'}}">
    <view class="hero"><view class="hero-title">设置与隐私</view><view class="hero-copy">下方开关仅保存本机偏好，不会同步或更改已提交的授权。</view></view>
    <button class="text-button" bindtap="openAccount">{{state.phoneLinked ? '查看账号信息' : '登录并关联手机号'}}</button>
    <view class="card">
      <view class="list-row"><view class="list-main"><text class="list-title">服务必要信息</text><text class="list-note">用于报名、签到与履约</text></view><view class="pill">{{state.registration.serviceConsent ? '已同意' : '使用服务时确认'}}</view></view>
      <view class="list-row" data-key="operationConsent" bindtap="togglePrivacy"><view class="list-main"><text class="list-title">运营联系偏好（本机）</text><text class="list-note">仅记录是否希望接收活动介绍，不会更改服务端授权或联系安排。</text></view><switch checked="{{state.operationConsent}}" color="#A6B6A2"/></view>
      <view wx:if="{{state.aiConsent}}" class="list-row" data-key="aiConsent" bindtap="togglePrivacy"><view class="list-main"><text class="list-title">个性化分析偏好（本机）</text><text class="list-note">仅保存本机偏好，不会开启分析或撤回已提交的授权。</text></view><switch checked="{{state.aiConsent}}" color="#A6B6A2"/></view>
      <view class="list-row" bindtap="toggleSubscription"><view class="list-main"><text class="list-title">提醒偏好（本机）</text><text class="list-note">仅记录是否希望接收提醒；微信订阅尚未接通，当前不会发送提醒消息。</text></view><switch checked="{{state.subscriptionEnabled}}" color="#A6B6A2"/></view>
    </view>
    <view class="privacy-note">这些本机偏好不会改变私人记录的可见范围。</view>
  </block>

  <block wx:elif="{{view === 'experiences'}}">
    <view class="hero"><view class="hero-title">全部参与经历</view></view>
    <view wx:for="{{experienceTabs}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="selectExperience"><view class="card-title">第 {{item.sessionNumber}} 期</view><view class="card-copy">{{item.period}} · {{item.location}} · {{item.status}}</view></view>
  </block>
  <block wx:else>
    <view class="hero experience-hero">
      <view class="pill">第 {{currentExperience.sessionNumber}} 期</view>
      <view class="hero-title">{{currentExperience.title}}</view>
      <view class="hero-copy">{{currentExperience.period}} · {{currentExperience.location}}</view>
      <view class="vertical hero-side">仅自己可见</view>
    </view>

    <view class="card experience-summary">
      <view class="experience-summary-top"><view class="pill">{{currentExperience.status}}</view></view>
      <view class="card-copy">{{currentExperience.summary}}</view>
    </view>

    <view class="section-head"><view class="section-title">这期的时间记录</view></view>
    <view class="experience-accordion">
      <view wx:for="{{currentExperience.details}}" wx:key="id" class="experience-detail {{expandedDetailId === item.id ? 'open' : ''}}" data-id="{{item.id}}" bindtap="toggleExperienceDetail">
        <view class="experience-detail-head"><view class="detail-index">0{{index + 1}}</view><view class="list-main"><text class="list-title">{{item.label}}</text><text class="list-note">{{item.date}}</text></view><text class="detail-toggle">{{expandedDetailId === item.id ? '−' : '+'}}</text></view>
        <view wx:if="{{expandedDetailId === item.id}}" class="experience-detail-body">{{item.note}}</view>
      </view>
    </view>
    <view class="privacy-note">参与经历仅本人可见；不会自动公开。</view>
  </block>
</view>
