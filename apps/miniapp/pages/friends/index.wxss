.friend-actions { display: flex; justify-content: flex-end; margin-bottom: 28rpx; }
.archive-button {
  width: auto;
  margin: 0;
  padding: 14rpx 26rpx;
  border: 1rpx solid var(--ql-border);
  border-radius: 999rpx;
  background: rgba(255, 252, 247, 0.78);
  color: var(--ql-clay-deep);
  font-size: 23rpx;
  line-height: 1.4;
}

.friends-hero {
  padding-right: 66rpx;
}
.friends-hero .hero-title {
  max-width: 540rpx;
  font-size: 50rpx;
}
.friends-hero .hero-side {
  top: 8rpx;
  right: 4rpx;
  font-size: 24rpx;
}

.daily-strip {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 8rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  border-radius: var(--ql-radius-card);
  background: radial-gradient(circle at 96% 0%, rgba(255, 255, 255, 0.6), transparent 32%), var(--ql-tint-mist);
  box-shadow: var(--ql-shadow-card);
  transition: opacity 180ms ease, transform 180ms ease;
}
.daily-strip:active { opacity: 0.86; transform: translateY(2rpx); }
.daily-strip .list-note { color: var(--ql-ink-ghost); font-size: 22rpx; letter-spacing: 2rpx; }
.daily-strip .list-title { margin-top: 4rpx; }
.daily-strip > text:last-child { color: var(--ql-clay-deep); font-size: 24rpx; }

.daily-index {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ql-sage);
  color: var(--ql-surface);
  font-size: 26rpx;
}
.daily-check { width: 36rpx; height: 36rpx; }

.post-avatar {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 52% 48% 58% 42%;
  background: linear-gradient(145deg, #C3D0C0, #A0B29B);
  color: var(--ql-surface);
  font-size: 26rpx;
  flex-shrink: 0;
}

.post-head { display: flex; align-items: center; gap: 20rpx; }
.post-content {
  padding: 26rpx 0;
  font-family: var(--ql-serif);
  font-size: 30rpx;
  line-height: 1.85;
  color: #3B3833;
}
.post-actions { display: flex; gap: 32rpx; border-top: 1rpx solid rgba(74, 61, 49, 0.08); padding-top: 20rpx; }
.archive-button, .action-button { background: transparent; }
.action-button {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: auto;
  margin: 0;
  padding: 8rpx 4rpx;
  color: var(--ql-ink-light);
  font-size: 24rpx;
  line-height: 1.4;
}
.action-button.active { color: var(--ql-clay-deep); }
.action-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }

.comment-icon { position: relative; box-sizing: border-box; width: 28rpx; height: 22rpx; border: 2rpx solid currentColor; border-radius: 8rpx; }
.comment-icon::after { content: ''; position: absolute; left: 4rpx; bottom: -7rpx; width: 8rpx; height: 8rpx; border-left: 2rpx solid currentColor; transform: skew(-28deg); }

.comment-panel {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: var(--ql-radius-inner);
  background: rgba(238, 232, 239, 0.7);
  animation: comment-enter 180ms ease both;
}
.comment-row { display: flex; gap: 16rpx; padding: 12rpx 0; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.55; }
.comment-author { flex-shrink: 0; color: var(--ql-clay-deep); font-weight: 600; }
.comment-content { flex: 1; }
.comment-empty { padding: 10rpx 0 18rpx; color: var(--ql-ink-ghost); font-size: 23rpx; }
.comment-compose { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; }
.comment-input {
  box-sizing: border-box;
  height: 76rpx;
  flex: 1;
  padding: 0 24rpx;
  border: 1rpx solid var(--ql-border);
  border-radius: 999rpx;
  background: rgba(255, 252, 247, 0.92);
  font-size: 25rpx;
}
.comment-submit {
  width: auto;
  min-width: 108rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--ql-ink);
  color: var(--ql-surface);
  font-size: 24rpx;
  line-height: 76rpx;
}
@keyframes comment-enter { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
