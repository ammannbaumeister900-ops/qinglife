<ql-nav-space title="邀请轻友" back />
<view class="referrals-page">
  <view wx:if="{{loading}}" class="empty">正在读取…</view>
  <view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="text-button" bindtap="refresh">重试</button></view>
  <block wx:else>
    <button wx:if="{{records.length}}" class="records-jump" bindtap="scrollToRecords">已有 {{records.length}} 条推荐报名记录，查看 ↓</button>
    <view wx:if="{{!eligible}}" class="empty">轻友邀请暂未开放，请联系工作人员</view>
    <block wx:else>
      <!-- Preview first: this card is exactly what the friend receives in chat. -->
      <image class="invitation-card" src="{{selectedPreset.image}}" mode="widthFix" aria-label="{{'邀请卡片预览：' + selectedPreset.name}}" />
      <view class="invitation-title">{{selectedPreset.title}}</view>
      <view class="preset-picker"><button wx:for="{{presets}}" wx:key="id" class="preset {{selectedPreset.id === item.id ? 'preset-selected' : ''}}" data-id="{{item.id}}" bindtap="choosePreset" aria-selected="{{selectedPreset.id === item.id}}" aria-label="{{'选择' + item.name + '邀请卡片'}}"><image class="preset-art" src="{{item.image}}" mode="widthFix" /><view class="preset-name">{{item.name}}</view></button></view>

      <view class="section-label">邀请朋友参加哪一期</view>
      <view wx:if="{{!sessions.length}}" class="empty">暂无开放报名的期次</view>
      <button wx:for="{{sessions}}" wx:key="id" class="session-choice {{selectedSessionId === item.id ? 'session-selected' : ''}}" data-id="{{item.id}}" disabled="{{preparing}}" bindtap="chooseSession" role="radio" aria-checked="{{selectedSessionId === item.id}}"><view class="session-number"><text class="session-num">{{item.sessionNumber}}</text><text>期</text></view><view class="session-main"><view class="session-title">{{item.name}}</view><view class="copy">{{item.date}}<text wx:if="{{item.place}}"> · {{item.place}}</text></view></view><view class="choice-mark" aria-hidden="true"></view></button>
      <block wx:if="{{sessions.length}}">
        <button wx:if="{{!sharePath}}" class="primary prepare-button" loading="{{preparing}}" disabled="{{preparing || !selectedSessionId}}" bindtap="prepare">{{preparing ? '正在生成邀请' : pickedNumber ? '生成第 ' + pickedNumber + ' 期邀请' : '生成专属邀请'}}</button>
        <view wx:else class="share-ready"><view class="ready-copy">第 {{selectedSessionNumber}} 期邀请已备好</view><button class="primary share-button" open-type="share">分享给朋友</button></view>
      </block>
      <view class="privacy-copy">朋友通过邀请报名后，你可以在这里查看小名与报名状态</view>
    </block>
    <view id="referral-records" class="record-heading">推荐记录</view>
    <view wx:if="{{!records.length}}" class="empty record-empty">暂无推荐报名记录</view>
    <view wx:for="{{records}}" wx:key="registrationId" class="record"><view class="record-top"><text class="record-name">{{item.nickname || '轻友'}}</text><text class="status">{{item.statusText}}</text></view><view class="copy">第 {{item.sessionNumber}} 期 · {{item.sessionName}}</view><view class="date">{{item.registeredAt}}</view></view>
  </block>
</view>
