page { background: #f6f1e8; color: #51433c; }
.referrals-page { padding: 40rpx 36rpx calc(90rpx + env(safe-area-inset-bottom)); background: radial-gradient(ellipse at 90% 0,#ede0d7,transparent 580rpx); }
.intro { padding: 12rpx 0 34rpx; }
.eyebrow { font-size: 22rpx; letter-spacing: 4rpx; color: #a08578; }
.title { font-family: var(--ql-serif); font-size: 50rpx; letter-spacing: 4rpx; line-height: 1.6; margin: 20rpx 0 16rpx; }
.title-second { padding-left: 82rpx; }
.intro-copy { font-size: 25rpx; color: #947e6d; letter-spacing: 2rpx; }
.invitation-preview { border: 1rpx solid #e4d4c6; border-radius: 8rpx; overflow: hidden; background: #fffbf5; box-shadow: 0 12rpx 32rpx rgba(117,89,72,.08); }
.invitation-art { display: block; width: 100%; height: 542rpx; }
.art-caption { margin: 22rpx 0; text-align: center; font-size: 23rpx; color: #978676; }
.preset-picker { display: flex; gap: 18rpx; margin-bottom: 44rpx; }
.referrals-page button.preset { flex: 1; min-width: 0; margin: 0; padding: 8rpx; border: 2rpx solid transparent; border-radius: 12rpx; background: rgba(255,255,255,.45); line-height: 1.5; }
.referrals-page button.preset-selected { border-color: #ac8570; background: #fff9f1; }
.preset-art { display: block; width: 100%; height: 154rpx; }
.preset-name { margin: 8rpx 0 4rpx; font-size: 23rpx; color: #806955; }
.section-label { font-size: 26rpx; margin-bottom: 18rpx; }
.referrals-page button.session-choice { display: flex; align-items: center; gap: 20rpx; width: 100%; box-sizing: border-box; margin: 14rpx 0; padding: 24rpx; border: 1rpx solid #e3d9ca; border-radius: 12rpx; background: rgba(255,255,255,.36); text-align: left; line-height: 1.6; }
.referrals-page button.session-selected { border-color: #ab8b76; background: #fffbf4; }
.session-main { flex: 1; min-width: 0; }
.session-title { font-size: 28rpx; color: #695346; }
.choice-mark { flex-shrink: 0; width: 34rpx; height: 34rpx; border: 1rpx solid #b8a28d; border-radius: 50%; font-size: 23rpx; line-height: 34rpx; text-align: center; color: #806955; }
.copy { color: #948677; font-size: 24rpx; line-height: 1.8; }
.referrals-page button.prepare-button,.referrals-page button.share-button { margin: 28rpx 0 0; width: 100%; }
.share-ready { padding-top: 20rpx; }
.ready-copy { text-align: center; font-size: 24rpx; color: #827561; }
.share-hint { text-align: center; color: #a0907e; font-size: 22rpx; margin-top: 18rpx; }
.privacy-copy { color: #a0907e; font-size: 22rpx; line-height: 1.8; margin-top: 28rpx; }
.record-heading { font-family: var(--ql-serif); font-size: 34rpx; letter-spacing: 3rpx; margin: 60rpx 0 10rpx; padding-top: 36rpx; border-top: 1rpx solid #ded5c6; }
.record { padding: 28rpx 0; border-bottom: 1rpx solid #e2d8cd; }
.record-top { display: flex; justify-content: space-between; gap: 24rpx; margin-bottom: 10rpx; font-size: 29rpx; }
.status { font-size: 24rpx; color: #807465; }
.date { font-size: 22rpx; color: #a3978c; margin-top: 8rpx; }
.empty { padding: 42rpx 0; font-size: 26rpx; line-height: 1.9; color: #8c8076; }
.record-empty { font-size: 24rpx; }
button::after { border: none; }

.referrals-page button.primary { background: #a17d68; color: #fffaf2; min-height: 100rpx; border-radius: 18rpx; }
