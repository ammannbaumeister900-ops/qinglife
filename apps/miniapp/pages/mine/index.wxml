<launch-splash />
<ql-nav-space title="我的" />
<view class="page mine-page editorial-page">
  <view wx:if="{{refreshing}}" class="refresh-note">正在更新…</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取…</view>
  <view wx:if="{{loadError}}" class="empty-state">{{loadError}}<button class="text-button" bindtap="onShow">重试</button></view>
  <block wx:if="{{!loading && !loadError}}">
    <view class="profile-head">
      <view class="profile-avatar">{{avatarText}}</view>
      <view class="list-main">
        <button wx:if="{{state.loggedIn && !state.profile.nickname}}" class="profile-title profile-nickname-entry" bindtap="openFriendRegistration">点击登记你的小名</button>
        <view wx:else class="profile-title">{{state.loggedIn ? state.profile.nickname : '登录后，查看自己的参与和记录'}}</view>
        <button wx:if="{{!state.loggedIn}}" class="primary profile-login" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="login">微信登录</button>
      </view>
    </view>

    <view class="asset-list">
      <button class="asset" bindtap="openFriendRegistration"><view class="asset-main"><view class="asset-name">轻友登记</view></view><text class="asset-chevron">›</text></button>
      <button class="asset" data-view="experiences" bindtap="openFlow"><view class="asset-main"><view class="asset-name">全部参与经历</view></view><text class="asset-chevron">›</text></button>
      <button class="asset" data-view="records" bindtap="openFlow"><view class="asset-main"><view class="asset-name">私人记录</view><view class="asset-description">仅自己可见</view></view><text class="asset-chevron">›</text></button>
      <button class="asset" data-view="collections" bindtap="openFlow"><view class="asset-main"><view class="asset-name">内容收藏</view></view><text class="asset-chevron">›</text></button>
      <button wx:if="{{state.backend && state.loggedIn}}" class="asset invite-entry" bindtap="openReferrals"><view class="asset-main"><view class="asset-name">邀请轻友</view></view><text class="asset-chevron">›</text></button>
    </view>

    <view wx:if="{{state.loggedIn && state.passAccounts && state.passAccounts.length}}" class="pass-ledger">
      <view class="pass-balance-row"><view class="pass-label">我的卡次</view><view class="pass-summary"><text class="pass-caption">当前剩余</text><text class="pass-balance">{{state.currentPassBalance}}</text><text class="pass-unit">次</text></view></view>
      <view class="pass-record-label">最近卡次消耗记录</view>
      <view wx:for="{{passConsumptions}}" wx:key="id" class="pass-record"><view class="pass-record-main"><view>{{item.sessionNumber ? '第 ' + item.sessionNumber + ' 期' : '卡次使用'}}</view><view class="pass-record-date">{{item.occurredAt}}</view></view><view class="pass-record-amount">−{{0-item.quantityDelta}} 次<view class="pass-record-date">余 {{item.balanceAfter}} 次</view></view></view>
      <view wx:if="{{!passConsumptions.length}}" class="pass-caption">暂无卡次消耗记录</view>
    </view>

    <view class="utility-list">
      <button class="utility-entry" data-view="privacy" bindtap="openFlow"><text class="utility-name">设置与隐私</text><text class="asset-chevron">›</text></button>
      <button class="utility-entry history-entry" data-view="archive" bindtap="openFlow"><text class="utility-name">历史打卡</text><text class="asset-chevron">›</text></button>
    </view>

    <view class="contact-section">
      <view class="contact-label">联系轻生活</view>
      <view class="contact-top">
        <view class="contact-main"><view class="contact-title">{{contact.name}}</view><text wx:if="{{contact.wechat}}" class="contact-wechat" user-select="true" selectable="true">{{contact.wechat}}</text></view>
        <button wx:if="{{contact.wechat}}" class="secondary contact-copy" bindtap="copyContact">复制微信号</button>
      </view>
      <view wx:if="{{contact.wechat}}" class="contact-hint">复制后，在微信中搜索添加好友</view>
      <view wx:else class="contact-hint contact-unavailable">暂时没有可用微信号</view>
    </view>

    <button wx:if="{{staffAccess}}" class="utility-entry staff-entry" bindtap="openStaff"><view class="asset-main"><view>工作人员工作台</view><view class="asset-description">工作人员专属</view></view><text class="asset-chevron">›</text></button>
  </block>
  <button wx:if="{{state.backend && state.loggedIn}}" class="utility-entry" bindtap="logout" loading="{{logoutLoading}}" disabled="{{loginLoading || logoutLoading}}">退出登录</button>
</view>
