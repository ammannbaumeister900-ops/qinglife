.mine-page { padding: 28rpx 40rpx calc(180rpx + env(safe-area-inset-bottom)); background: var(--ql-bg); }
.mine-page::before { display: none; }
.profile-head { display: flex; align-items: center; gap: 24rpx; padding: 12rpx 0 32rpx; }
.profile-avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 10rpx; background: var(--ql-bg-deep); color: var(--ql-ink); font-size: 30rpx; }
.profile-title { font-size: 32rpx; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
.mine-page button.profile-nickname-entry { min-height: 44px; margin: 0; padding: 8rpx 0; border-radius: 0; background: transparent; color: var(--ql-ink); text-align: left; white-space: normal; }
.mine-page .primary, .mine-page .secondary, .mine-page .text-button { min-height: 44px; padding: 16rpx 24rpx; border-radius: 10rpx; font-size: 28rpx; line-height: 1.5; }
.mine-page .profile-login { width: auto; min-height: 48px; margin: 16rpx 0 0; }
.asset-list { border-top: 1rpx solid var(--ql-border); }
.mine-page .asset { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: 44px; margin: 0; padding: 24rpx 0; border-bottom: 1rpx solid var(--ql-border); border-radius: 0; background: transparent; color: var(--ql-ink); text-align: left; line-height: 1.6; white-space: normal; }
.asset-main { flex: 1; min-width: 0; }
.asset-name { font-size: 30rpx; font-weight: 500; overflow-wrap: anywhere; }
.asset-description { margin-top: 6rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.6; overflow-wrap: anywhere; }
.asset-chevron { flex: none; color: var(--ql-ink-light); font-size: 32rpx; }
.pass-ledger { margin-top: 32rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--ql-border); }
.pass-balance-row, .pass-summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16rpx; }
.pass-balance-row { justify-content: space-between; margin-bottom: 20rpx; }
.pass-label { font-size: 30rpx; font-weight: 500; }
.pass-caption, .pass-unit, .pass-record-label, .pass-record-date { color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.6; }
.pass-balance { color: var(--ql-ink); font-size: 36rpx; font-weight: 500; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.pass-record { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; font-size: 28rpx; line-height: 1.6; }
.pass-record-main { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.pass-record-date { margin-top: 4rpx; }
.pass-record-amount { flex: none; text-align: right; font-variant-numeric: tabular-nums; }
.utility-list { margin-top: 24rpx; }
.mine-page .utility-entry { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: 44px; margin: 0; padding: 20rpx 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; text-align: left; line-height: 1.6; white-space: normal; }
.utility-name { flex: 1; }
.contact-section { margin-top: 24rpx; padding: 28rpx 0; border-top: 1rpx solid var(--ql-border); }
.contact-label { color: var(--ql-ink-light); font-size: 28rpx; }
.contact-top { display: flex; align-items: center; gap: 20rpx; margin-top: 12rpx; }
.contact-main { flex: 1; min-width: 0; }
.contact-title { color: var(--ql-ink); font-size: 30rpx; line-height: 1.6; overflow-wrap: anywhere; }
.contact-wechat { color: var(--ql-ink); font-size: 28rpx; line-height: 1.6; overflow-wrap: anywhere; }
.mine-page button.contact-copy { flex: none; width: auto; margin: 0; background: transparent; }
.contact-hint { margin-top: 12rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.6; }
.mine-page .staff-entry { padding-top: 24rpx; border-top: 1rpx solid var(--ql-border); }
.mine-page .empty-state { margin: 0; padding: 32rpx 0; border: none; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; text-align: left; overflow-wrap: anywhere; }
.mine-page .refresh-note { position: static; margin: 0 0 12rpx; padding: 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; }
.mine-page button:active { opacity: .8; transform: none; }
@media (max-width: 350px) {
  .profile-title { font-size: 16px; }
  .asset-name, .pass-label, .contact-title { font-size: 15px; }
  .profile-avatar { font-size: 14px; }
  .asset-description, .pass-caption, .pass-unit, .pass-record-label, .pass-record-date, .pass-record,
  .mine-page .utility-entry, .contact-label, .contact-wechat, .contact-hint, .mine-page .empty-state,
  .mine-page .refresh-note, .mine-page .primary, .mine-page .secondary, .mine-page .text-button { font-size: 14px; }
}
@media (prefers-reduced-motion: reduce) { .mine-page button { transition: none; } }
