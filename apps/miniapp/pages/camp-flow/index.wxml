<launch-splash />
<ql-nav-space title="{{view === 'detail' ? '活动详情' : view === 'register' ? '活动报名' : view === 'experience' ? '体验回顾' : '清体营服务'}}" back />
<view class="page camp-flow-page editorial-page {{view === 'detail' ? 'detail-page' : view === 'register' ? 'registration-page' : view === 'journey' ? 'service-page' : ''}} flow-{{view}}">
  <view wx:if="{{loading}}" class="empty-state">正在读取活动…</view>
  <view wx:if="{{loadError}}" class="empty-state"><view class="empty-title">暂时无法打开活动</view><view class="empty-copy">{{loadError}}</view><button class="empty-action" bindtap="refresh">重试</button></view>
  <block wx:if="{{!loading && !loadError}}">
  <block wx:if="{{view === 'detail' && detail.ready}}">
    <view wx:if="{{isRegistered}}" class="detail-registration-notice">
      <view class="detail-registration-title {{detail.registrationTone}}">你的报名：{{detail.registrationLabel}}</view>
      <view wx:if="{{detail.registrationNote}}" class="detail-registration-note">{{detail.registrationNote}}</view>
    </view>
    <view class="detail-entry">
      <view class="detail-period-state"><view wx:if="{{activity.sessionNumber != null}}" class="detail-period"><text class="detail-period-number">{{activity.sessionNumber}}</text><text>期</text></view><text wx:else>期次待公布</text><text class="detail-activity-state {{!availability.canRegister ? 'disabled' : activity.status === '候补中' ? 'warning' : ''}}">{{activity.status}}</text></view>
      <view class="detail-title">{{activity.name}}</view>
      <view wx:if="{{activity.theme && activity.theme !== activity.name}}" class="detail-theme">{{activity.theme}}</view>
      <view class="detail-core-facts">
        <view class="detail-core-date"><text wx:if="{{detail.year}}" class="detail-year">{{detail.year}}年</text>{{detail.date}}<text wx:if="{{detail.duration != null}}"> · {{detail.duration}}天</text></view>
        <view wx:if="{{detail.place}}" class="detail-core-place">{{detail.place}}</view>
      </view>
    </view>
    <view wx:if="{{detail.showCover && !detail.isPoster}}" class="camp-cover">
      <button class="detail-image-button" data-url="{{detail.cover}}" bindtap="previewDetailImage" aria-label="查看活动图片"><image class="camp-cover-image" src="{{detail.cover}}" mode="widthFix" data-url="{{detail.cover}}" binderror="detailImageFailed" /></button>
    </view>
    <view wx:if="{{detail.intro}}" class="detail-intro">{{detail.intro}}</view>
    <view wx:if="{{detail.participation || detail.suitedFor.length}}" class="detail-section detail-participation">
      <view class="detail-functional-title">参加须知</view>
      <view wx:if="{{detail.participation}}" class="detail-copy">{{detail.participation}}</view>
      <view wx:if="{{detail.suitedFor.length}}" class="detail-suited"><view class="detail-rule-title">适合人群</view><view wx:for="{{detail.suitedFor}}" wx:key="*this" class="detail-copy">{{item}}</view></view>
    </view>
    <view wx:if="{{activity.leader}}" class="detail-section detail-guides">
      <view class="detail-guide-row"><view class="detail-guide-info"><view class="detail-functional-title">本期导游</view><view class="detail-guide-names">{{activity.leader}}</view></view>
        <button wx:if="{{detail.showGuideImage}}" class="detail-image-button detail-guide-photo" data-url="{{detail.guideImage}}" bindtap="previewDetailImage" aria-label="查看导游合照"><image src="{{detail.guideImage}}" mode="widthFix" data-url="{{detail.guideImage}}" binderror="detailImageFailed" /></button>
      </view>
    </view>
    <view class="detail-section detail-fees">
      <view class="detail-section-title">公开费用</view>
      <view class="detail-fee-row"><text class="detail-fee-label">新轻友公开价</text><view wx:if="{{detail.hasFee}}" class="detail-fee-value"><text class="detail-fee-currency">¥</text>{{activity.fee}}<text class="detail-fee-unit">/人</text></view><text wx:else class="detail-copy">价格待核对</text></view>
      <view wx:if="{{detail.hasReturningFee}}" class="detail-fee-row"><text class="detail-fee-label">老轻友公开价</text><view class="detail-fee-value"><text class="detail-fee-currency">¥</text>{{activity.returningFee}}<text class="detail-fee-unit">/人</text></view></view>
      <view wx:if="{{detail.hasCapacity}}" class="detail-capacity"><text>人数上限</text><text>{{activity.capacity}}人</text></view>
    </view>
    <view class="detail-section detail-arrangement">
      <view class="detail-section-title">活动安排</view>
      <view wx:if="{{detail.hasScheduleContent && !detailExpanded}}" class="detail-preview-days">
        <view wx:for="{{detail.previewDays}}" wx:key="key" class="detail-day-row"><view class="detail-day-date">{{item.date}}<text wx:if="{{item.label}}" class="detail-day-label">{{item.label}}</text></view><view class="detail-day-copy"><view wx:if="{{item.theme}}" class="detail-day-title">{{item.theme}}</view><view wx:if="{{item.time}}" class="detail-day-time">{{item.time}}</view></view></view>
      </view>
      <view wx:if="{{!detail.hasScheduleContent}}" class="detail-arrangement-note">具体安排请与工作人员核对。</view>
      <scroll-view wx:if="{{detailExpanded && detail.canExpand}}" class="detail-full-schedule" scroll-y="true" enhanced="true" style="height: {{detail.scheduleHeight}}px;" aria-label="完整活动日程">
        <view wx:for="{{detail.fullDays}}" wx:key="key" class="detail-day-row {{!item.hasContent ? 'detail-date-only' : ''}}"><view class="detail-day-date">{{item.date}}<text wx:if="{{item.label}}" class="detail-day-label">{{item.label}}</text></view><view wx:if="{{item.hasContent}}" class="detail-day-copy"><view wx:if="{{item.theme}}" class="detail-day-title">{{item.theme}}</view><view wx:if="{{item.time}}" class="detail-day-time">{{item.time}}</view></view></view>
      </scroll-view>
      <button wx:if="{{detail.canExpand}}" class="detail-schedule-toggle" bindtap="toggleDetailSchedule" aria-expanded="{{detailExpanded}}"><text>{{detailExpanded ? (detail.hasScheduleContent ? '收起完整安排' : '收起日期列表') : detail.scheduleLabel}}</text><view class="detail-chevron {{detailExpanded ? 'expanded' : ''}}"></view></button>
    </view>
    <view wx:if="{{detail.changeRule}}" class="detail-section detail-rules">
      <view wx:if="{{detail.changeRule}}" class="detail-rule"><view class="detail-rule-title">改期与取消</view><view class="detail-rule-copy">{{detail.changeRule}}</view></view>
    </view>
    <view class="detail-actionbar {{isRegistered ? 'detail-booked' : ''}}">
      <view class="action-summary"><view wx:if="{{isRegistered}}" class="detail-action-registration">报名{{detail.registrationLabel}}</view><block wx:else><view class="action-price"><text class="price-caption">公开价</text><block wx:if="{{detail.hasFee}}"><text class="price-currency">¥</text><text class="price-number">{{activity.fee}}</text><text class="price-unit">/人</text></block><text wx:else class="price-caption">待核对</text></view><view class="action-status">{{availability.label}}</view></block></view>
      <button wx:if="{{!isRegistered || canReapply}}" class="primary action-primary" disabled="{{!availability.canRegister}}" bindtap="startRegistration">{{availability.canRegister ? (canReapply ? '重新报名' : activity.status === '候补中' ? '申请候补' : '报名这一期') : availability.label}}</button>
      <button wx:else class="primary action-primary" bindtap="openJourney">查看报名与服务</button>
    </view>
  </block>

  <block wx:elif="{{view === 'register'}}">
    <view id="camp-submit-error"><view wx:if="{{formError.target === 'camp-submit-error'}}" class="form-error">{{formError.message}}</view></view>
    <view class="registration-heading">
      <view class="registration-session">第 {{activity.sessionNumber}} 期 · {{activity.status}}</view>
      <view class="registration-name">{{activity.name}}</view>
      <view class="registration-facts">{{activity.date}}<text wx:if="{{detail.place}}"> · {{detail.place}}</text></view>
    </view>
    <view class="registration-steps" aria-label="报名第 {{step}} 步，共 2 步">
      <view class="registration-step {{step === 1 ? 'is-current' : 'is-complete'}}"><text class="step-number">1</text><text>填写信息</text><text wx:if="{{step === 2}}" class="step-completed">已填写</text></view>
      <view class="registration-step {{step === 2 ? 'is-current' : ''}}"><text class="step-number">2</text><text>核对报名</text></view>
    </view>

    <block wx:if="{{step === 1}}">
      <view class="participant-group" id="camp-participants">
        <view class="registration-section-heading"><view class="registration-section-title">参与者</view><text class="registration-hint">已选 {{selectedCount}} 人</text></view>
        <view wx:if="{{formError.target === 'camp-participants'}}" class="form-error">{{formError.message}}</view>
        <view wx:if="{{!draft.participants.length}}" class="empty"><view class="empty-title">还没有可选参与者</view><view class="empty-copy">请先完善本人或家人的参与信息。</view></view>
        <view wx:for="{{draft.participants}}" wx:key="id" class="registration-person" id="camp-participant-{{index}}">
          <view class="check-row participant-select" data-id="{{item.id}}" bindtap="toggleParticipant" role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.name || item.relation || '参与者'}}">
            <checkbox checked="{{item.selected}}" disabled="{{item.existingActive}}" color="#53624A" aria-hidden="true" />
            <view class="list-main"><text class="list-title">{{item.name || (item.id === 'person-self' ? '本人' : '未填写称呼')}}<text wx:if="{{item.relation}}" class="participant-relation"> · {{item.relation}}</text><text wx:if="{{item.minor}}" class="participant-relation"> · 未成年人</text><text wx:if="{{item.existingActive}}" class="participant-relation"> · 已报名</text></text></view>
          </view>
          <view wx:if="{{formError.target === 'camp-participant-' + index}}" class="form-error">{{formError.message}}</view>
          <view wx:if="{{item.selected && state.backend && item.id === 'person-self'}}" class="participant-fields">
            <view class="field" id="camp-self-name"><text class="label">本人的小名或称呼 <text class="field-requirement">必填</text></text><input class="input" maxlength="50" placeholder="填写小名或称呼" value="{{item.name}}" bindinput="onSelfName" /><view wx:if="{{formError.target === 'camp-self-name'}}" class="form-error">{{formError.message}}</view></view>
            <view class="field" id="camp-self-phone"><text class="label">本人手机号 <text class="field-requirement">选填</text></text><input class="input" type="number" maxlength="11" placeholder="没有本人号码可留空" value="{{item.phone}}" bindinput="onSelfPhone" /><view wx:if="{{formError.target === 'camp-self-phone'}}" class="form-error">{{formError.message}}</view></view>
          </view>
          <view wx:if="{{item.selected && item.id !== 'person-self'}}" class="participant-fields">
            <view class="field"><text class="label">与你的关系</text><picker mode="selector" range="{{relationOptions}}" data-index="{{index}}" bindchange="onParticipantRelation"><view class="input relationship-select">{{item.relation || '请选择关系'}}<text aria-hidden="true">⌄</text></view></picker></view>
            <view class="field"><text class="label">参与者姓名或称呼 <text class="field-requirement">必填</text></text><input class="input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onParticipantInput" placeholder="填写参与者姓名或称呼" /></view>
            <view class="field"><text class="label">参与者本人手机号（选填）</text><input class="input" type="number" maxlength="11" value="{{item.phone}}" data-index="{{index}}" data-field="phone" bindinput="onParticipantInput" placeholder="没有本人号码可留空" /></view>
          </view>
        </view>
      </view>
      <button class="text-button registration-add" bindtap="showAddPerson" aria-expanded="{{addingPerson}}">{{addingPerson ? '收起新增参与者' : '添加参与者'}}</button>
      <view wx:if="{{addingPerson}}" class="form-section add-person-section"><view class="registration-section-title">新增参与者</view>
        <view class="field" id="camp-person-name"><text class="label">姓名或称呼 <text class="field-requirement">必填</text></text><input class="input" value="{{personName}}" bindinput="onPersonName" placeholder="填写姓名或称呼" /><view wx:if="{{formError.target === 'camp-person-name'}}" class="form-error">{{formError.message}}</view></view>
        <view class="field" id="camp-person-relation"><text class="label">与你的关系 <text class="field-requirement">必填</text></text><picker mode="selector" range="{{relationOptions}}" bindchange="onPersonRelation"><view class="input relationship-select">{{personRelation || '请选择关系'}}<text aria-hidden="true">⌄</text></view></picker><view wx:if="{{formError.target === 'camp-person-relation'}}" class="form-error">{{formError.message}}</view></view>
        <view class="check-row registration-minor" bindtap="toggleMinor" role="checkbox" aria-checked="{{personMinor}}"><checkbox checked="{{personMinor}}" color="#53624A" aria-hidden="true" />未成年人</view>
        <view class="field" id="camp-person-phone"><text class="label">参与者本人手机号 <text class="field-requirement">选填</text></text><input class="input" type="number" maxlength="11" value="{{personPhone}}" bindinput="onPersonPhone" placeholder="没有本人号码可留空" /><view wx:if="{{formError.target === 'camp-person-phone'}}" class="form-error">{{formError.message}}</view></view>
        <button class="secondary" bindtap="addPerson">保存参与者</button>
      </view>
      <view class="privacy-note participant-note">每位参与者有独立记录。手机号选填，同行者请勿共用手机号或复制联系人号码；未填号码不会自动获得独立登录权限。</view>
      <view class="form-section registration-contact"><view class="registration-section-title">主要联系人</view>
        <view class="registration-hint">用于报名联系与安排确认</view>
        <view class="field" id="camp-contact-name"><text class="label">联系人小名或称呼 <text class="field-requirement">必填</text></text><input class="input" maxlength="50" value="{{draft.contactName}}" bindinput="onContactName" placeholder="填写联系人称呼" /><view wx:if="{{formError.target === 'camp-contact-name'}}" class="form-error">{{formError.message}}</view></view>
        <view class="field" id="camp-contact-phone"><text class="label">联系人手机号 <text class="field-requirement">必填</text></text><input class="input" type="number" maxlength="11" value="{{draft.contactPhone}}" bindinput="onContactPhone" placeholder="填写 11 位手机号" /><view wx:if="{{formError.target === 'camp-contact-phone'}}" class="form-error">{{formError.message}}</view></view>
      </view>
    </block>

    <block wx:else>
      <view class="registration-section-heading"><view class="registration-section-title">参与者</view><text class="summary-count">{{selectedCount}} 人</text></view>
      <view class="summary-people"><view wx:for="{{draft.participants}}" wx:key="id" wx:if="{{item.selected}}" class="summary-person">
        <view class="summary-person-line"><text class="summary-person-name">{{item.name}}</text><text class="registration-hint">{{item.relation}}<text wx:if="{{item.minor}}"> · 未成年人</text></text></view>
        <view class="registration-hint">{{item.phone || (item.id === 'person-self' ? state.phone : '') || '本人手机号未填写'}}</view>
      </view></view>
      <view class="summary-contact"><view class="registration-section-title">主要联系人</view><view class="summary-contact-name">{{draft.contactName}}</view><view>{{draft.contactPhone}}</view></view>
      <view class="summary-price"><view class="registration-section-title">本次参考总价</view>
        <view wx:if="{{quoteLoading}}" class="registration-hint">正在核对参与者价格…</view>
        <view wx:elif="{{quote.ready}}" class="registration-total">¥{{quote.total}}<text> / {{selectedCount}}人</text></view>
        <view wx:else class="registration-hint">{{quote.error || '价格待核对'}}</view>
        <view wx:for="{{quote.rows}}" wx:key="id" class="registration-price-row"><text>{{item.name}} · {{item.friendLabel}}</text><text>¥{{item.price}}</text></view>
        <button wx:if="{{!quote.ready && !quoteLoading && state.backend}}" class="text-button" bindtap="loadQuote">重新核对价格</button>
        <view class="registration-hint">参考价不代表已缴费，最终结算以工作人员核对为准。</view>
      </view>
      <view wx:if="{{invitationCode}}" class="privacy-note registration-invitation">通过轻友专属邀请报名，会记录推荐关系；推荐轻友可查看参与者小名与报名状态。</view>
      <view id="camp-service-consent" class="check-row summary-consent" data-key="serviceConsent" bindtap="toggleConsent" role="checkbox" aria-checked="{{draft.serviceConsent}}"><checkbox checked="{{draft.serviceConsent}}" color="#53624A" aria-hidden="true" /><view class="list-main"><text class="list-title">同意处理服务必要信息 <text class="field-requirement">必选</text></text><text class="list-note">用于报名联系与活动服务，提交前需勾选。</text><view wx:if="{{formError.target === 'camp-service-consent'}}" class="form-error">{{formError.message}}</view></view></view>
    </block>
  </block>

  <block wx:elif="{{view === 'success'}}">
    <view class="registration-result">
      <view class="result-title">{{submittedServiceStatus ? '报名已提交，' + submittedServiceStatus.registration : registration.status === 'pending' ? '报名已提交，' + serviceStatus.registration : '报名状态：' + serviceStatus.registration}}</view>
      <view class="card-copy">共 {{submittedParticipantCount || selectedCount}} 位参与者。{{submittedServiceStatus ? submittedServiceStatus.registrationNote : serviceStatus.registrationNote}}</view>
    </view>
    <view wx:if="{{state.registration.status === 'pending'}}" class="privacy-note">请返回清体营查看本期报名状态，或联系工作人员确认。当前不会自动发送确认通知。</view>
    <view wx:if="{{serviceStatus.operationalRisk}}" class="operational-risk">历史报名已确认，缴费和名额需运营核查。</view>
    <button class="primary" bindtap="openJourney">查看安排</button>
    <button wx:if="{{state.backend && hasSelfActiveRegistration}}" class="secondary result-reflection" disabled="{{!reflectionAccess.allowed || reflectionOpening}}" bindtap="openReflection">写心声</button>
    <view wx:if="{{state.backend && hasSelfActiveRegistration && !reflectionAccess.allowed}}" class="service-status-note">{{reflectionAccess.reason}}</view>
    <button class="text-button" bindtap="backToCamp">返回清体营</button>
  </block>

  <block wx:elif="{{view === 'journey'}}">
    <view class="service-heading"><view class="service-session">第 {{activity.sessionNumber}} 期 · {{selectedCount}} 位参与者</view><view class="service-title">{{activity.name}}</view><view class="service-facts"><text wx:if="{{activity.date}}">{{activity.date}}</text><text wx:if="{{activity.city || activity.place}}">{{activity.city}}<text wx:if="{{activity.city && activity.place}}"> · </text>{{activity.place}}</text></view></view>
    <view class="service-status-card">
      <view class="service-status-row"><view class="service-state-line"><text class="summary-label">报名状态</text><text class="service-status-value">{{serviceStatus.registration}}</text></view><view wx:if="{{serviceStatus.registrationNote}}" class="service-status-note">{{serviceStatus.registrationNote}}</view></view>
      <view class="service-status-row"><view class="service-state-line"><text class="summary-label">费用状态</text><text class="service-status-value">{{serviceStatus.payment}}</text></view><view wx:if="{{serviceStatus.paymentNote}}" class="service-status-note">{{serviceStatus.paymentNote}}</view></view>
    </view>
    <view wx:if="{{registration.status === 'pending'}}" class="privacy-note">请返回清体营查看本期报名状态，或联系工作人员确认。当前不会自动发送确认通知。</view>
    <view wx:if="{{serviceStatus.operationalRisk}}" class="operational-risk">历史报名已确认，缴费和名额需运营核查。</view>
    <button wx:if="{{canReapply && availability.canRegister}}" class="secondary" bindtap="startRegistration">重新报名</button>
    <view wx:for="{{cancelledHistory}}" wx:key="registrationId" class="service-status-note">已取消记录 · {{item.isSelf ? '本人' : item.participantName || '参与者'}} · {{item.reference}}</view>
    <view wx:if="{{hasSelfActiveRegistration}}" class="journey-reflection service-reflection">
      <view class="journey-reflection-title">轻友心声</view>
      <view wx:if="{{reflectionAccess.allowed}}" class="service-status-note">可公开发表或仅自己保存。</view>
      <button wx:if="{{state.backend}}" class="secondary" disabled="{{!reflectionAccess.allowed || reflectionOpening}}" loading="{{reflectionOpening}}" bindtap="openReflection">写下我的心声</button>
      <view wx:if="{{state.backend && !reflectionAccess.allowed}}" class="service-status-note">{{reflectionAccess.reason}}</view>
      <button wx:if="{{reflectionAccess.retry}}" class="text-button" bindtap="refresh">重试</button>
    </view>
    <button class="text-button service-back" bindtap="backToCamp">返回清体营</button>
  </block>
  <block wx:elif="{{view === 'feeling'}}">
    <view class="writing-heading"><view class="task-title">{{feelingPhase === 'before' ? '活动前感受' : '活动后感受'}}</view><view class="task-copy">选填，不影响参加或完成活动。</view></view>
    <button wx:if="{{state.backend && hasSelfActiveRegistration && feelingPhase === 'after'}}" class="primary" disabled="{{!reflectionAccess.allowed || reflectionOpening}}" bindtap="openReflection">写活动后感受</button>
    <view wx:if="{{state.backend && hasSelfActiveRegistration && feelingPhase === 'after' && !reflectionAccess.allowed}}" class="service-status-note">{{reflectionAccess.reason}}</view>
    <view wx:if="{{!state.backend || feelingPhase !== 'after'}}" class="feeling-editor"><text class="label">我的感受（选填）</text><textarea class="textarea" disabled="{{!canRecordFeeling || feelingSaving}}" maxlength="-1" placeholder="留下一句话（选填）" value="{{feelingNote}}" bindinput="onFeelingInput"/><view class="privacy-note">{{feelingLength}} / 150</view><view wx:if="{{feelingLength > 150}}" class="form-error">历史原文完整保留；修改后保存须在150字内。</view><view class="privacy-note">默认仅自己可见，不会随邀请或活动内容公开。</view><view wx:if="{{feelingError}}" class="form-error feeling-error" role="alert">{{feelingError}}</view><button class="primary" loading="{{feelingSaving}}" disabled="{{feelingSaving || !canRecordFeeling}}" bindtap="saveFeeling">保存感受</button><view wx:if="{{feelingSaved}}" class="saved-note">已保存 · 仅自己可见</view></view>
    <button class="text-button" bindtap="openJourney">返回本次安排</button>
  </block>
  <block wx:elif="{{view === 'invite'}}">
    <view class="invite-heading"><view class="task-title">邀请朋友了解轻生活</view><view class="task-copy">只分享活动介绍，不包含你的私人感受。</view></view>
    <view wx:if="{{state.invitationEligible !== true || state.profile.minor}}" class="empty-state">轻友邀请暂未开放，请联系工作人员</view>
    <block wx:else><view wx:if="{{!inviteActivities.length}}" class="empty-state">暂时没有下一场开放活动</view>
    <button wx:for="{{inviteActivities}}" wx:key="id" class="invitation-row" disabled="{{invitePreparing}}" data-id="{{item.id}}" bindtap="prepareInvitation"><view class="invitation-copy"><view class="invitation-session">第 {{item.sessionNumber}} 期<text wx:if="{{preparedInviteId === item.id}}"> · 已准备</text></view><view class="invitation-name">{{item.name}}</view><view class="invitation-date">{{item.date}}</view></view><text class="invitation-action">准备邀请</text></button>
    <view wx:if="{{sharePath}}" class="prepared-invitation"><view class="prepared-invitation-name">已准备：{{shareTitle}}</view><button class="primary" open-type="share">分享活动邀请</button></view></block>
  </block>
  <block wx:else>
    <view class="experience-heading">
      <view wx:if="{{activity.sessionNumber}}" class="experience-period">第 {{activity.sessionNumber}} 期</view>
      <view class="experience-title">体验回顾</view>
      <view class="experience-name">{{activity.name}}</view>
      <view wx:if="{{activity.date}}" class="experience-date">{{activity.date}}</view>
      <view class="experience-privacy">仅自己可见 · 不随活动邀请分享</view>
    </view>
    <block wx:if="{{canReview}}">
      <view class="experience-records-heading"><text>本期私人记录</text><text class="experience-count">{{experienceTimeline.length}} 条</text></view>
      <view class="experience-records">
        <view wx:for="{{experienceTimeline}}" wx:key="displayKey" wx:if="{{!(reviewEditing && item.isAfter)}}" class="experience-record">
          <view class="experience-meta"><text class="experience-phase">{{item.label}}</text><text>{{item.updatedText}}</text></view>
          <view wx:if="{{item.note}}" class="experience-note {{item.hasLongNote && !reviewExpanded[item.displayKey] ? 'is-clamped' : ''}}">{{item.note}}</view>
          <view wx:elif="{{!item.scoreText}}" class="experience-empty-note">已保存空白感受</view>
          <view wx:if="{{item.scoreText}}" class="experience-scores">{{item.scoreText}}</view>
          <view wx:if="{{item.hasLongNote || (item.isAfter && canWriteReview)}}" class="experience-record-actions">
            <button wx:if="{{item.hasLongNote}}" class="experience-text-action" data-key="{{item.displayKey}}" bindtap="toggleExperienceRecord" aria-expanded="{{!!reviewExpanded[item.displayKey]}}">{{reviewExpanded[item.displayKey] ? '收起全文' : '阅读全文'}}</button>
            <button wx:if="{{item.isAfter && canWriteReview}}" class="experience-text-action experience-edit" bindtap="editReview">编辑活动后感受</button>
          </view>
        </view>
        <view wx:if="{{!experienceTimeline.length && !reviewEditing}}" class="experience-empty"><view class="experience-empty-title">本期还没有私人记录</view><view>可以写下活动后感受，也可以直接返回。</view></view>
      </view>
      <view wx:if="{{canWriteReview && reviewEditing && !state.backend}}" class="experience-editor" id="experience-editor">
        <view class="experience-editor-heading"><view>活动后感受 <text class="experience-optional">选填</text></view><button class="experience-text-action experience-close" disabled="{{feelingSaving}}" bindtap="closeReview">收起</button></view>
        <view class="experience-field-note">仅自己可见，不是医疗结论。保存会更新本次活动后感受。</view>
        <textarea id="experience-note" class="experience-textarea" aria-label="活动后感受（选填）" maxlength="1000" value="{{reviewNote}}" placeholder="写下自己的感受（选填）" bindinput="onReviewInput" adjust-position="true" cursor-spacing="24" />
        <view class="experience-editor-bottom"><view class="experience-editor-status"><view>{{reviewNote.length}}/1000</view><view wx:if="{{reviewError}}" class="experience-error" role="alert">{{reviewError}}</view><view wx:if="{{reviewDirty}}">有修改未保存</view></view><button class="experience-save" loading="{{feelingSaving}}" disabled="{{feelingSaving}}" bindtap="saveReview">{{feelingSaving ? '正在保存' : '保存感受'}}</button></view>
      </view>
      <button wx:elif="{{canWriteReview && !reviewHasAfter}}" class="experience-write" bindtap="editReview"><text>写活动后感受</text><text aria-hidden="true">＋</text></button>
      <view wx:if="{{reviewDirty && !reviewEditing}}" class="experience-draft-note">有修改未保存</view>
    </block>
    <view wx:else class="experience-empty"><view class="experience-empty-title">本次体验尚未开始回顾</view><view>回顾按本人参与情况和活动阶段开放。</view></view>
    <view wx:if="{{state.backend && ((canWriteReview && (registration.status === 'confirmed' || registration.status === 'completed')) || (canReview && state.invitationEligible === true && !state.profile.minor))}}" class="experience-services">
      <button wx:if="{{hasSelfActiveRegistration && canWriteReview && (registration.status === 'confirmed' || registration.status === 'completed')}}" class="experience-service" disabled="{{!reflectionAccess.allowed || reflectionOpening}}" bindtap="openReflection"><view><view>轻友心声</view><view class="experience-service-note">{{reflectionAccess.allowed ? '可公开发表或仅自己保存。' : reflectionAccess.reason}}</view></view><text aria-hidden="true">›</text></button>
      <button wx:if="{{reflectionAccess.retry}}" class="text-button" bindtap="refresh">重试</button>
      <button wx:if="{{canReview && state.invitationEligible === true && !state.profile.minor}}" class="experience-service" bindtap="openInvite"><text>邀请朋友了解下一期</text><text aria-hidden="true">›</text></button>
    </view>
    <view class="experience-family-note">替家人报名不包含对方的私人感受。</view>
    <button class="experience-return" bindtap="backToCamp">返回清体营</button>
  </block>
  </block>
</view>

<view wx:if="{{view === 'register' && !loading && !loadError}}" class="registration-actionbar">
  <view wx:if="{{step === 1}}" class="registration-action-context">已选 {{selectedCount}} 人</view>
  <button wx:if="{{step > 1}}" class="secondary" disabled="{{submitting}}" bindtap="previousStep">返回修改</button>
  <button wx:if="{{step < 2}}" class="primary" bindtap="nextStep">下一步：核对报名</button>
  <button wx:else class="primary" loading="{{submitting}}" disabled="{{submitting || !draft.serviceConsent}}" bindtap="submitRegistration">{{submitting ? '正在提交' : '提交报名'}}</button>
</view>
