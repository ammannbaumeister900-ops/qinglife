/* Private reading, scoped to this view; navigation remains ql-nav-space. */
.camp-flow-page.flow-experience { --ql-bg: #f7f6ef; --ql-ink: #252b21; --ql-ink-light: #606b58; --ql-nav-bg: #f7f6ef; min-height: calc(100vh - 88px); padding: 28px 26px calc(28px + env(safe-area-inset-bottom)); color: #252b21; }
.flow-experience .experience-heading { padding-bottom: 26px; margin: 0; }
.experience-period { color: #596a50; font-size: 13px; line-height: 1.7; letter-spacing: 1px; }
.experience-title { margin: 8px 0 15px; font-family: var(--ql-serif); font-size: 30px; font-weight: 400; line-height: 1.5; }
.experience-name { font-size: 16px; font-weight: 500; line-height: 1.65; overflow-wrap: anywhere; }
.experience-date { margin-top: 5px; color: #606b58; font-size: 14px; line-height: 1.7; }
.experience-privacy { margin-top: 18px; color: #606b58; font-size: 13px; line-height: 1.8; }
.experience-records-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 18px 0 4px; border-top: 1px solid #c5cdba; font-size: 15px; line-height: 1.8; }
.experience-count { color: #606b58; font-size: 13px; }
.flow-experience .experience-records { margin: 0; padding: 0; border: 0; }
.experience-record { padding: 28px 0 29px; border-bottom: 1px solid #d6dacd; }
.experience-record:last-child { border-bottom: 0; }
.experience-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 14px; color: #606b58; font-size: 13px; line-height: 1.8; overflow-wrap: anywhere; }
.experience-phase { color: #435e3c; font-weight: 500; }
.experience-note { font-size: 17px; line-height: 1.95; letter-spacing: .015em; white-space: pre-wrap; overflow-wrap: anywhere; }
.experience-note.is-clamped { display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
.experience-scores { margin-top: 13px; color: #606b58; font-size: 13px; line-height: 1.8; }
.experience-empty-note { color: #606b58; font-size: 14px; line-height: 1.8; }
.experience-record-actions { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 8px; }
.flow-experience button { min-height: 44px; box-sizing: border-box; margin: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; white-space: normal; }
.flow-experience .experience-text-action { padding: 8px 0; color: #435e3c; font-size: 14px; line-height: 1.8; text-align: left; }
.flow-experience button[disabled] { opacity: .6; }
.experience-voices { margin-top: 18px; }
.experience-empty { padding: 26px 0 30px; color: #606b58; font-size: 14px; line-height: 1.8; }
.experience-empty-title { margin-bottom: 8px; color: #252b21; font-size: 18px; font-weight: 400; line-height: 1.7; }
.experience-services { margin-top: 28px; padding-top: 10px; border-top: 1px solid #c5cdba; }
.flow-experience .experience-service { display: flex; justify-content: space-between; align-items: center; gap: 18px; width: 100%; min-height: 54px; padding: 13px 0; color: #435e3c; font-size: 14px; line-height: 1.8; text-align: left; }
.experience-service-note { margin-top: 2px; color: #606b58; font-size: 13px; line-height: 1.7; }
.experience-family-note, .experience-draft-note { margin-top: 16px; color: #606b58; font-size: 13px; line-height: 1.8; }
.flow-experience .experience-return { display: block; margin-top: 18px; padding: 9px 0; color: #606b58; font-size: 14px; text-align: left; }
@media (max-width: 350px) {
  .camp-flow-page.flow-experience { padding-right: 22px; padding-left: 22px; }
  .experience-meta { flex-wrap: wrap; gap: 3px 12px; }
}
