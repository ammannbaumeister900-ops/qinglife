.button-row { margin-top: 32rpx; }
.camp-flow-page .progress { padding: 0 4rpx; }

.camp-flow-page.immersive-page {
  padding: 0 0 calc(190rpx + env(safe-area-inset-bottom));
  background: var(--ql-bg);
  animation: none;
}

.camp-cover {
  position: relative;
  height: 660rpx;
  overflow: hidden;
  border-radius: 0 0 56rpx 56rpx;
  background: linear-gradient(155deg, #E8DFCF, #D5CCBA 62%, #BCC8B5);
}
.camp-cover-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.camp-cover-image ~ .cover-light,
.camp-cover-image ~ .cover-vessel,
.camp-cover-image ~ .cover-leaf { display: none; }
.camp-cover-image ~ .cover-label { padding: 10rpx 18rpx; border-radius: 999rpx; background: rgba(246, 241, 232, 0.86); }
.cover-light { position: absolute; border-radius: 50%; filter: blur(46rpx); }
.cover-light-one { top: -130rpx; right: -80rpx; width: 560rpx; height: 450rpx; background: rgba(255, 246, 222, 0.9); }
.cover-light-two { bottom: -180rpx; left: -120rpx; width: 480rpx; height: 380rpx; background: rgba(166, 182, 162, 0.5); }
.cover-vessel {
  position: absolute;
  right: 196rpx;
  bottom: 78rpx;
  width: 190rpx;
  height: 138rpx;
  border-radius: 24rpx 24rpx 86rpx 86rpx;
  background: linear-gradient(180deg, #C5AB94, #927763);
  box-shadow: 0 34rpx 60rpx rgba(70, 52, 36, 0.2);
  transform: rotate(-2deg);
}
.cover-vessel::before { content: ''; position: absolute; top: -16rpx; right: 10rpx; left: 10rpx; height: 30rpx; border-radius: 50%; background: #D6C0A9; }
.cover-leaf { position: absolute; bottom: -34rpx; width: 118rpx; height: 330rpx; border-radius: 88% 12% 82% 18%; background: rgba(94, 119, 83, 0.38); }
.cover-leaf-one { right: 50rpx; transform: rotate(25deg); }
.cover-leaf-two { right: 132rpx; bottom: -100rpx; background: rgba(112, 136, 102, 0.25); transform: rotate(-17deg); }
.cover-label { position: absolute; left: 48rpx; bottom: 54rpx; color: rgba(38, 35, 31, 0.76); font-size: 22rpx; letter-spacing: 5rpx; }
.cover-note { position: absolute; top: 230rpx; left: 48rpx; color: rgba(38, 35, 31, 0.55); font-size: 23rpx; }
.cover-seal { position: absolute; right: 48rpx; bottom: 52rpx; width: 108rpx; height: 108rpx; flex-direction: column; }
.cover-seal-number { font-size: 34rpx; line-height: 1; }
.cover-seal-caption { margin-top: 6rpx; font-size: 22rpx; letter-spacing: 4rpx; }

.detail-content { padding: 48rpx; }
.detail-title-block { margin-bottom: 42rpx; }
.detail-title { margin-top: 22rpx; font-family: var(--ql-serif); font-size: 70rpx; font-weight: 400; line-height: 1.45; }
.detail-intro { margin-top: 20rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.75; }

.fact-card,
.rules-card,
.leader-detail-card {
  padding: 38rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: var(--ql-radius-card);
  background: var(--ql-surface);
  box-shadow: var(--ql-shadow-card);
}
.fact-row { display: flex; align-items: baseline; justify-content: space-between; gap: 32rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--ql-border); }
.fact-row:last-child { border-bottom: none; }
.fact-label { flex-shrink: 0; color: var(--ql-ink-ghost); font-size: 22rpx; letter-spacing: 6rpx; }
.fact-value { color: var(--ql-ink); font-size: 27rpx; text-align: right; }
.fact-price { font-family: var(--ql-serif); font-size: 46rpx; }
.fact-price text { margin-left: 6rpx; color: var(--ql-ink-ghost); font-family: sans-serif; font-size: 22rpx; }

.detail-section-title { margin: 58rpx 0 28rpx; font-family: var(--ql-serif); font-size: 36rpx; font-weight: 500; }
.rhythm-row { display: flex; gap: 30rpx; min-height: 136rpx; }
.rhythm-axis { position: relative; display: flex; width: 58rpx; flex-shrink: 0; justify-content: center; color: var(--ql-clay-deep); font-family: var(--ql-serif); font-size: 28rpx; }
.rhythm-line { position: absolute; top: 46rpx; bottom: 4rpx; left: 28rpx; width: 2rpx; background: var(--ql-clay-soft); }
.rhythm-copy { flex: 1; padding-bottom: 32rpx; }
.rhythm-title,
.rhythm-meta { display: block; }
.rhythm-title { font-size: 30rpx; font-weight: 600; }
.rhythm-meta { margin-top: 10rpx; color: var(--ql-ink-light); font-size: 24rpx; }

.fit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 12rpx; }
.fit-card { padding: 34rpx 30rpx; border-radius: 36rpx; }
.fit-sage { background: var(--ql-tint-sage); }
.fit-mist { background: var(--ql-tint-mist); }
.fit-title { margin-bottom: 18rpx; font-family: var(--ql-serif); font-size: 29rpx; }
.fit-item { position: relative; margin-top: 14rpx; padding-left: 22rpx; color: var(--ql-ink-light); font-size: 23rpx; line-height: 1.6; }
.fit-item::before { content: '·'; position: absolute; left: 0; color: var(--ql-clay-deep); }

.leader-detail-card { display: flex; align-items: flex-start; gap: 28rpx; margin-top: 42rpx; }
.leader-detail-mark { display: flex; width: 76rpx; height: 76rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 50%; background: var(--ql-clay); color: var(--ql-surface); font-family: var(--ql-serif); font-size: 30rpx; }
.leader-detail-name { margin: 12rpx 0 8rpx; font-family: var(--ql-serif); font-size: 34rpx; }
.rule-row { padding: 28rpx 0; border-bottom: 1rpx solid var(--ql-border); }
.rule-row:last-child { border-bottom: none; }
.rule-title,
.rule-copy { display: block; }
.rule-title { font-size: 27rpx; font-weight: 600; }
.rule-copy { margin-top: 10rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.7; }

.detail-actionbar {
  position: fixed;
  z-index: 70;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--ql-border);
  background: rgba(246, 241, 232, 0.94);
}
.action-price { font-family: var(--ql-serif); font-size: 48rpx; }
.action-price text { margin-left: 4rpx; color: var(--ql-ink-ghost); font-family: sans-serif; font-size: 22rpx; }
.action-status { margin-top: 4rpx; color: var(--ql-clay-deep); font-size: 22rpx; letter-spacing: 2rpx; }
.action-primary {
  flex: none;
  width: auto;
  min-height: 100rpx;
  margin: 0;
  padding: 0 68rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  line-height: 1.45;
}

.day-check-button { min-height: 88rpx; margin-top: 20rpx; font-size: 26rpx; line-height: 1.45; }
.day-checked { margin-top: 20rpx; color: var(--ql-sage-deep); font-size: 24rpx; font-weight: 500; letter-spacing: 2rpx; }

.camp-cover.has-session-cover { height: 375rpx; }
.camp-cover.has-session-cover .cover-label { left: 24rpx; bottom: 18rpx; max-width: 670rpx; font-size: 20rpx; letter-spacing: 1rpx; }
.journey-reflection { padding: 30rpx; margin: 28rpx 0; border-radius: 24rpx; background: linear-gradient(130deg,#EAF0E2,#F6EFE1); border: 1rpx solid #DCE1D2; }
.journey-reflection-title { font-family: var(--ql-serif); color: #4C5F42; font-size: 31rpx; margin-bottom: 14rpx; }

.camp-flow-page.registration-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.registration-heading { margin-bottom: 28rpx; }
.registration-page .hero { margin-bottom: 24rpx; }
.registration-page .hero-title { font-size: 36rpx; }
.registration-page .hero-copy { font-size: 24rpx; }
.registration-actionbar { position: fixed; z-index: 70; right: 0; bottom: 0; left: 0; display: flex; gap: 20rpx; box-sizing: border-box; padding: 20rpx 48rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #E2DBCF; background: #F6F1E8; }
.registration-actionbar button { flex: 1; min-width: 0; margin: 0; height: 100rpx; }
.confirmation-title { margin: 32rpx 4rpx 24rpx; font-family: var(--ql-serif); font-size: 36rpx; }
.confirmation-card { background: #FCFAF5; }
.summary-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.summary-label { color: var(--ql-ink-ghost); font-size: 23rpx; }
.summary-count { color: #53624A; font-size: 26rpx; }
.summary-people { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 22rpx 0 28rpx; }
.summary-person { padding: 12rpx 20rpx; border-radius: 16rpx; background: #EDF0E6; font-size: 28rpx; overflow-wrap: anywhere; max-width: 100%; box-sizing: border-box; }
.summary-contact { padding: 24rpx 0; border-top: 1rpx solid var(--ql-border); font-size: 25rpx; line-height: 1.8; overflow-wrap: anywhere; }
.summary-contact .summary-label { margin-bottom: 6rpx; }
.summary-price { color: var(--ql-ink-ghost); font-size: 22rpx; line-height: 1.8; }
.summary-consent { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--ql-border); }
.service-heading { padding: 8rpx 4rpx 28rpx; }
.service-title { margin-top: 22rpx; font-family: var(--ql-serif); font-size: 42rpx; line-height: 1.6; }
.service-status-card { background: #FCFAF5; }
.service-status-row { padding: 6rpx 0 28rpx; }
.service-status-row + .service-status-row { padding-top: 28rpx; border-top: 1rpx solid var(--ql-border); }
.service-status-row:last-child { padding-bottom: 6rpx; }
.service-status-value { margin-top: 12rpx; color: #53624A; font-family: var(--ql-serif); font-size: 36rpx; }
.service-status-note { margin-top: 12rpx; color: var(--ql-ink-light); font-size: 23rpx; line-height: 1.8; }
.service-back { margin-top: 12rpx; }
