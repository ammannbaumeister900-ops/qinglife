@import "./detail.wxss";
/* Task roles share typography and controls, not a decorative container. */
.camp-flow-page { padding: 28rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--ql-bg); }
.camp-flow-page::before { display: none; }
.camp-flow-page .card-title { margin: 0 0 12rpx; font-size: 32rpx; line-height: 1.5; }
.camp-flow-page .card-copy, .task-copy { color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.7; overflow-wrap: break-word; }
.task-title { font-size: 38rpx; font-weight: 500; line-height: 1.5; }
.camp-flow-page .privacy-note { margin-top: 20rpx; padding: 0; border: none; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.7; }
.camp-flow-page .empty, .camp-flow-page .empty-state { padding: 48rpx 0; border: none; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; }
.camp-flow-page .empty-title { font-family: inherit; font-size: 32rpx; }
.camp-flow-page .empty-copy { font-size: 28rpx; }
.camp-flow-page .primary, .camp-flow-page .secondary, .camp-flow-page .text-button,
.registration-actionbar button, .camp-flow-page .empty-action { min-height: 44px; padding: 18rpx 24rpx; border-radius: 10rpx; font-size: 28rpx; line-height: 1.5; }
.camp-flow-page .primary, .registration-actionbar .primary { min-height: 48px; }
.camp-flow-page .primary, .camp-flow-page .secondary, .camp-flow-page .text-button { width: 100%; }
.camp-flow-page .secondary { background: transparent; }
.camp-flow-page .text-button { padding-right: 0; padding-left: 0; color: var(--ql-ink-light); }
.camp-flow-page button[disabled], .registration-actionbar button[disabled] { background: var(--ql-bg-deep); color: var(--ql-ink-light); }
.camp-flow-page .form-error { margin: 12rpx 0; color: #9A4F30; font-size: 28rpx; line-height: 1.6; }

.registration-actionbar { position: fixed; z-index: 70; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; padding: 20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--ql-border); background: var(--ql-bg); }

/* Registration: continuous groups and restrained input affordances. */
.camp-flow-page.registration-page { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.registration-step { color: var(--ql-ink-light); font-size: 28rpx; margin-bottom: 8rpx; }
.registration-heading .card-title { font-size: 34rpx; font-weight: 500; }
.camp-flow-page .progress { margin: 24rpx 0 28rpx; padding: 0; }
.camp-flow-page .progress-item { height: 4rpx; border-radius: 0; }
.step-heading { margin-bottom: 20rpx; }
.step-heading .task-title { font-size: 34rpx; }
.task-copy { margin-top: 10rpx; }
.participant-group { margin-bottom: 28rpx; }
.camp-flow-page .check-row { min-height: 44px; padding: 20rpx 0; align-items: flex-start; }
.camp-flow-page .check-row checkbox { flex: none; margin-top: 2rpx; }
.camp-flow-page .list-title, .camp-flow-page .list-note { font-size: 28rpx; overflow-wrap: break-word; }
.camp-flow-page .list-title { font-weight: 500; }
.form-section { padding-top: 28rpx; margin-top: 28rpx; border-top: 1rpx solid var(--ql-border); }
.camp-flow-page .field { margin-top: 24rpx; }
.camp-flow-page .label { font-size: 28rpx; margin-bottom: 8rpx; }
.camp-flow-page .input { min-height: 44px; height: 88rpx; padding: 10rpx 0; border: none; border-bottom: 1rpx solid rgba(74,61,49,.32); border-radius: 0; background: transparent; font-size: 30rpx; }
.add-person-section { padding-bottom: 24rpx; }
.registration-actionbar button { flex: 1; min-width: 0; margin: 0; }
.registration-actionbar .secondary { flex: .6; background: transparent; }
.confirmation-title { margin: 28rpx 0 20rpx; font-size: 34rpx; font-weight: 500; }
.confirmation-card { padding: 24rpx 0; border-top: 1rpx solid var(--ql-border); }
.summary-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.summary-label { color: var(--ql-ink-light); font-size: 28rpx; }
.summary-count { font-size: 28rpx; }
.summary-people { margin: 12rpx 0 24rpx; }
.summary-person { display: block; padding: 6rpx 0; font-size: 30rpx; overflow-wrap: break-word; }
.summary-contact { padding: 20rpx 0; border-top: 1rpx solid var(--ql-border); font-size: 30rpx; line-height: 1.7; overflow-wrap: anywhere; }
.summary-contact .summary-label { margin-bottom: 6rpx; }
.summary-price { color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.8; }
.summary-consent { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--ql-border); }

/* Result and service: outcome and independent business states. */
.registration-result { padding: 24rpx 0; }
.result-title { margin-bottom: 16rpx; font-size: 38rpx; font-weight: 500; line-height: 1.5; }
.service-heading { padding-bottom: 24rpx; }
.service-session { color: var(--ql-ink-light); font-size: 28rpx; }
.service-title { margin: 10rpx 0 12rpx; font-size: 36rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.service-status-card { border-top: 1rpx solid var(--ql-border); border-bottom: 1rpx solid var(--ql-border); }
.service-status-row { padding: 24rpx 0; }
.service-status-row + .service-status-row { border-top: 1rpx solid var(--ql-border); }
.service-status-value { margin-top: 8rpx; color: #53624A; font-size: 34rpx; font-weight: 600; line-height: 1.5; }
.service-status-note { margin-top: 8rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.7; }
.journey-reflection { margin: 32rpx 0; }
.journey-reflection-title { margin-bottom: 12rpx; font-size: 32rpx; font-weight: 500; line-height: 1.5; }
.service-back { margin-top: 16rpx; }
.camp-flow-page .journey-reflection .secondary { width: auto; margin-right: 0; margin-left: 0; padding-right: 0; padding-left: 0; border: none; justify-content: flex-start; }

/* Writing, selecting an invitation, and rereading are different tasks. */
.writing-heading { margin-bottom: 28rpx; }
.camp-flow-page .textarea { display: block; min-height: 240rpx; height: 300rpx; padding: 20rpx 24rpx; border: 1rpx solid rgba(74,61,49,.24); border-radius: 6rpx; background: var(--ql-surface); font-size: 30rpx; line-height: 1.7; }
.saved-note { margin-top: 16rpx; color: #53624A; font-size: 28rpx; line-height: 1.7; }
.invite-heading { margin-bottom: 28rpx; }
.camp-flow-page button.invitation-row { display: flex; align-items: center; gap: 20rpx; width: 100%; min-height: 44px; margin: 0; padding: 24rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--ql-border); background: transparent; color: var(--ql-ink); text-align: left; line-height: 1.5; white-space: normal; }
.invitation-copy { flex: 1; min-width: 0; }
.invitation-session, .invitation-date, .invitation-action { color: var(--ql-ink-light); font-size: 28rpx; }
.invitation-name { margin: 8rpx 0; font-size: 32rpx; font-weight: 500; overflow-wrap: break-word; }
.invitation-action { flex: none; }
.experience-heading { margin-bottom: 28rpx; }
.experience-review { margin-bottom: 32rpx; }
.experience-records { margin: 32rpx 0; padding-top: 28rpx; border-top: 1rpx solid var(--ql-border); }
.record-row { padding: 20rpx 0; }
.record-row + .record-row { border-top: 1rpx solid var(--ql-border); }
.camp-flow-page button:active { opacity: .8; transform: none; }
@media (max-width: 350px) {
  .camp-flow-page, .camp-flow-page .card-copy, .task-copy, .camp-flow-page .privacy-note,
  .camp-flow-page .empty, .camp-flow-page .empty-state, .camp-flow-page .empty-copy,
  .camp-flow-page .primary, .camp-flow-page .secondary, .camp-flow-page .text-button, .registration-actionbar button,
  .camp-flow-page .empty-action, .camp-flow-page .form-error, .detail-status, .detail-theme, .fact-row,
  .price-currency, .price-unit, .price-caption, .price-note, .rhythm-meta, .fit-item,
  .leader-detail-label, .rule-title, .rule-copy, .action-status, .registration-step,
  .camp-flow-page .list-title, .camp-flow-page .list-note, .camp-flow-page .label,
  .summary-label, .summary-count, .summary-price, .service-session, .service-status-note,
  .saved-note, .invitation-session, .invitation-date, .invitation-action, .invitation-name,
  .camp-flow-page .input, .camp-flow-page .textarea, .detail-intro, .rhythm-axis, .rhythm-title,
  .fit-title, .leader-detail-name, .summary-person, .summary-contact { font-size: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  .camp-flow-page button, .registration-actionbar button { transition: none; }
}

@import "./register.wxss";

@import "./experience.wxss";

@import "./journey.wxss";

/* Feeling is a private field, separate from the frozen experience reading view. */
.flow-feeling .writing-heading { margin: 8rpx 0 28rpx; }
.flow-feeling .task-title { font-family: var(--ql-serif); font-size: 42rpx; }
.flow-feeling .task-copy { font-size: 26rpx; }
.flow-feeling .textarea { height: 360rpx; padding: 24rpx; border-radius: 8rpx; font-size: 32rpx; }
.flow-feeling .privacy-note { font-size: 26rpx; }
@media (max-width: 350px) { .flow-feeling .textarea { font-size: 16px; } }

.flow-invite .task-title { font-size: 38rpx; font-weight: 600; }
.flow-invite .task-copy { font-size: 26rpx; }
.camp-flow-page.flow-invite button.invitation-row { align-items: flex-start; }
.flow-invite .invitation-action { display: flex; align-items: center; min-height: 44px; color: var(--ql-clay-deep); }
.flow-invite .invitation-name { font-size: 32rpx; }
.flow-invite .prepared-invitation { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--ql-border); }
.flow-invite .prepared-invitation-name { font-size: 28rpx; line-height: 1.7; overflow-wrap: anywhere; }
