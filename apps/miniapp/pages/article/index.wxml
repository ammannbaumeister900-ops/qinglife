<launch-splash />
<ql-nav-space back immersive />
<view class="article-page">
  <soft-loading wx:if="{{loading}}" text="正在读取文章…" />
  <view wx:elif="{{!article.id}}" class="article-empty empty-state"><view class="empty-title">这篇内容暂时看不到</view><view class="empty-copy">它可能正在更新，可以稍后再来。</view><button class="empty-action" bindtap="loadArticle">重试</button></view>
  <block wx:else>
    <view class="article-cover">
      <view class="article-light article-light-one"></view>
      <view class="article-light article-light-two"></view>
      <view class="article-cup"></view>
    </view>
    <view class="article-sheet">
      <view class="article-heading">
        <view class="eyebrow">{{article.category}}</view>
        <view class="article-title">{{article.title}}</view>
        <view class="article-meta"><text>{{article.author}}</text><text>{{article.date}}</text></view>
        <view wx:if="{{source === 'demo'}}" class="demo-note">演示内容 · 用于预览阅读效果，非真实轻友投稿。</view>
      </view>
      <view class="article-body"><rich-text nodes="{{article.content || article.summary}}"></rich-text></view>
      <view class="article-divider"><text></text><text></text><text></text></view>
      <view class="health-note">健康相关内容仅用于日常生活方式参考；明显、持续或突然出现的不适，应停止练习并寻求专业评估。</view>
    </view>
    <view class="article-actionbar">
      <button class="collect-button {{collected ? 'collected' : ''}}" bindtap="toggleCollect"><image class="bookmark-icon" src="/assets/icons/bookmark{{collected ? '-active' : ''}}.svg" mode="aspectFit" />{{collected ? '已收藏' : '收藏'}}</button>
      <button class="share-button" open-type="share">分享这篇内容</button>
    </view>
  </block>
</view>
