/* 文章详情 · 「林下午后」P8（docs/design/redesign-2026q4/p8-reading-rhythm.md）。只引用 --q-* 令牌。
 * 故事文章是已确认样板：版式冻结，本次只换令牌并把小字提到 14px 底线；方法文章收敛到同一套阅读语法。 */
page { background: var(--q-linen); }
.article-page { min-height: calc(100vh - 88px); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); background: var(--q-linen); color: var(--q-ink); }

.article-empty { margin: 60px 24px 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
.article-page .empty-title { color: var(--q-ink); font-size: 18px; }
.article-page .empty-copy { color: var(--q-ink-2); font-size: 15px; }
.article-page .empty-action { min-height: 44px; border: 0; border-radius: 0; background: transparent; color: var(--q-moss); font-size: 15px; line-height: 44px; }

.article-title { font-family: var(--ql-serif); font-weight: 400; overflow-wrap: break-word; }
.article-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; color: var(--q-ink-2); font-size: 14px; line-height: 1.75; overflow-wrap: break-word; }
.article-meta text { min-width: 0; max-width: 100%; }
.article-category { color: var(--q-moss); }
.demo-note { margin-top: 12px; color: var(--q-ink-2); font-size: 14px; line-height: 1.7; }
.article-body { color: var(--q-ink); overflow-wrap: break-word; }
.content-warning { margin: 24px 0; color: var(--q-ink-2); font-size: 14px; line-height: 1.8; }

/* 故事文章（冻结样板）：标题、封面与正文位置不变 */
.article-story .article-sheet { padding: 0 0 24px; }
.article-story .article-heading { margin: 0; padding: 27px 28px 36px; }
.story-category { color: var(--q-moss); font-size: 14px; letter-spacing: 2px; line-height: 1.6; }
.article-story .article-title { margin-top: 19px; font-size: 39px; line-height: 1.4; letter-spacing: .025em; white-space: normal; word-break: break-word; text-wrap: balance; }
.article-story .article-meta { margin-top: 20px; }
.story-photograph { display: block; width: 100%; height: auto; margin-bottom: 35px; }
.article-story .article-body { padding: 0 28px; font-size: 17px; line-height: 1.95; letter-spacing: .015em; }
.article-story .content-warning { margin-right: 28px; margin-left: 28px; }
@media (max-width: 360px) { .article-story .article-title { font-size: 34px; } }

/* 方法文章：同一套阅读语法，更安静 */
.article-method .article-sheet { padding: 20px var(--q-gutter) 32px; }
.article-method .article-heading { margin-bottom: 26px; padding-bottom: 22px; border-bottom: 1px solid var(--q-line); }
.article-method .article-meta { margin-top: 14px; }
.article-method .article-title { font-size: 26px; line-height: 1.45; }
.article-method .article-body { font-size: 16px; line-height: 1.95; }
.health-note { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--q-line); color: var(--q-ink-2); font-size: 14px; line-height: 1.8; }
@media (max-width: 350px) { .article-method .article-sheet { padding-right: 20px; padding-left: 20px; } .article-method .article-title { font-size: 23px; } }

/* 底栏：收藏是文字按钮，分享是次按钮。选择器带 button 与父级，压过微信 button 默认的 184px 宽度。 */
.article-actionbar { position: fixed; z-index: 70; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px var(--q-gutter) calc(14px + env(safe-area-inset-bottom)); border-top: 1px solid var(--q-line); background: var(--q-linen); }
.article-actionbar button.collect-button, .article-actionbar button.share-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: auto; height: 44px; min-height: 44px; margin: 0; font-size: 14px; font-weight: 500; line-height: 1.5; }
.article-actionbar button.collect-button { padding: 0 4px; border: 0; background: transparent; color: var(--q-ink-2); }
.article-actionbar button.collect-button.collected { color: var(--q-moss); }
.bookmark-icon { width: 17px; height: 20px; margin-right: 9px; }
.article-actionbar button.share-button { padding: 0 20px; border: 1px solid var(--q-ink); border-radius: 0; background: transparent; color: var(--q-ink); }
.collect-button:active, .share-button:active { opacity: .72; }

/* 原生视频：只在文章阅读内使用 */
.article-video-block { margin: 25px 0; }
.article-video { display: block; width: 100%; height: 184px; background: var(--q-forest); }
.article-video-error { padding: 24px 16px; background: var(--q-field); color: var(--q-ink-2); font-size: 15px; line-height: 1.8; }
.article-video-retry { width: auto; min-height: 44px; margin: 16px 0 0; padding: 8px 14px; border: 1px solid var(--q-line); border-radius: 0; background: transparent; color: var(--q-moss); font-size: 15px; line-height: 1.8; }
@media (max-width: 350px) { .article-video { height: 158px; } }
