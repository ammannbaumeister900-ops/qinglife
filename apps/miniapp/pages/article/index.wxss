.article-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: var(--ql-bg);
}

.article-empty {
  margin: 120rpx 48rpx 0;
  border: none;
  border-radius: 0;
  background: transparent;
}

.article-sheet { padding: 40rpx 48rpx 24rpx; }
.article-heading { margin-bottom: 44rpx; }

.article-title {
  font-family: var(--ql-serif);
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 24rpx;
  margin-top: 24rpx;
  color: var(--ql-ink-light);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: break-word;
}

.article-meta text { min-width: 0; max-width: 100%; }
.article-category { color: var(--ql-clay-deep); }

.demo-note {
  margin-top: 16rpx;
  color: var(--ql-ink-light);
  font-size: 24rpx;
  line-height: 1.65;
}

.article-body {
  color: var(--ql-ink);
  font-size: 32rpx;
  line-height: 1.9;
  overflow-wrap: break-word;
}

.health-note {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ql-border);
  color: var(--ql-ink-light);
  font-size: 24rpx;
  line-height: 1.75;
}

.article-actionbar {
  position: fixed;
  z-index: 70;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--ql-border);
  background: var(--ql-bg);
}

.collect-button,
.share-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto;
  height: 88rpx;
  min-height: 44px;
  margin: 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.collect-button {
  padding: 0 12rpx;
  border: none;
  background: transparent;
  color: var(--ql-ink-light);
}

.collect-button.collected { color: var(--ql-clay-deep); }
.bookmark-icon { width: 36rpx; height: 36rpx; margin-right: 12rpx; }

.share-button {
  padding: 0 32rpx;
  border: 1rpx solid var(--ql-border);
  border-radius: 20rpx;
  background: transparent;
  color: var(--ql-ink);
}
