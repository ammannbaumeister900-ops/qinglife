.article-page {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 90% 36%, rgba(200, 189, 201, 0.22), transparent 32%),
    linear-gradient(rgba(246,241,232,.96), rgba(246,241,232,.96)),
    url("data:image/png;base64,"),
    var(--ql-bg);
}
.article-empty { margin: 220rpx 48rpx 0; }
.article-cover { position: relative; height: 528rpx; overflow: hidden; border-radius: 0 0 56rpx 56rpx; background: linear-gradient(160deg, #E7DECD, #D8CDBB 62%, #C7C0B1); }
.article-light { position: absolute; border-radius: 50%; filter: blur(44rpx); }
.article-light-one { top: -120rpx; right: -80rpx; width: 520rpx; height: 400rpx; background: rgba(255, 246, 222, 0.9); }
.article-light-two { bottom: -140rpx; left: -90rpx; width: 420rpx; height: 330rpx; background: rgba(166, 182, 162, 0.42); }
.article-cup { position: absolute; left: 50%; bottom: 70rpx; width: 188rpx; height: 114rpx; border-radius: 20rpx 20rpx 90rpx 90rpx; background: linear-gradient(180deg, #C6AF99, #947A66); box-shadow: 0 30rpx 50rpx rgba(70, 52, 36, 0.2); transform: translateX(-50%); }
.article-cup::before { content: ''; position: absolute; top: -14rpx; right: 9rpx; left: 9rpx; height: 28rpx; border-radius: 50%; background: #D9C6B2; }
.article-sheet { padding: 52rpx 48rpx 20rpx; }
.article-heading { margin-bottom: 48rpx; }
.article-title { margin-top: 22rpx; font-family: var(--ql-serif); font-size: 54rpx; font-weight: 400; line-height: 1.5; }
.article-meta { display: flex; justify-content: space-between; margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid var(--ql-border); color: var(--ql-ink-ghost); font-size: 22rpx; letter-spacing: 2rpx; }
.demo-note { margin-top: 16rpx; color: var(--ql-ink-ghost); font-size: 22rpx; }
.article-body { color: var(--ql-ink); font-size: 30rpx; line-height: 1.95; }
.article-divider { display: flex; justify-content: center; gap: 16rpx; margin: 54rpx 0; }
.article-divider text { width: 6rpx; height: 6rpx; border-radius: 50%; background: var(--ql-ink-ghost); opacity: 0.5; }
.health-note { padding: 28rpx 32rpx; border-radius: 32rpx; background: rgba(200, 189, 201, 0.2); color: var(--ql-ink-light); font-size: 23rpx; line-height: 1.75; }
.article-actionbar { position: fixed; z-index: 70; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; padding: 24rpx 48rpx calc(32rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--ql-border); background: rgba(246, 241, 232, 0.94); }
.collect-button,
.share-button { width: auto; min-height: 84rpx; margin: 0; font-size: 26rpx; letter-spacing: 2rpx; line-height: 84rpx; }
.collect-button { display: flex; align-items: center; padding: 0 12rpx; border: none; background: transparent; color: var(--ql-ink-light); }
.collect-button.collected { color: var(--ql-clay-deep); }
.bookmark-icon { width: 38rpx; height: 38rpx; margin-right: 12rpx; }
.share-button { padding: 0 44rpx; border: 1rpx solid var(--ql-border); border-radius: 28rpx; background: rgba(255, 252, 247, 0.86); color: var(--ql-ink); }
