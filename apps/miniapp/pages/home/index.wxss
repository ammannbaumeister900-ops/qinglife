@font-face { font-family: "Qinglife Opening"; src: url("data:font/ttf;base64,"); font-style: normal; font-weight: 400; }
page { --ql-bg:#f7f6ef; --ql-ink:#252b21; --ql-ink-light:#59614f; --home-green:#344b30; --home-line:#c2c8b9; background:var(--ql-bg); }
.home-page { padding:0 0 100px; padding-bottom:calc(100px + env(safe-area-inset-bottom)); background:var(--ql-bg); color:var(--ql-ink); font-size:calc(16px * var(--home-font-scale,1)); line-height:1.8; }
.home-page::before { display:none; }
.home-page button { box-sizing:border-box; min-width:0; min-height:44px; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font:inherit; text-align:left; white-space:normal; line-height:1.6; }
.home-page button::after,.home-voice-layer button::after { border:0; }
.home-page button:active { opacity:.75; }
.home-motion-probe { position:absolute; width:0; height:0; overflow:hidden; pointer-events:none; }
.welcome-opening { padding:8px 24px 20px; }
.welcome-title { font-size:calc(36px * var(--home-font-scale,1)); font-weight:500; line-height:1.3; letter-spacing:-1px; }
.welcome-title-serif { display:block; margin-left:42px; font-family:"Qinglife Opening",var(--ql-serif); font-weight:400; }
.welcome-copy { margin:12px 0 0 42px; font-size:calc(16px * var(--home-font-scale,1)); line-height:1.8; }
.home-hero { margin-right:22px; }
.home-hero-image { display:block; width:100%; height:220px; }
.home-photo-caption { margin:12px 0 0 24px; font-size:calc(14px * var(--home-font-scale,1)); color:var(--ql-ink-light); line-height:1.7; }
.home-page .refresh-note,.home-page .empty-state { position:static; margin:24px 24px 0; padding:0; border:0; border-radius:0; background:transparent; font-size:calc(16px * var(--home-font-scale,1)); color:var(--ql-ink-light); }
.home-page .text-button { min-height:44px; width:auto; color:var(--home-green); font-size:calc(14px * var(--home-font-scale,1)); }
.cancellation-notice { display:flex; align-items:center; gap:8px; margin:20px 24px 0; font-size:14px; }
.home-page .cancellation-link { display:flex; align-items:center; flex:1; gap:8px; min-width:0; overflow-wrap:break-word; }
.home-page .cancellation-close { width:44px; flex:none; font-size:22px; text-align:center; }
.home-task { display:flex; align-items:center; gap:12px; margin:24px 24px 0; padding:12px 14px; border-left:3px solid var(--home-green); background:#e8ecdf; }
.home-task-copy { flex:1; min-width:0; }
.home-task-title { font-size:calc(16px * var(--home-font-scale,1)); line-height:1.7; }
.home-task-context { font-size:calc(14px * var(--home-font-scale,1)); color:var(--ql-ink-light); }
.home-page .home-task-action { flex:none; max-width:42%; color:var(--home-green); font-size:calc(14px * var(--home-font-scale,1)); }
.home-camp { margin:28px 24px 0; }
.home-section-head { display:flex; justify-content:space-between; align-items:baseline; gap:12px; margin-bottom:16px; font-size:calc(20px * var(--home-font-scale,1)); line-height:1.5; }
.home-section-note { color:var(--ql-ink-light); font-size:calc(14px * var(--home-font-scale,1)); line-height:1.7; }
.home-camp-tabs { display:flex; gap:6px; margin-bottom:16px; }
.home-page .home-camp-tab { flex:1; min-height:46px; padding:8px 6px; border:1px solid var(--home-line); text-align:center; font-size:calc(14px * var(--home-font-scale,1)); line-height:1.5; overflow-wrap:break-word; }
.home-page .home-camp-tab.selected { background:var(--home-green); border-color:var(--home-green); color:#fff; }
.home-camp-entry { border-top:3px solid var(--home-green); border-bottom:1px solid var(--home-line); padding:20px 0 4px; }
.home-camp-meta { display:flex; justify-content:space-between; gap:12px; font-size:calc(14px * var(--home-font-scale,1)); }
.home-camp-title { flex:1; min-width:0; overflow-wrap:break-word; }
.home-camp-status { color:var(--ql-ink-light); }
.home-camp-date { margin:12px 0 18px; font-size:calc(24px * var(--home-font-scale,1)); line-height:1.5; font-weight:500; }
.home-camp-fact { display:flex; gap:12px; margin-top:8px; font-size:calc(14px * var(--home-font-scale,1)); line-height:1.8; }
.home-camp-fact > text:last-child { flex:1; min-width:0; overflow-wrap:break-word; }
.home-fact-label { width:40px; flex:none; color:var(--ql-ink-light); }
.home-page .home-link-row { display:flex; align-items:center; justify-content:space-between; gap:16px; width:100%; min-height:48px; color:var(--home-green); font-size:calc(16px * var(--home-font-scale,1)); }
.home-page .home-camp-detail { border-top:1px solid var(--home-line); margin-top:20px; padding:12px 0; }
.home-camp-empty { min-height:165px; padding-top:24px; }
.home-camp-empty .home-link-row { margin-top:14px; }
.home-voices { margin:44px 24px 0; }
.home-voices .home-section-head { margin-bottom:4px; }
.home-voices-intro { margin-bottom:18px; color:var(--ql-ink-light); font-size:calc(14px * var(--home-font-scale,1)); }
.home-voice-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); grid-auto-rows:1fr; gap:10px; }
.home-page .home-voice-card { display:flex; flex-direction:column; justify-content:space-between; min-height:194px; padding:14px 12px 12px; background:#edf0e6; border-top:1px solid #9ca88f; }
.home-page .home-voice-card:nth-child(2),.home-page .home-voice-card:nth-child(3) { background:#f0eee4; border-color:#b9b3a1; }
.home-voice-text { font-size:calc(16px * var(--home-font-scale,1)); line-height:1.75; overflow-wrap:break-word; }
.home-voice-meta { display:flex; justify-content:space-between; align-items:center; gap:5px; margin-top:10px; color:var(--ql-ink-light); font-size:calc(14px * var(--home-font-scale,1)); line-height:1.6; }
.home-voice-controls { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-top:8px; color:var(--ql-ink-light); font-size:calc(14px * var(--home-font-scale,1)); }
.home-page .home-voice-controls button { min-width:70px; min-height:44px; padding:5px 0; color:var(--home-green); font-size:calc(14px * var(--home-font-scale,1)); }
.home-discover { margin:40px 24px 0; padding-top:24px; border-top:1px solid var(--home-line); }
.home-discover-title { margin:16px 0 0 28px; font:400 calc(24px * var(--home-font-scale,1))/1.65 var(--ql-serif); white-space:pre-line; }
.home-discover > .home-link-row { margin:16px 0 22px 28px; width:calc(100% - 28px); }
.home-featured { display:flex; align-items:center; gap:16px; padding-top:10px; border-top:1px solid var(--home-line); }
.home-featured > .home-section-note { white-space:nowrap; }
.home-page .home-reading-row { flex:1; min-width:0; min-height:48px; font-size:calc(16px * var(--home-font-scale,1)); text-align:right; overflow-wrap:break-word; }
.home-reading-message { margin-top:16px; font-size:calc(16px * var(--home-font-scale,1)); }
.home-page .home-more-reading,.home-page .home-more-stories { display:block; width:auto; min-height:44px; margin-top:4px; font-size:calc(14px * var(--home-font-scale,1)); color:var(--home-green); }
.home-voice-layer { position:fixed; top:0;right:0;bottom:0;left:0; z-index:120; display:flex; align-items:center; justify-content:center; color:#252b21; }
.home-voice-mask { position:absolute; top:0;right:0;bottom:0;left:0; background:rgba(25,34,22,.45); }
.home-voice-dialog { position:relative; box-sizing:border-box; width:calc(100% - 32px); max-width:343px; padding:24px; border:1px solid #c2c8b9; background:#f7f6ef; }
.home-voice-dialog-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; font-size:calc(20px * var(--home-font-scale,1)); line-height:1.6; }
.home-voice-dialog-head button { flex:none; box-sizing:border-box; width:44px; height:44px; min-height:44px; margin:-8px -10px 0 0; padding:0; border:0; border-radius:0; background:none; font-size:24px; line-height:44px; }
.home-voice-dialog-body { max-height:55vh; margin-top:18px; }
.home-voice-full { white-space:pre-wrap; font-size:calc(16px * var(--home-font-scale,1)); line-height:1.85; }
.home-voice-dialog-body .home-section-note { margin-top:18px; }
@media(max-width:350px) { .welcome-opening { padding-left:20px; padding-right:20px; } .welcome-title-serif,.welcome-copy { margin-left:20px; } .home-hero { margin-right:16px; } .home-hero-image { height:210px; } .home-camp,.home-voices,.home-discover { margin-left:20px; margin-right:20px; } .home-page .home-voice-card { padding:12px 10px; } .home-voice-meta { flex-wrap:wrap; } }
@media(prefers-reduced-motion:reduce) { .home-motion-probe { width:1px; } }
