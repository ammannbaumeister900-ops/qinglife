.home-page {
  padding: 36rpx 44rpx calc(184rpx + env(safe-area-inset-bottom));
  background: var(--ql-bg);
}
.home-page::before { display: none; }
.welcome-block { margin: 0 0 32rpx; padding: 8rpx 0 32rpx; border-bottom: 1rpx solid var(--ql-border); }
.welcome-title { color: var(--ql-ink); font-family: var(--ql-serif); font-size: 32rpx; line-height: 1.7; letter-spacing: 1rpx; }
.home-page .home-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  gap: 20rpx;
}
.home-section-head .index-label {
  flex: 1;
  min-width: 0;
  color: var(--ql-ink);
  font-family: inherit;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: 1rpx;
}
.home-page button.home-section-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  margin: 0 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ql-sage-deep);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: right;
}
.home-story-intro { margin: -2rpx 0 30rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.65; }
.home-story-swiper { height: 470rpx; }
.home-story-card { box-sizing: border-box; height: 466rpx; margin-right: 24rpx; }
.home-story-title {
  display: -webkit-box;
  height: 90rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--ql-ink);
  font-family: inherit;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: break-word;
}
.home-story-cover { display: block; width: 100%; height: 260rpx; border-radius: 16rpx; background: var(--ql-tint-sage); }
.home-cover-placeholder {
  position: relative;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  box-sizing: border-box;
  padding: 28rpx;
  background: linear-gradient(135deg, #e4e9de, #eef0e8);
}
.home-cover-placeholder::before {
  position: absolute;
  right: 64rpx;
  top: 44rpx;
  width: 160rpx;
  height: 160rpx;
  border: 1rpx solid rgba(124, 143, 120, .26);
  border-radius: 50%;
  content: '';
}
.home-cover-placeholder::after {
  position: absolute;
  right: 28rpx;
  top: 74rpx;
  width: 160rpx;
  height: 160rpx;
  border: 1rpx solid rgba(124, 143, 120, .16);
  border-radius: 50%;
  content: '';
}
.home-cover-caption { position: relative; color: #65755e; font-family: var(--ql-serif); font-size: 24rpx; letter-spacing: 6rpx; line-height: 1.5; }
.home-story-summary { display: -webkit-box; height: 80rpx; margin-top: 16rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.65; }
.home-story-footer { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin: 0 0 12rpx; }
.home-story-count { flex-shrink: 0; min-width: 96rpx; white-space: nowrap; color: var(--ql-ink-ghost); font-size: 22rpx; letter-spacing: 2rpx; }
.home-story-arrows { display: flex; flex-shrink: 0; gap: 8rpx; }
.home-page button.home-story-arrow { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 0; height: 88rpx; margin: 0; padding: 0; background: transparent; color: var(--ql-sage-deep); font-size: 36rpx; line-height: 1; }
.home-page button.home-story-arrow[disabled] { background: transparent; color: var(--ql-ink-ghost); opacity: .4; }
.home-page button.home-camp-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  margin: 12rpx 0 24rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid var(--ql-border);
  border-bottom: 1rpx solid var(--ql-border);
  border-radius: 0;
  background: transparent;
  color: var(--ql-ink);
  text-align: left;
  line-height: 1.5;
}
.home-camp-time { flex: 1; min-width: 0; }
.home-camp-label { color: var(--ql-ink-light); font-size: 22rpx; letter-spacing: 1rpx; }
.home-camp-date { margin-top: 8rpx; font-size: 30rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.home-camp-period { display: flex; align-items: center; flex-shrink: 0; gap: 16rpx; max-width: 220rpx; color: var(--ql-ink-light); font-size: 24rpx; }
.home-camp-period text { color: var(--ql-sage-deep); font-size: 30rpx; }
.home-page button.home-camp-empty { min-height: 104rpx; color: var(--ql-ink-light); font-size: 24rpx; }
.home-camp-empty .home-section-link { color: var(--ql-sage-deep); font-size: 24rpx; }
.home-reading-head .index-label { font-size: 30rpx; font-weight: 500; }
.home-page button.home-reading-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; width: 100%; min-height: 104rpx; margin: 0; padding: 20rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--ql-border); background: transparent; color: var(--ql-ink); text-align: left; line-height: 1.65; }
.home-reading-title { display: -webkit-box; flex: 1; min-width: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 26rpx; font-weight: 400; }
.home-reading-arrow { flex-shrink: 0; color: var(--ql-ink-ghost); font-size: 30rpx; }
.home-reading-message { padding: 16rpx 0; color: var(--ql-ink-light); font-size: 24rpx; }
.home-task { margin: 0 0 28rpx; padding: 12rpx 0 24rpx; border-bottom: 1rpx solid var(--ql-border); }
.home-task-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.home-task-title { flex: 1; min-width: 0; font-size: 26rpx; font-weight: 500; line-height: 1.5; }
.home-page button.home-task-action { display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; width: auto; min-height: 88rpx; max-width: 280rpx; margin: 0; padding: 0; background: transparent; color: var(--ql-sage-deep); font-size: 24rpx; line-height: 1.5; }
.home-task-copy { display: -webkit-box; margin-top: 6rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.6; }

.home-page { background: linear-gradient(180deg, #F8F1E7 0, #F6F1E8 550rpx, #F3F2E9 1100rpx, #F6F1E8 1600rpx); }
.welcome-block { padding: 36rpx 28rpx 40rpx; margin: 0 -12rpx 24rpx; border: 0; border-radius: 12rpx; background: radial-gradient(ellipse at 85% 18%, rgba(235,213,188,.40), transparent 70%), linear-gradient(150deg,rgba(255,252,247,.60),rgba(245,236,222,.48)); }
.welcome-kicker { color: #7C746B; font-size: 20rpx; letter-spacing: 5rpx; margin-bottom: 28rpx; }
.welcome-title { font-size: 34rpx; color: #70665A; letter-spacing: 4rpx; line-height: 1.8; }
.welcome-ending { margin: 6rpx 0 0 52rpx; font-family: var(--ql-serif); font-size: 43rpx; line-height: 1.8; letter-spacing: 3rpx; color: #3F463A; }
.welcome-light { color: #66775E; margin-left: 5rpx; }
.welcome-rule { width: 54rpx; height: 2rpx; background: #BBA58B; margin: 28rpx 0 0 56rpx; }
.home-page button.home-camp-entry { padding: 26rpx 24rpx; border: 0; border-radius: 12rpx; background: linear-gradient(120deg,#EDF0E5,#F4F1E7); }

/* A small transparent brand mark shares the opening verse's warm paper background. */
.welcome-brand-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: -12rpx 0 8rpx; }
.welcome-brand-row .welcome-kicker { margin-bottom: 0; flex: 1; min-width: 0; line-height: 1.8; }
.welcome-logo { display: block; width: 206rpx; height: 154rpx; flex-shrink: 0; }
