/* Fixed brand phrase only; Noto Serif SC subset under SIL OFL. */
@font-face { font-family: "Qinglife Opening"; src: url("data:font/ttf;base64,"); font-style: normal; font-weight: 400; }
/* Native implementation of b-validation/index.html, final confirmed composition. */
page {
  --ql-bg: #f7f6ef;
  --ql-ink: #252b21;
  --ql-ink-light: #666e5e;
  --home-green: #435e3c;
  --home-rule: #c2c8b9;
  background: var(--ql-bg);
}
.home-page { padding: 0 0 calc(118rpx + 24rpx + env(safe-area-inset-bottom)); background: var(--ql-bg); }
.home-page::before { display: none; }
.home-page button { box-sizing: border-box; min-width: 0; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--ql-ink); font: inherit; text-align: left; white-space: normal; line-height: 1.5; }
.home-page button::after { border: 0; }
.home-page button:active { opacity: .75; }
.home-page .refresh-note { position: static; margin: 0 44rpx 16rpx; padding: 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 26rpx; }
.home-page .empty-state { margin: 0 44rpx; padding: 48rpx 0; border: 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; }
.home-page .text-button { width: auto; color: var(--home-green); font-size: 28rpx; }

.cancellation-notice { display: flex; align-items: center; gap: 8px; margin: 0 44rpx; color: var(--ql-ink-light); font-size: 14px; line-height: 1.6; }
.home-page button.cancellation-link { display: flex; align-items: center; flex: 1; gap: 8px; width: auto; min-width: 0; color: var(--ql-ink-light); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.cancellation-icon { flex: none; font-size: 12px; }
.cancellation-action { color: var(--home-green); }
.home-page button.cancellation-close { flex: none; display: flex; align-items: center; justify-content: center; width: 32px; color: var(--ql-ink-light); font-size: 18px; }
.welcome-opening { padding: 28rpx 44rpx 36rpx; }
.welcome-title { font-size: 30px; font-weight: 500; line-height: 1.3; }
.welcome-title-serif { display: block; margin-left: 86rpx; font-family: "Qinglife Opening", var(--ql-serif); font-size: 36px; font-weight: 400; }
.welcome-copy { margin: 22rpx 0 0 86rpx; color: var(--ql-ink-light); font-size: 26rpx; line-height: 1.8; }
.home-hero { margin-right: 42rpx; }
.home-hero-image { display: block; width: 100%; height: auto; }
.home-photo-caption { margin: 18rpx 0 0 44rpx; color: var(--ql-ink-light); font-size: 22rpx; line-height: 1.6; }

.home-task { padding: 44rpx 40rpx 60rpx; background: #e8ecdf; }
.home-task-context { color: #4f6146; font-size: 24rpx; line-height: 1.8; }
.home-task-title { margin-top: 20rpx; font-size: 50rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.home-task-copy { margin-top: 22rpx; color: #526049; font-size: 28rpx; line-height: 1.8; }
.home-page button.home-task-action { display: inline-flex; align-items: center; justify-content: center; width: auto; max-width: 100%; min-height: 48px; margin-top: 40rpx; padding: 26rpx 40rpx; background: #344b30; color: #fff; font-size: 28rpx; line-height: 1.5; }

.home-camp { margin-top: 56rpx; }
.home-task + .home-camp { margin-top: 54rpx; }
.home-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin: 0 40rpx 40rpx; }
.home-section-head .index-label { color: var(--ql-ink); font-size: 16px; font-weight: 500; line-height: 1.6; letter-spacing: 0; }
.home-section-note { flex: none; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.6; }
.home-camp .home-section-head { margin-bottom: 28rpx; }
.home-page button.home-camp-entry { display: block; width: 100%; }
.home-camp-copy { margin: 0 44rpx 0 84rpx; }
.home-camp-title { font-size: 24px; font-weight: 500; line-height: 1.4; overflow-wrap: break-word; }
.home-camp-kind { display: block; margin-top: 10rpx; font-size: 18px; font-weight: 400; }
.home-camp-date { margin-top: 24rpx; color: var(--ql-ink); font-size: 32rpx; line-height: 1.8; }
.home-camp-place { margin-top: 4rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.8; }
.home-camp-support { margin-top: 16rpx; color: var(--ql-ink-light); font-size: 26rpx; line-height: 1.8; }
.home-camp-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 20rpx; min-height: 44px; margin-top: 26rpx; padding-top: 14rpx; border-top: 1rpx solid var(--home-rule); color: var(--home-green); font-size: 28rpx; }
.home-camp-detail { flex: 1; }
.home-camp-status { color: var(--ql-ink-light); font-size: 26rpx; }
.home-camp-cover { display: block; width: calc(100% - 84rpx); height: auto; margin: 34rpx 0 0 84rpx; }
.home-camp-no-image .home-camp-copy { padding-top: 40rpx; border-top: 4rpx solid var(--home-green); }
.home-page button.home-camp-empty { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; width: auto; margin: 0 44rpx; color: var(--ql-ink-light); font-size: 28rpx; }
.home-camp-empty .home-section-link { color: var(--home-green); }

.home-stories { margin-top: 80rpx; }
.home-section-intro { margin: 0 44rpx 44rpx; color: var(--ql-ink-light); font-size: 26rpx; line-height: 1.8; }
.home-page button.home-story-row { display: block; width: 100%; }
.home-story-lead .home-story-cover { display: block; width: 78%; height: 670rpx; margin-left: 22%; }
.home-story-copy { position: relative; z-index: 1; margin: -56rpx 12% 0 0; padding: 38rpx 40rpx 0 44rpx; background: var(--ql-bg); }
.home-story-lead .home-story-title { font-family: var(--ql-serif); font-size: 28px; font-weight: 400; line-height: 1.45; white-space: pre-line; overflow-wrap: break-word; }
.home-story-summary { margin-top: 24rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.85; overflow-wrap: break-word; }
.home-story-action { display: flex; align-items: center; min-height: 44px; margin-top: 16rpx; color: var(--home-green); font-size: 26rpx; }
.home-story-lead.home-story-no-image .home-story-copy { margin: 0 44rpx 0 84rpx; padding: 32rpx 0 0; border-top: 1rpx solid #8b977f; }
.home-story-scroll { width: 100%; margin-top: 42rpx; }
.home-story-track { padding: 0 44rpx 26rpx; white-space: nowrap; font-size: 0; }
.home-page button.home-story-secondary { display: inline-block; vertical-align: top; width: 480rpx; margin-right: 38rpx; white-space: normal; }
.home-page button.home-story-secondary:last-child { margin-right: 0; }
.home-story-secondary .home-story-cover { display: block; width: 100%; height: 510rpx; }
.home-story-secondary .home-story-title { margin-top: 26rpx; font-size: 18px; font-weight: 400; line-height: 1.55; overflow-wrap: break-word; }
.home-story-secondary .home-story-summary { margin-top: 20rpx; font-size: 26rpx; line-height: 1.8; }
.home-page button.home-story-offset { padding-top: 52rpx; }
.home-story-offset .home-story-cover { height: 414rpx; }
.home-story-secondary.home-story-no-image .home-story-title { margin-top: 0; padding-top: 28rpx; border-top: 1rpx solid #89967c; font-family: var(--ql-serif); font-size: 20px; font-weight: 400; line-height: 1.6; color: var(--home-green); }
.home-page .home-story-scroll-single button.home-story-secondary { width: 100%; margin-right: 0; }
.home-story-scroll-single .home-story-cover { height: 510rpx; }
.home-stories-footer { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; margin: 20rpx 40rpx 0 84rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid var(--home-rule); }
.home-page button.home-section-link { display: flex; align-items: center; width: auto; color: var(--home-green); font-size: 26rpx; }

.home-readings { margin: 64rpx 40rpx 0; }
.home-readings .home-section-head { align-items: center; margin: 0 0 30rpx; }
.home-readings .home-section-intro { margin: 0 0 32rpx; }
.home-reading-list { margin-left: 44rpx; }
.home-page button.home-reading-row { width: 100%; }
.home-page button.home-reading-lead { padding-top: 28rpx; border-top: 2rpx solid var(--ql-ink); }
.home-reading-lead .home-reading-title { max-width: 9em; font-size: 26px; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.home-reading-summary { margin-top: 22rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.9; overflow-wrap: break-word; }
.home-reading-action { display: flex; align-items: center; min-height: 44px; margin-top: 30rpx; color: var(--home-green); font-size: 26rpx; }
.home-page button.home-reading-secondary { display: flex; align-items: baseline; gap: 48rpx; margin-top: 56rpx; padding-top: 36rpx; border-top: 1rpx solid var(--home-rule); }
.home-reading-copy { flex: 1; min-width: 0; }
.home-reading-secondary .home-reading-title { font-family: var(--ql-serif); font-size: 21px; font-weight: 400; line-height: 1.6; overflow-wrap: break-word; }
.home-entry-arrow { flex: none; font-size: 28rpx; }
.home-reading-message { margin-left: 44rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.85; }

@media (max-width: 350px) {
  .welcome-title { font-size: 28px; }
  .welcome-title-serif { font-size: 34px; }
  .home-task-title { font-size: 46rpx; }
  .home-camp-copy { margin-left: 64rpx; }
  .home-camp-cover { width: calc(100% - 64rpx); margin-left: 64rpx; }
  .home-story-lead .home-story-title { font-size: 26px; }
  .home-reading-list { margin-left: 32rpx; }
  .home-reading-lead .home-reading-title { font-size: 24px; }
  .home-section-note, .home-photo-caption { font-size: 12px; }
  .welcome-copy, .home-section-intro, .home-camp-support, .home-camp-status,
  .home-task-copy, .home-story-summary, .home-reading-summary,
  .home-reading-message, .home-camp-place { font-size: 14px; }
  .home-camp-date { font-size: 16px; }
  .home-story-secondary .home-story-summary, .home-story-action,
  .home-reading-action, .home-page button.home-section-link { font-size: 14px; }
}

/* Full titles stay readable when API content is long or photography is absent. */
.home-story-lead.home-story-no-image .home-story-title, .home-story-lead.home-long-title .home-story-title { font-size: 23px; line-height: 1.55; }
.home-reading-lead.home-long-title .home-reading-title { max-width: none; font-size: 23px; line-height: 1.55; }
.home-story-secondary.home-long-title .home-story-title { font-size: 18px; }
.home-story-no-image.home-story-offset { padding-top: 26rpx; }

.home-reading-title { white-space: pre-line; }
