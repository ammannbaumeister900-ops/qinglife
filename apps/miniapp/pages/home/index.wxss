.home-page {
  padding: 28rpx 40rpx calc(184rpx + env(safe-area-inset-bottom));
  background: var(--ql-bg);
}
.home-page::before { display: none; }
.home-page .refresh-note { position: static; margin: 0 0 16rpx; text-align: left; }

.home-task { margin-bottom: 16rpx; padding: 12rpx 0 24rpx; }
.home-task-title { color: var(--ql-ink); font-size: 40rpx; font-weight: 600; line-height: 1.45; overflow-wrap: break-word; }
.home-task-copy { margin-top: 14rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.65; overflow-wrap: break-word; }
.home-page button.home-task-action { display: inline-flex; align-items: center; justify-content: center; gap: 12rpx; width: auto; max-width: 100%; min-height: 48px; margin: 24rpx 0 0; padding: 18rpx 28rpx; border-radius: 12rpx; color: var(--ql-surface); background: var(--ql-ink); font-size: 28rpx; font-weight: 500; line-height: 1.5; }

.welcome-block { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; padding: 8rpx 0 24rpx; }
.welcome-title { flex: 1; min-width: 0; color: var(--ql-ink); font-family: var(--ql-serif); font-size: 34rpx; line-height: 1.6; overflow-wrap: break-word; }
.welcome-logo { display: block; flex: none; width: 152rpx; height: 90rpx; }

.home-page button.home-camp-entry { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; margin: 0 0 36rpx; padding: 26rpx 0; border-top: 1rpx solid var(--ql-border); border-bottom: 1rpx solid var(--ql-border); border-radius: 0; background: transparent; color: var(--ql-ink); text-align: left; white-space: normal; line-height: 1.5; }
.home-camp-copy { flex: 1; min-width: 0; }
.home-camp-meta { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.5; }
.home-camp-title { margin-top: 10rpx; font-size: 34rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.home-camp-date { margin-top: 8rpx; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.6; overflow-wrap: break-word; }
.home-entry-arrow { flex: none; color: var(--ql-ink-light); font-size: 34rpx; line-height: 1.5; }
.home-page button.home-camp-empty { min-height: 48px; color: var(--ql-ink-light); font-size: 28rpx; }
.home-camp-empty .home-section-link { flex: none; color: var(--ql-ink-light); font-size: 26rpx; }

.home-page .home-section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-width: 0; margin: 0; }
.home-section-head .index-label { flex: 1; min-width: 0; color: var(--ql-ink); font-family: inherit; font-size: 30rpx; font-weight: 600; line-height: 1.5; letter-spacing: 0; }
.home-page button.home-section-link { display: flex; align-items: center; justify-content: flex-end; flex: none; width: auto; min-width: 0; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--ql-ink-light); font-size: 28rpx; font-weight: 400; line-height: 1.5; text-align: right; }
.home-readings { margin-top: 36rpx; }
.home-page button.home-story-row,
.home-page button.home-reading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; width: 100%; min-height: 48px; margin: 0; padding: 24rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--ql-border); background: transparent; color: var(--ql-ink); text-align: left; line-height: 1.5; }
.home-story-copy,
.home-reading-copy { flex: 1; min-width: 0; }
.home-story-title { font-family: var(--ql-serif); font-size: 34rpx; font-weight: 400; line-height: 1.5; overflow-wrap: break-word; }
.home-story-cover { display: block; flex: none; width: 140rpx; height: 140rpx; border-radius: 6rpx; }
.home-story-summary,
.home-reading-summary { display: -webkit-box; margin-top: 12rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.65; overflow-wrap: break-word; }
.home-reading-title { font-size: 30rpx; font-weight: 400; line-height: 1.6; overflow-wrap: break-word; }
.home-reading-row .home-entry-arrow { margin-top: 2rpx; }
.home-page .empty-state .text-button,
.home-reading-message .text-button { min-height: 44px; }
.home-reading-message { padding: 18rpx 0; color: var(--ql-ink-light); font-size: 28rpx; line-height: 1.65; }
.home-page button.home-story-row:active,
.home-page button.home-reading-row:active,
.home-page button.home-camp-entry:active { opacity: .75; }

@media (max-width: 350px) {
  .home-page button.home-task-action,
  .home-page button.home-section-link,
  .home-camp-meta,
  .home-task-copy,
  .home-camp-date,
  .home-story-summary,
  .home-reading-summary,
  .home-reading-message { font-size: 14px; }
  .home-section-head .index-label,
  .home-reading-title { font-size: 15px; }
}
