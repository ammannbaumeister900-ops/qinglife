<launch-splash />
<ql-nav-space title="轻生活" />
<view class="page home-page">
  <view wx:if="{{refreshing}}" class="refresh-note">正在更新…</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取…</view>
  <view wx:if="{{loadError}}" class="empty-state">{{loadError}}<button class="text-button" bindtap="onShow">重试</button></view>
  <block wx:if="{{!loading && !loadError}}">
    <view wx:if="{{state.loggedIn && (showHomeTask || view.route === 'journey' || view.route === 'experience' || view.route === 'habit' || view.route === 'daily')}}" class="home-task">
      <view class="home-task-title">{{view.title}}</view>
      <view class="home-task-copy">{{view.copy}}</view>
      <button class="primary home-task-action" bindtap="openPrimary">{{view.action}}<text aria-hidden="true"> ›</text></button>
    </view>
    <view wx:else class="welcome-block">
      <view class="welcome-title">{{returning ? '把那一点轻松，带回日常。' : '生活很满，也可以留一点轻。'}}</view>
      <image class="welcome-logo" src="/assets/brand/logo-sage.png" mode="aspectFit" aria-label="轻生活品牌 Logo" />
    </view>

    <button wx:if="{{featured}}" class="home-camp-entry" data-view="detail" bindtap="openActivity">
      <view class="home-camp-copy">
        <view class="home-camp-meta"><text>近期轻体营</text><text wx:if="{{featured.sessionNumber}}">第 {{featured.sessionNumber}} 期</text></view>
        <view class="home-camp-title">{{featured.name}}</view>
        <view class="home-camp-date">{{featured.dateLabel}}<text wx:if="{{featured.city}}"> · {{featured.city}}</text></view>
      </view>
      <text class="home-entry-arrow" aria-hidden="true">›</text>
    </button>
    <button wx:else class="home-camp-entry home-camp-empty" bindtap="openCamp"><text>暂无开放期次</text><text class="home-section-link">全部期次 ›</text></button>

    <view wx:if="{{stories.length}}" class="home-stories">
      <view class="index-head home-section-head"><text class="index-label">轻友的轻生活</text><button class="home-section-link home-more-stories" bindtap="openStories">更多故事 ›</button></view>
      <view class="home-story-list">
        <block wx:for="{{stories}}" wx:key="id">
          <button wx:if="{{index < 2}}" class="home-story-row" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="openArticle" aria-label="{{item.title}}">
            <view class="home-story-copy"><view class="home-story-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="home-story-summary">{{item.summary}}</view></view>
            <image wx:if="{{item.cover}}" class="home-story-cover" src="{{item.cover}}" mode="aspectFill" />
          </button>
        </block>
      </view>
    </view>

    <view class="home-readings">
      <view class="index-head home-section-head home-reading-head"><text class="index-label">精选轻读</text><button class="home-section-link" bindtap="openReading">全部轻读 ›</button></view>
      <view wx:if="{{readingError}}" class="home-reading-message"><view>{{readingError}}</view><button class="text-button" bindtap="onShow">重试</button></view>
      <view wx:elif="{{featuredReadings.length}}" class="home-reading-list">
        <block wx:for="{{featuredReadings}}" wx:key="id">
          <button wx:if="{{index < 2}}" class="home-reading-row" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="openArticle" aria-label="{{item.title}}">
            <view class="home-reading-copy"><view class="home-reading-title">{{item.title}}</view><view wx:if="{{item.summary}}" class="home-reading-summary">{{item.summary}}</view></view>
            <text class="home-entry-arrow" aria-hidden="true">›</text>
          </button>
        </block>
      </view>
      <view wx:else class="home-reading-message">暂时没有可查看的精选轻读，可以前往轻读看看。</view>
    </view>
  </block>
</view>
