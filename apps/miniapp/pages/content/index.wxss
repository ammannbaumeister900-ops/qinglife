/* 轻读 · 「林下午后」P8（docs/design/redesign-2026q4/p8-reading-rhythm.md）。只引用 --q-* 令牌。
 * 浏览：一条主推荐 + 文字列表；轻友故事：每篇带自己的照片，署名前置；搜索：紧凑检索，不显示图片。 */
page { background: var(--q-linen); }
.page.content-page { padding: 12px var(--q-gutter) calc(180rpx + env(safe-area-inset-bottom)); background: var(--q-linen); color: var(--q-ink); }
.content-page::before { display: none; }

/* 检索控件：功能区，不做品牌表达 */
.content-page .search-row { position: relative; box-sizing: border-box; height: 48px; margin-bottom: 8px; border: 1px solid var(--q-line); background: var(--q-white); }
.content-page .search-input { box-sizing: border-box; width: 100%; height: 100%; min-width: 0; padding: 0 64px 0 14px; border: 0; border-radius: 0; background: transparent; color: var(--q-ink); font-size: 15px; }
.content-page .search-clear { position: absolute; top: 0; right: 0; width: 56px; min-width: 0; height: 100%; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--q-moss); font-size: 15px; line-height: 46px; }
.content-page .chips { display: flex; flex-wrap: wrap; gap: 0 20px; margin: 0 0 20px; border-bottom: 1px solid var(--q-line); }
.content-page .chips .chip { display: inline-flex; flex: none; align-items: center; justify-content: center; width: auto; min-width: 0; min-height: 44px; margin: 0 0 -1px; padding: 10px 0; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; color: var(--q-ink-2); font-size: 15px; font-weight: 400; line-height: 1.4; }
.content-page .chips .chip.active { border-bottom-color: var(--q-ink); color: var(--q-ink); font-weight: 600; }
.content-page .chips .chip:active { transform: none; }

/* 文章条目：发丝线分隔的文字列表 */
.article-card { padding: 22px 0; border-bottom: 1px solid var(--q-line); transition: opacity 180ms ease; }
.article-card:last-of-type { border-bottom: 0; }
.article-card:active { opacity: .72; }
.reading-cover { display: block; width: 100%; height: auto; margin-bottom: 18px; }
.reading-category, .reading-byline { color: var(--q-moss); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.reading-byline { font-weight: 500; }
.article-title { margin: 6px 0 8px; font-family: var(--ql-serif); font-size: 18px; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.article-summary { display: -webkit-box; overflow: hidden; color: var(--q-ink-2); font-size: 15px; line-height: 1.75; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.article-footer { margin-top: 10px; color: var(--q-ink-2); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }

/* 浏览：主推荐封面满宽出血；没有封面时以墨线开头 */
.content-page .reading-feature { padding: 18px 0 26px; border-top: 1px solid var(--q-ink); }
.content-page .reading-feature.has-cover { padding-top: 0; border-top: 0; }
.content-page .reading-feature .reading-cover { width: auto; margin: 0 calc(0px - var(--q-gutter)) 18px; }
.content-page .reading-feature .article-title { font-size: 24px; line-height: 1.45; }
.content-page .reading-feature .article-summary { color: var(--q-ink); font-size: 16px; line-height: 1.8; }

/* 轻友故事：故事 1 是本页唯一高点；其余故事封面内缩，弱一级 */
.reading-stories .article-card { padding-top: 28px; padding-bottom: 28px; }
.reading-stories .article-card .reading-cover { margin-bottom: 16px; }
.reading-stories .article-card .article-title { font-size: 20px; line-height: 1.45; }
.reading-stories .article-card.reading-feature { margin-bottom: 18px; padding-top: 18px; padding-bottom: 32px; }
.reading-stories .article-card.reading-feature.has-cover { padding-top: 0; }
.reading-stories .reading-feature .reading-cover { margin-bottom: 18px; }
.reading-stories .reading-feature .article-title { margin-top: 4px; font-size: 26px; line-height: 1.42; }
.reading-stories .reading-feature .article-summary { -webkit-line-clamp: 3; }

/* 搜索：紧凑检索 */
.reading-search .article-card { padding: 18px 0; }
.reading-search .article-title { margin: 4px 0 6px; font-family: inherit; font-size: 16px; font-weight: 600; line-height: 1.55; }

/* 状态 */
.content-page .sample-note { margin: 0 0 12px; padding: 10px 14px; border-radius: 0; background: var(--q-field); color: var(--q-ink-2); font-size: 14px; line-height: 1.6; }
.content-page .empty-state { margin: 0; padding: 40px 0; border: 0; border-radius: 0; background: transparent; color: var(--q-ink-2); text-align: center; }
.content-page .empty-title { color: var(--q-ink); font-family: var(--ql-serif); font-size: 18px; line-height: 1.6; }
.content-page .empty-copy { margin-top: 8px; color: var(--q-ink-2); font-size: 15px; line-height: 1.7; }
.content-page .empty-action, .content-page .text-button { display: flex; align-items: center; justify-content: center; width: auto; min-width: 44px; min-height: 44px; margin: 16px auto 0; padding: 0 12px; border: 0; border-radius: 0; background: transparent; color: var(--q-moss); font-size: 15px; font-weight: 500; line-height: 1.5; }
.content-page .empty-action:active, .content-page .text-button:active { opacity: .72; transform: none; }

@media (max-width: 350px) {
  .page.content-page { --q-gutter: 20px; }
  .reading-stories .reading-feature .article-title { font-size: 23px; }
}
