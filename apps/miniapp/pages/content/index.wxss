.content-intro {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-right: 64rpx;
}
.content-title {
  margin-top: 12rpx;
  font-family: var(--ql-serif);
  font-size: 54rpx;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 2rpx;
}
.content-side {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  color: var(--ql-clay);
  font-size: 24rpx;
}

.search-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.fallback-note { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 12rpx 0 24rpx; padding: 20rpx 24rpx; border-radius: 28rpx; background: rgba(195, 208, 214, 0.24); color: var(--ql-ink-light); font-size: 22rpx; }
.fallback-note button { width: auto; margin: 0; padding: 10rpx 16rpx; background: transparent; color: var(--ql-clay-deep); font-size: 22rpx; line-height: 1.4; }
.search-input { flex: 1; }
.search-clear { width: auto; margin: 0; padding: 0 10rpx; background: transparent; color: var(--ql-clay-deep); font-size: 24rpx; line-height: 96rpx; }

.content-switch {
  display: flex;
  margin-bottom: 10rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  background: rgba(238, 231, 218, 0.72);
}
.switch-button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  background: transparent;
  color: var(--ql-ink-light);
  font-size: 25rpx;
  line-height: 68rpx;
}
.switch-button.active {
  background: rgba(255, 252, 247, 0.96);
  color: var(--ql-ink);
  font-weight: 500;
  box-shadow: 0 6rpx 18rpx rgba(74, 61, 49, 0.07);
}

/* 文章条目：发丝线分隔的排版列表，非卡片 */
.article-list {
  padding: 6rpx 6rpx 0;
  border-top: 1rpx solid rgba(74, 61, 49, 0.14);
}
.article-card {
  padding: 32rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(74, 61, 49, 0.14);
  transition: opacity 180ms ease;
}
.article-card:active { opacity: 0.7; }
.article-title {
  margin: 16rpx 0 12rpx;
  font-family: var(--ql-serif);
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.5;
}
.article-summary {
  display: -webkit-box;
  overflow: hidden;
  color: var(--ql-ink-light);
  font-size: 25rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.article-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 18rpx;
  color: var(--ql-ink-ghost);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.list-chevron { color: var(--ql-ink-ghost); font-size: 30rpx; }
.pill-play { width: 44rpx; padding: 0; justify-content: center; }
.pill-play-icon { width: 26rpx; height: 26rpx; }

.directory-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 46rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--ql-radius-card);
  background:
    radial-gradient(circle at 90% 0%, rgba(255, 246, 218, 0.6), transparent 34%),
    radial-gradient(circle at 0% 110%, rgba(195, 208, 214, 0.42), transparent 42%),
    linear-gradient(150deg, rgba(255, 252, 247, 0.94), rgba(231, 239, 240, 0.9));
  box-shadow: var(--ql-shadow-hero);
}
.directory-title {
  margin-top: 16rpx;
  font-family: var(--ql-serif);
  font-size: 46rpx;
  line-height: 1.4;
}
.directory-note { margin-top: 14rpx; color: var(--ql-ink-light); font-size: 25rpx; line-height: 1.65; }

.concern-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 20rpx; }
.concern-tab {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  gap: 16rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--ql-border);
  border-radius: var(--ql-radius-inner);
  background: rgba(255, 252, 247, 0.84);
  color: var(--ql-ink-light);
  font-size: 25rpx;
  text-align: left;
  line-height: 1.4;
  transition: opacity 180ms ease, transform 180ms ease;
}
.concern-tab.active {
  border-color: rgba(155, 111, 88, 0.36);
  background: var(--ql-tint-clay);
  color: var(--ql-clay-deep);
}
.concern-number {
  color: var(--ql-clay);
  font-family: var(--ql-serif);
  font-size: 22rpx;
}
.concern-tab.active .concern-number { color: var(--ql-clay-deep); }
.concern-name { font-weight: 600; }

.directory-panel { overflow: hidden; }
.panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; }
.panel-title {
  margin-top: 14rpx;
  font-family: var(--ql-serif);
  font-size: 38rpx;
  line-height: 1.45;
}
.subtopic-list { margin-top: 26rpx; border-top: 1rpx solid rgba(74, 61, 49, 0.08); }
.subtopic-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(74, 61, 49, 0.08);
  color: #48443F;
  font-size: 27rpx;
}
.subtopic-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--ql-sage); }
.guide-summary { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 28rpx; }
.guide-label, .guide-text { display: block; }
.guide-label { color: var(--ql-ink-ghost); font-size: 22rpx; letter-spacing: 2rpx; }
.guide-text { margin-top: 8rpx; color: var(--ql-ink-light); font-size: 24rpx; line-height: 1.5; }
.guide-action {
  display: flex;
  min-height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  box-sizing: border-box;
  width: auto;
  margin: 0;
  padding: 18rpx 26rpx;
  border-radius: 26rpx;
  background: var(--ql-ink);
  color: var(--ql-surface);
  font-size: 23rpx;
  line-height: 1.4;
}

.content-page .chips .chip { display: inline-flex; align-items: center; justify-content: center; flex: none; width: auto; min-width: 0; min-height: 64rpx; margin: 0; padding: 12rpx 20rpx; font-size: 24rpx; line-height: 1.4; }
