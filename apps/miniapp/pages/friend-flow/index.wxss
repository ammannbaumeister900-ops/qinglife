.friend-flow-page .post-detail { padding: 32rpx 0; font-size: 30rpx; line-height: 1.85; color: #3B3833; }

.archive-text { display: block; white-space: pre-wrap; font-size: 28rpx; margin: 20rpx 0; overflow-wrap: anywhere; }
.archive-images { display: flex; flex-wrap: wrap; gap: 12rpx; }
.archive-images image { width: 176rpx; height: 176rpx; border-radius: 16rpx; }
.archive-comments { border-top: 1rpx solid var(--ql-border); margin-top: 24rpx; padding-top: 16rpx; }

/* Daily only: one continuous task, no panel inside a promotional opening. */
.flow-daily { padding: 28rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--ql-bg); }
.flow-daily::before { display: none; }
.flow-daily .hero { margin: 0 0 28rpx; padding: 0; border: none; border-radius: 0; background: transparent; box-shadow: none; }
.flow-daily .hero-title { margin: 0; font-family: inherit; font-size: 40rpx; font-weight: 600; letter-spacing: 0; }
.flow-daily .card { margin: 0; padding: 0; border: none; border-radius: 0; background: transparent; box-shadow: none; }
.flow-daily .chips { display: flex; flex-direction: column; gap: 12rpx; margin: 0 0 32rpx; }
.flow-daily .chip { width: 100%; min-height: 48px; border-radius: 8rpx; text-align: left; font-size: 30rpx; padding: 20rpx 24rpx; background: transparent; }
.flow-daily .chip.active { border-color: #526449; background: var(--ql-tint-sage); color: #384b31; font-weight: 600; }
.flow-daily .label { font-size: 28rpx; }
.flow-daily .textarea { height: 240rpx; padding: 20rpx; border-radius: 8rpx; font-size: 32rpx; }
.flow-daily .privacy-note { padding: 0; border: none; background: transparent; font-size: 26rpx; }
.flow-daily .primary, .flow-daily .text-button { min-height: 48px; border-radius: 8rpx; font-size: 28rpx; }
.daily-error { margin: 16rpx 0; font-size: 28rpx; color: #9A4F30; }
@media (max-width: 350px) { .flow-daily .textarea { font-size: 16px; } .flow-daily .chip { font-size: 15px; } }

/* Archive only: original writing, image order, responses and assistance IDs remain. */
.flow-archive { padding: 28rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--ql-bg); }
.flow-archive::before { display: none; }
.flow-archive .hero { margin: 0 0 24rpx; padding: 0; border: none; border-radius: 0; background: transparent; box-shadow: none; }
.flow-archive .hero-title { margin: 0; font-family: inherit; font-size: 40rpx; font-weight: 600; letter-spacing: 0; }
.flow-archive .hero-copy { margin-top: 12rpx; font-size: 26rpx; }
.flow-archive .card { margin: 0; padding: 32rpx 0; border: none; border-top: 1rpx solid var(--ql-border); border-radius: 0; background: transparent; box-shadow: none; }
.flow-archive .card-title { margin: 0 0 8rpx; font-size: 30rpx; }
.flow-archive .section-note { font-size: 26rpx; color: var(--ql-ink-light); }
.flow-archive .archive-text { font-size: 32rpx; line-height: 1.9; }
.flow-archive .archive-images { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }
.flow-archive .archive-images image { width: 100%; height: 200rpx; border-radius: 4rpx; }
.flow-archive .archive-comments .card-copy { font-size: 28rpx; white-space: pre-wrap; }
.flow-archive .empty-state { padding: 40rpx 0; border: none; border-radius: 0; background: transparent; }
.flow-archive .empty-copy { font-size: 28rpx; }
.flow-archive .secondary, .flow-archive .text-button { min-height: 44px; border-radius: 8rpx; font-size: 28rpx; }
@media (max-width: 350px) { .flow-archive .archive-text { font-size: 16px; } .flow-archive .section-note, .flow-archive .hero-copy { font-size: 13px; } }
