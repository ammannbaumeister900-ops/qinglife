/* 了解轻生活 · 「林下午后」（ART-DIRECTION §6.2）。只引用 --q-* 令牌；字号乘 --about-font-scale（上限 1.4）。 */
page { background:var(--q-linen); --ql-nav-bg:var(--q-linen); }
.about-page { box-sizing:border-box; padding-bottom:calc(118rpx + 40px); padding-bottom:calc(118rpx + 40px + env(safe-area-inset-bottom)); background:var(--q-linen); color:var(--q-ink); font-family:var(--q-sans); overflow-wrap:break-word; }
.about-page view { box-sizing:border-box; }
.about-body { font-size:calc(16px * var(--about-font-scale,1)); line-height:1.85; }
.about-caption { color:var(--q-ink-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.7; }
.about-serif { font-family:var(--q-serif); font-weight:600; }
.about-title { font-size:calc(40px * var(--about-font-scale,1)); line-height:1.35; white-space:pre-line; }
.about-heading { font-size:calc(28px * var(--about-font-scale,1)); line-height:1.45; white-space:pre-line; }
.about-subheading { font-size:calc(20px * var(--about-font-scale,1)); font-weight:500; line-height:1.65; }

/* ① 开场：题字 + 4:5 满幅照片（人物确认后） */
.about-intro { padding:40px var(--q-gutter) 28px; }
.about-intro-copy { margin-top:16px; color:var(--q-ink-2); }
.about-opening-image { display:block; width:100%; height:117.333vw; }
.about-photo-caption { margin:10px var(--q-gutter) 0; }

/* ② 创办（授权后才出现） */
.about-origin { margin:44px var(--q-gutter) 0; padding-top:32px; border-top:1px solid var(--q-line); }
.about-origin-kicker { color:var(--q-moss); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.7; }
.about-origin > .about-heading { margin:12px 0 22px; }
.about-photo-slot { display:flex; flex-direction:column; justify-content:space-between; gap:12px; min-height:198px; margin-bottom:24px; padding:20px 22px; border:1px dashed var(--q-amber); }
.about-photo-slot .about-caption,.about-photo-slot .about-heading { color:var(--q-amber); }
.about-origin-paragraph { margin-top:16px; }
.about-origin-foot { margin-top:22px; padding-top:18px; border-top:1px solid var(--q-line); }
.about-archive-photo { margin-bottom:24px; }
.about-archive-image { display:block; width:100%; }
.about-archive-photo .about-caption { margin-top:10px; }

/* ③ 带回每一天：段题 + 方法句 + 单字题眼（签名三·无营内照片） */
.about-everyday { margin:44px var(--q-gutter) 0; padding-top:36px; border-top:1px solid var(--q-line); }
.about-motto { margin-top:10px; color:var(--q-moss); font-size:calc(18px * var(--about-font-scale,1)); line-height:1.6; }
.about-experience-lead { margin-top:16px; }
.about-glyphs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:26px; border-top:1px solid var(--q-ink); }
.about-glyph { padding:16px 10px 0 0; }
.about-glyph + .about-glyph { padding-left:12px; border-left:1px solid var(--q-line); }
.about-glyph-char { color:var(--q-moss); font-size:58px; line-height:1.15; }
.about-glyph-text { margin-top:8px; color:var(--q-ink-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.7; }
.about-experience-copy { margin-top:34px; }
.about-experience-body { margin-top:14px; }
.about-continuation { margin-top:30px; padding-top:26px; border-top:1px solid var(--q-line); }
.about-subheading.about-serif { line-height:1.7; }
.about-continuation-body { margin-top:14px; }

/* ④ 一次次回来：全页唯一深林色场（签名一）+ 数字即画面（签名二） */
.about-return { margin-top:48px; padding:44px var(--q-gutter) 40px; background:var(--q-forest); color:var(--q-on-dark); }
.about-return .about-caption,.about-on-dark-2 { color:var(--q-on-dark-2); }
.about-return-head .about-heading { margin-top:6px; }
.about-scene { margin:26px calc(-1 * var(--q-gutter)) 0; }
.about-scene-image { display:block; width:100%; height:66.667vw; }
.about-scene-caption { margin:10px var(--q-gutter) 0; }
.about-story { margin-top:26px; }
.about-portrait { margin:0 calc(-1 * var(--q-gutter)); }
.about-portrait-image { display:block; width:100%; }
.about-person { padding-top:24px; }
.about-person-name { font-size:calc(36px * var(--about-font-scale,1)); line-height:1.4; }
.about-person-history { margin-top:16px; color:var(--q-on-dark-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.8; white-space:pre-line; }
.about-person-intro { margin-top:16px; }
.about-person-quote { margin:26px 0 0; padding-left:18px; border-left:2px solid var(--q-juice); font-size:calc(20px * var(--about-font-scale,1)); line-height:1.8; }
.about-quote-source { margin:14px 0 0 20px; color:var(--q-on-dark-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.8; }
.about-story-after { margin-top:28px; }
.about-closing-quote { margin-top:14px; font-size:calc(20px * var(--about-font-scale,1)); line-height:1.8; }
.about-experience-notice { margin-top:18px; }
.about-page .about-full-story { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; width:100%; min-height:48px; margin:0; padding:12px 0; border:0; border-bottom:1px solid var(--q-on-dark-2); border-radius:0; background:transparent; color:var(--q-on-dark); font-size:calc(15px * var(--about-font-scale,1)); line-height:1.85; text-align:left; }
.about-full-story::after { border:0; }
.about-history { margin-top:36px; }
.about-ratio-number { color:var(--q-juice); font-family:var(--q-num); font-size:calc(112px * var(--about-font-scale,1)); font-weight:600; line-height:1; letter-spacing:-2px; }
.about-ratio-unit { margin-left:4px; font-size:calc(48px * var(--about-font-scale,1)); letter-spacing:0; }
.about-ratio-heading { margin-top:12px; font-size:calc(17px * var(--about-font-scale,1)); font-weight:500; line-height:1.6; }
.about-ratio-basis { margin-top:6px; color:var(--q-on-dark-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.75; }
.about-ratio-bar { width:100%; height:6px; margin-top:16px; background:var(--q-moss); }
.about-ratio-bar view { height:100%; background:var(--q-juice); }
.about-history-pair { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; margin-top:32px; padding-top:24px; border-top:1px solid var(--q-moss); }
.about-history-number { font-family:var(--q-num); font-size:calc(48px * var(--about-font-scale,1)); font-weight:600; line-height:1.1; }
.about-history-unit { margin-left:4px; font-size:calc(20px * var(--about-font-scale,1)); }
.about-history-label { margin-top:6px; color:var(--q-on-dark-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.7; }
.about-definition { margin-top:24px; color:var(--q-on-dark-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.8; }

/* ⑤ 透明说明与行动 */
.about-recommended-stories { margin:32px var(--q-gutter) 0; }
.about-page .about-story-link { display:block; width:100%; min-height:48px; margin:12px 0 0; padding:12px 0; border:0; border-bottom:1px solid var(--q-line); border-radius:0; background:transparent; color:var(--q-ink); font-size:calc(16px * var(--about-font-scale,1)); line-height:1.85; text-align:left; white-space:normal; overflow-wrap:break-word; }
.about-story-link::after { border:0; }
.about-transparent { margin:48px var(--q-gutter) 0; }
.about-transparent-intro { margin-top:18px; }
.about-facts { margin-top:24px; border-top:1px solid var(--q-line); }
.about-fact-row { display:grid; grid-template-columns:64px minmax(0,1fr); gap:12px; padding:14px 0; border-bottom:1px solid var(--q-line); }
.about-fact-label { color:var(--q-moss); font-size:calc(14px * var(--about-font-scale,1)); font-weight:600; letter-spacing:.1em; line-height:calc(1.85 * 16 / 14); }
.about-emphasis { font-weight:600; }
.about-juice { display:flex; align-items:flex-end; gap:16px; margin-top:26px; }
.about-juice-image { display:block; flex:none; width:150px; height:188px; }
.about-risk { margin-top:26px; padding:18px 18px 18px 16px; border-left:3px solid var(--q-amber); background:var(--q-sand); }
.about-risk-heading { margin-bottom:8px; color:var(--q-amber); font-size:calc(16px * var(--about-font-scale,1)); font-weight:600; line-height:1.85; }
.about-risk-paragraph + .about-risk-paragraph { margin-top:8px; }
.about-latest { margin-top:26px; padding:16px 18px 6px; border:1px solid var(--q-ink); }
.about-latest-meta { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:6px 12px; color:var(--q-ink-2); font-size:calc(14px * var(--about-font-scale,1)); line-height:1.6; }
.about-latest-status { display:inline-flex; align-items:center; min-height:26px; padding:0 8px; border:1px solid var(--q-ink-2); color:var(--q-ink); }
.about-latest-date { margin-top:10px; font-family:var(--q-num); font-size:calc(36px * var(--about-font-scale,1)); font-weight:600; line-height:1.15; }
.about-latest-date-text { margin-top:10px; font-size:calc(20px * var(--about-font-scale,1)); font-weight:500; line-height:1.5; }
.about-latest-place { margin-top:6px; font-size:calc(15px * var(--about-font-scale,1)); line-height:1.7; }
.about-page .about-latest-link { display:flex; align-items:center; justify-content:flex-end; width:100%; min-height:44px; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:var(--q-moss); font-size:calc(15px * var(--about-font-scale,1)); font-weight:500; }
.about-latest-link::after { border:0; }
.about-endnote { margin:40px var(--q-gutter) 0; font-size:calc(22px * var(--about-font-scale,1)); line-height:1.7; white-space:pre-line; }
.about-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.5fr); gap:10px; margin:24px var(--q-gutter) 0; }
.about-actions button { box-sizing:border-box; display:flex; align-items:center; justify-content:center; width:100%; min-height:var(--q-btn-h); margin:0; padding:10px 12px; border:1px solid var(--q-ink); border-radius:0; background:transparent; color:var(--q-ink); font-family:var(--q-sans); font-size:calc(16px * var(--about-font-scale,1)); font-weight:500; line-height:1.6; }
.about-actions button::after { border:0; }
.about-actions .about-primary { border-color:var(--q-forest); background:var(--q-forest); color:var(--q-on-dark); }
@media(max-width:350px) { .about-page { --q-gutter:20px; } .about-glyph-char { font-size:50px; } .about-photo-slot { min-height:180px; padding:18px; } .about-person-quote { padding-left:14px; } }
