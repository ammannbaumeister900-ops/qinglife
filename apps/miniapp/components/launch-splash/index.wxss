.launch-splash {
  position: fixed;
  z-index: 9999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(155deg, rgba(255, 250, 236, 0.7) 0%, rgba(255, 250, 236, 0) 50%),
    radial-gradient(circle at 88% 10%, rgba(216, 193, 173, 0.35), transparent 34%),
    radial-gradient(circle at 6% 78%, rgba(166, 182, 162, 0.22), transparent 36%),
    #F6F1E8;
  opacity: 1;
  transition: opacity 260ms ease;
}

.launch-splash.leaving {
  opacity: 0;
}

.launch-mist {
  position: absolute;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(183, 131, 105, 0.2) 0%, rgba(224, 232, 224, 0.14) 46%, rgba(246, 241, 232, 0) 72%);
  animation: launch-breathe 900ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.launch-brand {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #26231F;
}

.page-loader {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-loader-dots {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 34rpx;
}

.page-loader-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #B78369;
  animation: page-loader-breathe 780ms ease-in-out infinite alternate;
}

.page-loader-dot.dot-two {
  background: #A6B6A2;
  animation-delay: 130ms;
}

.page-loader-dot.dot-three {
  background: #9EB5BA;
  animation-delay: 260ms;
}

.page-loader-copy {
  margin-top: 18rpx;
  color: #A85B3A;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.launch-mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(168, 91, 58, 0.8);
  border-radius: 20rpx 26rpx 22rpx 28rpx;
  background: rgba(255, 252, 247, 0.48);
  color: #A85B3A;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 252, 247, 0.82);
  transform: rotate(-4deg);
}

.launch-name {
  margin-top: 34rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 18rpx;
}

.launch-copy {
  margin-top: 16rpx;
  color: #A85B3A;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

@keyframes launch-breathe {
  0% {
    opacity: 0;
    transform: scale(0.90);
  }
  58% {
    opacity: 1;
    transform: scale(1.06);
  }
  100% {
    opacity: 0.78;
    transform: scale(1);
  }
}

@keyframes page-loader-breathe {
  from {
    opacity: 0.36;
    transform: translateY(4rpx) scale(0.88);
  }
  to {
    opacity: 1;
    transform: translateY(-4rpx) scale(1.08);
  }
}

@media (prefers-reduced-motion: reduce) {
  .launch-mist {
    animation: none;
  }

  .page-loader-dot {
    animation: none;
  }
}
