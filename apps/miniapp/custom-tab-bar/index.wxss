@import "../styles/qing-tokens.wxss";

.tabbar {
  position: fixed;
  z-index: 99;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 118rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid var(--q-line);
  background: var(--q-linen);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--q-ink-2);
  transition: color 220ms ease, transform 220ms ease;
}

.tab-item.active {
  color: var(--q-ink);
  font-weight: 600;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.82;
  transition: opacity 220ms ease;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-item {
    transition: none;
  }
}

