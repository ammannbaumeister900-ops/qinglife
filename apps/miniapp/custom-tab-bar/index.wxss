.tabbar {
  position: fixed;
  z-index: 99;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 118rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(74, 61, 49, 0.09);
  border-radius: 28rpx 28rpx 0 0;
  background: rgba(246, 241, 232, 0.94);
  box-shadow: 0 -14rpx 40rpx rgba(70, 52, 36, 0.07);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9A938A;
  transition: color 220ms ease, transform 220ms ease;
}

.tab-item.active {
  color: #26231F;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.82;
  transition: opacity 220ms ease;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.selected-mark {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #A85B3A;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-item {
    transition: none;
  }
}
