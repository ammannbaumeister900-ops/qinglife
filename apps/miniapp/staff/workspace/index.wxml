<view class="workspace"><view wx:if="{{loading}}" class="note">正在读取…</view><view wx:if="{{error}}" class="card">{{error}}<button bindtap="refresh">重试</button></view><block wx:if="{{me && !error}}">
<block wx:if="{{view==='desk' || view==='sessions'}}"><view class="heading">{{view==='desk'?'从一件小事开始。':'当前期次'}}</view><input wx:if="{{view==='desk'}}" placeholder="搜索姓名、小名（称呼）或手机号" bindinput="search"/><view wx:for="{{suggestions}}" wx:key="id" class="card" data-view="profile" data-id="{{item.id}}" bindtap="go">{{item.nickname}} · {{item.realName}}<view>{{item.phone}}</view></view><view wx:if="{{searchQuery&&searchEmpty}}" class="note">暂无匹配轻友，请调整姓名、称呼或手机号</view><view class="row"><text>当前轻体营</text><text data-view="history" bindtap="go">历史期次 ›</text></view><view wx:for="{{sessions}}" wx:key="id" class="card"><view class="title">{{item.name}}</view><view>{{item.startDate}} — {{item.endDate}}</view><view>{{item.city}} · 导游 {{item.leaderName}}</view><view class="counts"><view data-view="roster" data-id="{{item.id}}" bindtap="go"><text>{{allCount}}</text>全部报名人次</view><view data-view="roster" data-id="{{item.id}}" data-filter="pending" bindtap="go"><text>{{pendingCount}}</text>待确认人次</view><view wx:if="{{canPayment}}" data-view="roster" data-id="{{item.id}}" data-filter="unpaid" bindtap="go"><text>{{unpaidCount}}</text>待收款人次</view></view></view><view wx:if="{{!sessions.length}}" class="note">暂无报名或开课中的期次</view><block wx:if="{{view==='sessions'}}"><view class="row"><text>本期名单</text><text wx:if="{{canOperate && sessions.length}}" data-view="enroll" bindtap="go">＋ 人工报名</text></view><view wx:for="{{roster}}" wx:key="id" class="card"><view data-view="profile" data-id="{{item.customerId}}" bindtap="go">{{item.nickname}} · {{item.realName}} ›</view><view>{{item.statusText}} · {{item.paymentText}}</view><button data-view="registration" data-id="{{item.id}}" bindtap="go">查看报名</button></view></block><view wx:if="{{view==='desk'}}" class="row"><text>最近回访</text><text data-view="interviews" bindtap="go">全部记录 ›</text></view></block>
<block wx:if="{{view==='people'}}"><view class="heading">轻友</view><input placeholder="姓名、小名或手机号" bindinput="search"/><view wx:for="{{searchQuery?suggestions:people}}" wx:key="id" class="card" data-view="profile" data-id="{{item.id}}" bindtap="go"><view class="title">{{item.nickname}} · {{item.realName}}</view>{{item.phone}} · {{item.city}}</view><button wx:if="{{canOperate}}" class="primary" data-view="customer-new" bindtap="go">新增轻友</button></block>
<block wx:if="{{view==='profile'}}"><view class="heading">{{profile.nickname}}</view><view class="card">姓名 {{profile.realName}}<view>手机号 {{profile.phone}}</view><view>出生年月 {{profile.birthMonth || '未填写'}}</view><view>推荐人来源 {{profile.referralSource || '未填写'}}</view></view><view class="tabs"><text data-tab="timeline" bindtap="setTab">时间线</text><text data-tab="activities" bindtap="setTab">活动</text><text data-tab="passes" bindtap="setTab">卡次</text></view><block wx:if="{{tab==='activities'}}"><view wx:for="{{profile.activities}}" wx:key="id" class="card">第{{item.sessionNumber}}期 · {{item.sessionName}}<view>{{item.startDate}} — {{item.endDate}}</view><view>{{item.statusText}} · {{item.sessionStatus==='completed'?'期次已结束':''}}</view><button data-view="registration" data-id="{{item.id}}" bindtap="go">查看报名</button></view></block><block wx:if="{{tab==='passes'}}"><view wx:for="{{profile.passes}}" wx:key="id" class="card">{{item.passType}} · {{item.balance}}次<view>{{item.status}}</view></view><view class="note">卡次消耗规则待确认，暂不开放移动扣次。</view></block><view class="actions"><button wx:if="{{canOperate}}" data-view="enroll" data-id="{{profile.id}}" bindtap="go">新增报名</button><button class="primary" data-view="interview" data-id="{{profile.id}}" bindtap="go">新增回访</button></view></block>
<block wx:if="{{view==='desk'||view==='interviews'||(view==='profile'&&tab==='timeline')}}"><view wx:for="{{interviews}}" wx:key="id" class="card"><view data-view="profile" data-id="{{item.customerId}}" bindtap="go">{{item.nickname}} ›</view><view>回访人 {{item.operatorName}} · {{item.createdAt}}</view><text class="content">{{item.content}}</text><view class="photos"><button wx:for="{{item.images}}" wx:for-item="im" wx:key="id" data-id="{{im.id}}" bindtap="preview">查看图片 {{index+1}}</button></view></view><view wx:if="{{!interviews.length}}" class="note">暂无回访记录</view><button wx:if="{{view!=='profile'}}" class="primary" data-view="interview" bindtap="go">新增回访</button></block>
<block wx:if="{{view==='history'}}"><view class="heading">历史期次</view><view wx:for="{{sessions}}" wx:key="id" class="card" data-view="roster" data-id="{{item.id}}" bindtap="go">{{item.name}}<view>{{item.startDate}} — {{item.endDate}}</view>查看名单 ›</view></block>
<block wx:if="{{view==='roster'}}"><view class="heading">本期名单</view><view wx:for="{{rows}}" wx:key="id" class="card"><view data-view="profile" data-id="{{item.customerId}}" bindtap="go">{{item.nickname}} · {{item.realName}} ›</view>{{item.statusText}} · {{item.paymentText}}<button data-view="registration" data-id="{{item.id}}" bindtap="go">查看报名</button></view></block>
<block wx:if="{{view==='customer-new'}}"><view class="heading">新增轻友</view><text>称呼</text><input data-key="nickname" bindinput="field"/><text>姓名</text><input data-key="realName" bindinput="field"/><text>出生年月</text><picker mode="date" fields="month" data-key="birthMonth" bindchange="field"><view class="card">{{form.birthMonth||'选择年月'}}</view></picker><text>推荐人来源（选填）</text><input data-key="referralSource" bindinput="field"/><text>城市</text><input value="{{form.city}}" data-key="city" bindinput="field"/><button loading="{{saving}}" disabled="{{saving}}" class="primary" bindtap="saveCustomer">保存档案</button></block>
<block wx:if="{{view==='interview'||view==='enroll'}}"><view class="heading">{{view==='interview'?'新增回访':'人工报名'}}</view><picker range="{{people}}" range-key="nickname" value="{{personIndex||0}}" bindchange="selectPerson"><view class="card">选择轻友：{{people[personIndex||0].nickname}}</view></picker><block wx:if="{{view==='interview'}}"><view class="note">回访人：{{me.name}} · 时间自动记录</view><textarea placeholder="本次访谈的评价与感受" maxlength="3000" data-key="content" bindinput="field"/><view class="photos"><view wx:for="{{images}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill"/><text data-index="{{index}}" bindtap="removeImage">移除</text></view></view><button wx:if="{{images.length<6}}" bindtap="chooseImages">添加图片（最多6张、合计2MB）</button><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveInterview">保存回访记录</button></block><block wx:else><picker range="{{sessions}}" range-key="name" bindchange="selectSession"><view class="card">{{sessions[sessionIndex||0].name||'暂无可报名期次'}}</view></picker><button class="primary" disabled="{{saving||!selectedSession}}" loading="{{saving}}" bindtap="enroll">提交报名</button></block></block>
<block wx:if="{{view==='registration'||view==='payment'}}"><view class="heading">报名与收款</view><view class="card">{{registration.nickname}}<view>报名状态 {{registration.statusText}}</view><view>收款状态 {{registration.paymentText}}</view><view wx:if="{{registration.batchId}}">多人订单：本次收款登记整单，参与人数 {{registration.participantCount}}，整单应收 {{registration.payableAmount}}</view><view wx:if="{{canOperate||canPayment}}">本次价格 ¥{{registration.standardPrice}}</view></view><block wx:if="{{view==='registration'}}"><button wx:if="{{canOperate&&registration.registrationStatus==='pending'}}" bindtap="confirm">确认报名</button><button wx:if="{{canPayment&&registration.registrationStatus==='confirmed'&&registration.paymentStatus!=='paid'}}" data-view="payment" data-id="{{id}}" bindtap="go">登记线下收款</button><view wx:for="{{attendance}}" wx:key="dayId" class="card">第{{item.dayNo}}天 · {{item.activityDate}}<view>{{item.attendanceStatus==='checked_in'?'已到场':item.attendanceStatus==='not_arrived'?'未到场':item.attendanceStatus}}</view><button wx:if="{{item.isToday&&item.attendanceStatus==='not_arrived'&&registration.registrationStatus==='confirmed'}}" data-id="{{item.dayId}}" bindtap="arrive">登记当天到场</button></view><view wx:if="{{canOperate&&registration.registrationStatus!=='cancelled'&&registration.paymentStatus==='unpaid'&&!registration.batchId}}" class="actions"><button bindtap="cancel">取消报名</button></view><view wx:if="{{canOperate&&registration.registrationStatus!=='cancelled'&&!(registration.paymentStatus==='unpaid'&&!registration.batchId)}}" class="note">如需调整，请先在后台退款或撤销付款，再另外报名。</view></block><block wx:else><input type="digit" placeholder="实际收到的金额（元）" data-key="amount" bindinput="field"/><picker range="{{paymentMethods}}" value="{{paymentMethodIndex}}" bindchange="selectPaymentMethod"><view class="card">收款方式：{{paymentMethods[paymentMethodIndex]}}</view></picker><input data-key="paymentRemark" bindinput="field" maxlength="300" placeholder="备注（选填）"/><view class="note">仅登记已收到的线下款项，不发起支付。移动端仅支持足额结清。</view><button class="primary" loading="{{saving}}" bindtap="pay">核对并登记</button></block></block>
<block wx:if="{{view==='identity'}}"><view class="heading">我的工作身份</view><view class="card">{{me.name}}<view>工作账号已启用</view></view><button bindtap="returnMine">返回轻友端</button></block>
<view wx:if="{{view==='desk'||view==='people'||view==='sessions'||view==='identity'}}" class="staff-nav"><text data-view="desk" bindtap="root">工作台</text><text data-view="people" bindtap="root">轻友</text><text data-view="sessions" bindtap="root">期次</text><text data-view="identity" bindtap="root">我的</text></view></block></view>
