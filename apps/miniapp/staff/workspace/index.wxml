<view class="workspace">
  <view wx:if="{{loading}}" class="empty">正在读取…</view>
  <view wx:if="{{error}}" class="card">
    <view class="empty">
      <view class="empty-title">暂时无法读取</view>
      <view class="note">{{error}}</view>
      <button class="primary retry" bindtap="refresh">重试</button>
    </view>
  </view>
  <block wx:if="{{me && !error}}">

  <block wx:if="{{view==='desk' || view==='sessions'}}">
    <view wx:if="{{view==='desk'}}" class="identity-line"><text class="tag">{{me.name}} · 工作人员</text></view>
    <view class="heading">{{view==='desk'?'从一件小事开始。':'当前期次'}}</view>
    <view wx:if="{{view==='desk'}}" class="note today">今天是 {{today}}</view>
    <input wx:if="{{view==='desk'}}" class="search" placeholder="搜索姓名、小名（称呼）或手机号" bindinput="search"/>
    <block wx:if="{{view==='desk' && searchQuery}}">
      <view wx:if="{{suggestions.length}}" class="note suggest-label">可能匹配的轻友 · {{suggestions.length}} 位</view>
      <view wx:for="{{suggestions}}" wx:key="id" class="card person-card" data-view="profile" data-id="{{item.id}}" bindtap="go">
        <view class="avatar">{{item.avatar}}</view>
        <view class="grow"><view class="title">{{item.nickname}} · {{item.realName}}</view><view class="sub">{{item.phone}}</view></view>
        <text class="arrow">›</text>
      </view>
      <view wx:if="{{searchEmpty}}" class="note">暂无匹配轻友，请调整姓名、称呼或手机号</view>
    </block>
    <view class="section"><text class="section-title">当前轻体营</text><text class="section-link" data-view="history" bindtap="go">历史期次 ›</text></view>
    <view wx:for="{{sessions}}" wx:key="id" class="card session-card">
      <text class="tag">当前服务期次</text>
      <view class="title session-title">{{item.name}}</view>
      <view class="sub">{{item.startDate}} — {{item.endDate}}</view>
      <view class="sub">{{item.city}} · 导游 {{item.leaderName}}</view>
      <view class="counts">
        <view data-view="roster" data-id="{{item.id}}" bindtap="go"><text>{{item.allCount}}</text>全部报名人次 ›</view>
        <view data-view="roster" data-id="{{item.id}}" data-filter="pending" bindtap="go"><text>{{item.pendingCount}}</text>待确认人次 ›</view>
        <view wx:if="{{canPayment}}" data-view="roster" data-id="{{item.id}}" data-filter="unpaid" bindtap="go"><text>{{item.unpaidCount}}</text>待收款人次 ›</view>
      </view>
    </view>
    <view wx:if="{{!sessions.length}}" class="empty">暂无报名或开课中的期次</view>
    <block wx:if="{{view==='sessions'}}">
      <view class="section"><text class="section-title">本期名单</text><text wx:if="{{canOperate && sessions.length}}" class="section-link" data-view="enroll" bindtap="go">＋ 人工报名</text></view>
      <view wx:for="{{roster}}" wx:key="id" class="card">
        <view class="row between"><view class="link" data-view="profile" data-id="{{item.customerId}}" bindtap="go">{{item.nickname}} · {{item.realName}} ›</view><text class="tag {{item.registrationStatus==='pending'?'warm':''}}">{{item.statusText}}</text></view>
        <view class="sub">收款状态 {{item.paymentText}}</view>
        <button class="secondary small" data-view="registration" data-id="{{item.id}}" bindtap="go">查看报名</button>
      </view>
      <view wx:if="{{!roster.length}}" class="empty">本期暂无报名</view>
    </block>
    <view wx:if="{{view==='desk'}}" class="section"><text class="section-title">最近回访</text><text class="section-link" data-view="interviews" bindtap="go">全部记录 ›</text></view>
  </block>

  <block wx:if="{{view==='people'}}">
    <view class="heading">找到熟悉的人。</view>
    <input class="search" placeholder="姓名、小名或手机号" bindinput="search"/>
    <view wx:for="{{searchQuery?suggestions:people}}" wx:key="id" class="card person-card" data-view="profile" data-id="{{item.id}}" bindtap="go">
      <view class="avatar">{{item.avatar}}</view>
      <view class="grow"><view class="title">{{item.nickname}} · {{item.realName}}</view><view class="sub">{{item.phone}} · {{item.city}}</view></view>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{searchQuery && searchEmpty}}" class="empty">暂无匹配轻友，请调整姓名、称呼或手机号</view>
    <view wx:if="{{!searchQuery && !people.length}}" class="empty">暂无轻友档案</view>
    <button wx:if="{{canOperate}}" class="primary" data-view="customer-new" bindtap="go">＋ 新增轻友</button>
  </block>

  <block wx:if="{{view==='profile'}}">
    <view class="profile-head">
      <view class="avatar large">{{profileAvatar}}</view>
      <view class="grow">
        <view class="heading profile-name">{{profile.nickname}}</view>
        <view class="sub">{{profile.phone}}<text wx:if="{{profile.city}}"> · {{profile.city}}</text></view>
      </view>
    </view>
    <view class="card">
      <view class="kv"><text class="kv-k">姓名</text><text class="kv-v">{{profile.realName || '未填写'}}</text></view>
      <view class="kv"><text class="kv-k">手机号</text><text class="kv-v">{{profile.phone || '未填写'}}</text></view>
      <view class="kv"><text class="kv-k">出生年月</text><text class="kv-v">{{profile.birthMonth || '未填写'}}</text></view>
      <view class="kv"><text class="kv-k">推荐人来源</text><text class="kv-v">{{profile.referralSource || '未填写'}}</text></view>
    </view>
    <view class="tabs chips">
      <text class="chip {{tab==='timeline'?'selected':''}}" data-tab="timeline" bindtap="setTab">时间线</text>
      <text class="chip {{tab==='activities'?'selected':''}}" data-tab="activities" bindtap="setTab">活动</text>
      <text class="chip {{tab==='passes'?'selected':''}}" data-tab="passes" bindtap="setTab">卡次</text>
      <text class="chip {{tab==='attachments'?'selected':''}}" data-tab="attachments" bindtap="setTab">附件</text>
    </view>
    <block wx:if="{{tab==='activities'}}">
      <view wx:for="{{profile.activities}}" wx:key="id" class="card">
        <view class="row between"><view class="title">第{{item.sessionNumber}}期 · {{item.sessionName}}</view><text class="tag {{item.registrationStatus==='pending'?'warm':''}}">{{item.statusText}}</text></view>
        <view class="sub">{{item.startDate}} — {{item.endDate}}</view>
        <view wx:if="{{item.sessionStatus==='completed'}}" class="sub">期次已结束</view>
        <button class="secondary small" data-view="registration" data-id="{{item.id}}" bindtap="go">查看报名</button>
      </view>
      <view wx:if="{{!profile.activities.length}}" class="empty">暂无活动或报名记录</view>
    </block>
    <block wx:if="{{tab==='passes'}}">
      <view wx:for="{{profile.passes}}" wx:key="id" class="card">
        <view class="row between"><view class="title">{{item.passType}}</view><text class="money">{{item.balance}} 次</text></view>
        <view class="sub">{{item.status}}</view>
      </view>
      <view wx:if="{{!profile.passes.length}}" class="empty">暂无卡次账户</view>
      <view class="notice">卡次开户、增次和更正请在电脑后台处理；报名结算时可选择已核验的可用账户。</view>
    </block>
    <block wx:if="{{tab==='attachments'}}">
      <view wx:for="{{attachments}}" wx:key="id" class="card">
        <view class="sub">回访图片 · {{item.operatorName}} · {{item.createdAt}}</view>
        <button class="secondary small" data-id="{{item.id}}" bindtap="preview">查看图片</button>
      </view>
      <view wx:if="{{!attachments.length}}" class="empty">暂无附件或图片</view>
    </block>
    <view class="actions"><button wx:if="{{canOperate}}" data-view="enroll" data-id="{{profile.id}}" bindtap="go">新增报名</button><button class="primary" data-view="interview" data-id="{{profile.id}}" bindtap="go">新增回访</button></view>
  </block>

  <block wx:if="{{view==='desk'||view==='interviews'||(view==='profile'&&tab==='timeline')}}">
    <view wx:if="{{view==='interviews'}}" class="heading">每一次认真倾听。</view>
    <view wx:for="{{interviews}}" wx:key="id" class="card interview-card">
      <view class="link" data-view="profile" data-id="{{item.customerId}}" bindtap="go">{{item.nickname}} ›</view>
      <view class="sub">回访人 {{item.operatorName}} · {{item.createdAt}}</view>
      <text class="content">{{item.content}}</text>
      <view class="photos"><button wx:for="{{item.images}}" wx:for-item="im" wx:key="id" class="photo-btn" data-id="{{im.id}}" bindtap="preview">查看图片 {{index+1}}</button></view>
    </view>
    <view wx:if="{{!interviews.length}}" class="empty">暂无回访记录</view>
    <button wx:if="{{view!=='profile'}}" class="primary" data-view="interview" bindtap="go">＋ 新增回访</button>
  </block>

  <block wx:if="{{view==='history'}}">
    <view class="heading">过去的相聚。</view>
    <view class="note">已结束期次与参与名单</view>
    <view wx:for="{{sessions}}" wx:key="id" class="card" data-view="roster" data-id="{{item.id}}" bindtap="go">
      <view class="row between"><view class="title">{{item.name}}</view><text class="arrow">›</text></view>
      <view class="sub">{{item.startDate}} — {{item.endDate}}</view>
      <view class="sub">查看名单 ›</view>
    </view>
    <view wx:if="{{!sessions.length}}" class="empty">暂无历史期次</view>
  </block>

  <block wx:if="{{view==='roster'}}">
    <view class="heading">本期名单</view>
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view class="row between"><view class="link" data-view="profile" data-id="{{item.customerId}}" bindtap="go">{{item.nickname}} · {{item.realName}} ›</view><text class="tag {{item.registrationStatus==='pending'?'warm':''}}">{{item.statusText}}</text></view>
      <view class="sub">收款状态 {{item.paymentText}}</view>
      <button class="secondary small" data-view="registration" data-id="{{item.id}}" bindtap="go">查看报名</button>
    </view>
    <view wx:if="{{!rows.length}}" class="empty">暂无符合条件的报名</view>
  </block>

  <block wx:if="{{view==='customer-new'}}">
    <view class="heading">新增轻友</view>
    <view class="notice">先搜索已有轻友，避免重复建档。同名或同手机号不自动合并。</view>
    <text class="label">称呼</text>
    <input data-key="nickname" bindinput="field"/>
    <text class="label">姓名</text>
    <input data-key="realName" bindinput="field"/>
    <text class="label">出生年月</text>
    <picker mode="date" fields="month" data-key="birthMonth" bindchange="field"><view class="card picker-card">{{form.birthMonth||'选择年月'}}</view></picker>
    <text class="label">推荐人来源（选填）</text>
    <input data-key="referralSource" bindinput="field"/>
    <text class="label">城市</text>
    <input value="{{form.city}}" data-key="city" bindinput="field"/>
    <button loading="{{saving}}" disabled="{{saving}}" class="primary" bindtap="saveCustomer">保存档案</button>
  </block>

  <block wx:if="{{view==='interview'||view==='enroll'}}">
    <view class="heading">{{view==='interview'?'新增回访':'人工报名'}}</view>
    <view wx:if="{{view==='enroll'}}" class="notice">选择参与人 → 核对期次 → 提交报名</view>
    <text class="label">选择轻友</text>
    <picker range="{{people}}" range-key="nickname" value="{{personIndex||0}}" bindchange="selectPerson"><view class="card picker-card">选择轻友：{{people[personIndex||0].nickname}}</view></picker>
    <block wx:if="{{view==='interview'}}">
      <view class="note">回访人：{{me.name}} · 时间自动记录</view>
      <text class="label">本次评价与感受</text>
      <textarea placeholder="记录这次访谈了解到的情况、评价与感受" maxlength="3000" data-key="content" bindinput="field"/>
      <view class="photos"><view wx:for="{{images}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill"/><text data-index="{{index}}" bindtap="removeImage">移除</text></view></view>
      <button wx:if="{{images.length<6}}" class="secondary" bindtap="chooseImages">添加图片（最多6张、合计2MB）</button>
      <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveInterview">保存回访记录</button>
    </block>
    <block wx:else>
      <text class="label">报名期次</text>
      <picker range="{{sessions}}" range-key="name" bindchange="selectSession"><view class="card picker-card">{{sessions[sessionIndex||0].name||'暂无可报名期次'}}</view></picker>
      <button class="primary" disabled="{{saving||!selectedSession}}" loading="{{saving}}" bindtap="enroll">核对并提交</button>
    </block>
  </block>

  <block wx:if="{{view==='registration'||view==='payment'||view==='settlement'}}">
    <view class="heading">报名与收款</view>
    <view class="card">
      <view class="row between"><view class="title">{{registration.nickname}}</view><text class="tag {{registration.registrationStatus==='pending'?'warm':''}}">{{registration.statusText}}</text></view>
      <view class="kv"><text class="kv-k">报名状态</text><text class="kv-v">{{registration.statusText}}</text></view>
      <view class="kv"><text class="kv-k">收款状态</text><text class="kv-v">{{registration.paymentText}}</text></view>
      <view wx:if="{{registration.contactName}}" class="kv"><text class="kv-k">主要联系人</text><text class="kv-v">{{registration.contactName}} · {{registration.contactPhone}}</text></view>
      <view class="kv"><text class="kv-k">最终结算</text><text class="kv-v">{{registration.settlementStatus==='confirmed' ? '已确认 ¥' + registration.finalAmount : '待工作人员确认'}}</text></view>
      <view class="kv"><text class="kv-k">到场状态</text><text class="kv-v">{{attendanceText}}</text></view>
      <view wx:if="{{registration.batchId}}" class="kv"><text class="kv-k">多人订单</text><text class="kv-v">本次操作覆盖整单，参与人数 {{registration.participantCount}}</text></view>
      <view wx:if="{{canOperate||canPayment}}" class="kv"><text class="kv-k">参考价格</text><text class="kv-v">¥{{registration.quotedAmount == null ? registration.standardPrice : registration.quotedAmount}}</text></view>
    </view>
    <view class="notice">报名确认、收款和到场分别记录。</view>
    <block wx:if="{{view==='registration'}}">
      <button wx:if="{{canOperate&&registration.registrationStatus==='pending'}}" class="primary" bindtap="confirm">确认报名</button>
      <button wx:if="{{canPayment&&registration.registrationStatus==='confirmed'&&registration.paymentStatus!=='paid'}}" class="secondary" data-view="settlement" data-id="{{id}}" bindtap="go">{{registration.settlementStatus==='confirmed'?'调整最终结算':'确认最终结算'}}</button>
      <button wx:if="{{canPayment&&registration.registrationStatus==='confirmed'&&registration.settlementStatus==='confirmed'&&registration.paymentStatus!=='paid'&&registration.finalAmount>0}}" class="primary" data-view="payment" data-id="{{id}}" bindtap="go">登记线下收款</button>
      <view wx:for="{{attendance}}" wx:key="dayId" class="card">
        <view class="row between"><view>第{{item.dayNo}}天 · {{item.activityDate}}</view><text class="tag {{item.attendanceStatus==='checked_in'?'':'gray'}}">{{item.attendanceStatus==='checked_in'?'已到场':item.attendanceStatus==='not_arrived'?'未到场':item.attendanceStatus}}</text></view>
        <button wx:if="{{item.isToday&&item.attendanceStatus==='not_arrived'&&registration.registrationStatus==='confirmed'}}" class="secondary small" data-id="{{item.dayId}}" bindtap="arrive">登记当天到场</button>
      </view>
      <view wx:if="{{canOperate&&registration.registrationStatus!=='cancelled'&&registration.paymentStatus==='unpaid'&&!registration.batchId}}" class="actions"><button class="danger" bindtap="cancel">取消报名</button></view>
      <view wx:if="{{canOperate&&registration.registrationStatus!=='cancelled'&&!(registration.paymentStatus==='unpaid'&&!registration.batchId)}}" class="notice">如需调整，请先在后台退款或撤销付款，再另外报名。</view>
    </block>
    <block wx:elif="{{view==='settlement'}}">
      <text class="label">结算方式</text><picker range="{{settlementTypes}}" value="{{settlementTypeIndex}}" bindchange="selectSettlementType"><view class="card picker-card">{{settlementTypes[settlementTypeIndex]}}</view></picker>
      <text class="label">最终现金金额（元，可填0）</text><input type="digit" value="{{form.finalAmount}}" data-key="finalAmount" bindinput="field"/>
      <block wx:if="{{settlementValues[settlementTypeIndex]==='pass'}}"><text class="label">卡次账户</text><picker range="{{passAccounts}}" range-key="passType" value="{{passAccountIndex}}" bindchange="selectPassAccount"><view class="card picker-card">{{passAccounts.length ? passAccounts[passAccountIndex].passType + ' · 剩余' + passAccounts[passAccountIndex].balance + '次' : '暂无可用账户，请先到电脑后台核验'}}</view></picker><text class="label">使用卡次</text><input type="number" value="{{form.passUnits}}" data-key="passUnits" bindinput="field"/></block>
      <text class="label">核对说明（选填）</text><input value="{{form.settlementNote}}" data-key="settlementNote" bindinput="field" maxlength="500"/>
      <view class="notice">确认结算不会把报名自动改为已付款。</view><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="settle">确认结算结果</button>
    </block>
    <block wx:else>
      <text class="label">实收金额（元）</text>
      <input type="digit" placeholder="实际收到的金额（元）" data-key="amount" bindinput="field"/>
      <text class="label">收款方式</text>
      <picker range="{{paymentMethods}}" value="{{paymentMethodIndex}}" bindchange="selectPaymentMethod"><view class="card picker-card">收款方式：{{paymentMethods[paymentMethodIndex]}}</view></picker>
      <text class="label">备注（选填）</text>
      <input data-key="paymentRemark" bindinput="field" maxlength="300" placeholder="记录必要的收款说明"/>
      <view class="notice">仅登记已收到的线下款项，不发起支付。移动端仅支持足额结清。</view>
      <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="pay">核对并登记</button>
    </block>
  </block>

  <block wx:if="{{view==='identity'}}">
    <view class="heading">我的工作身份</view>
    <view class="card identity-card">
      <view class="avatar large">{{meAvatar}}</view>
      <view class="grow">
        <view class="title">{{me.name}}</view>
        <text class="tag">工作账号已启用</text>
      </view>
    </view>
    <button class="secondary" bindtap="returnMine">返回轻友端</button>
  </block>

  <view wx:if="{{view==='desk'||view==='people'||view==='sessions'||view==='identity'}}" class="staff-nav">
    <view class="nav-item {{view==='desk'?'active':''}}" data-view="desk" bindtap="root"><text class="nav-ico">⌂</text>工作台</view>
    <view class="nav-item {{view==='people'?'active':''}}" data-view="people" bindtap="root"><text class="nav-ico">♙</text>轻友</view>
    <view class="nav-item {{view==='sessions'?'active':''}}" data-view="sessions" bindtap="root"><text class="nav-ico">▤</text>期次</view>
    <view class="nav-item {{view==='identity'?'active':''}}" data-view="identity" bindtap="root"><text class="nav-ico">○</text>我的</view>
  </view>
  </block>
</view>
