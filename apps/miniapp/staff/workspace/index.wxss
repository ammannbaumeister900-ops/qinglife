page{background:#f6f1e8;color:#303831}.workspace{padding:32rpx 32rpx 170rpx;font-size:28rpx}.heading{font-size:44rpx;margin:20rpx 0 32rpx}.card{background:#fffcf7;border:1rpx solid #e6e1d7;padding:30rpx;border-radius:26rpx;margin:22rpx 0;line-height:1.9}.title{font-size:34rpx}.row,.tabs{display:flex;justify-content:space-between;margin:30rpx 0}.counts{display:flex;border-top:1rpx solid #e6e1d7;margin-top:24rpx;padding-top:22rpx}.counts view{flex:1;text-align:center;font-size:22rpx}.counts text{display:block;font-size:42rpx;color:#a85b3a}.note{color:#85867c;margin:24rpx 0}.primary{background:#a85b3a;color:white}button{font-size:28rpx;margin-top:20rpx;display:flex;align-items:center;justify-content:center;min-height:88rpx;line-height:1.5;border-radius:18rpx}input,textarea{background:#fffdf9;border:1rpx solid #e6e1d7;border-radius:18rpx;padding:24rpx;margin:16rpx 0 28rpx}textarea{width:auto;min-height:240rpx}.staff-nav{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:space-around;background:#fffcf7;padding:24rpx 0 calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e6e1d7}.photos{display:flex;flex-wrap:wrap;gap:14rpx}.photos image{width:160rpx;height:160rpx}.photos text{display:block}.content{white-space:pre-wrap}.actions{display:flex;gap:16rpx}.actions button{flex:1}
