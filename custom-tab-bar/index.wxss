.tabbar {
  position: fixed;
  z-index: 99;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(74, 61, 49, 0.08);
  background: rgba(248, 242, 232, 0.96);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8B837A;
  transition: color 220ms ease, transform 220ms ease;
}

.tab-item.active {
  color: #2C2A26;
  transform: translateY(-2rpx);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.selected-mark {
  position: absolute;
  top: 0;
  width: 42rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #2C2A26;
  opacity: 0.72;
}

.tab-text {
  margin-top: 2rpx;
  font-size: 21rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-item {
    transition: none;
  }
}

