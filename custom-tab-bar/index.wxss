.tabbar {
  position: fixed;
  z-index: 99;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(74, 61, 49, 0.08);
  background: rgba(248, 242, 232, 0.96);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8B837A;
}

.tab-item.active {
  color: #2C2A26;
}

.tab-icon {
  height: 42rpx;
  font-size: 32rpx;
  line-height: 42rpx;
}

.tab-text {
  margin-top: 2rpx;
  font-size: 21rpx;
}

