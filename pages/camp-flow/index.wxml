<launch-splash />
<view class="page camp-flow-page editorial-page">
  <block wx:if="{{view === 'detail'}}">
    <view class="hero">
      <view class="pill">第 {{activity.sessionNumber}} 期</view>
      <view class="hero-title">{{activity.name}}</view>
      <view class="hero-copy">{{activity.intro}}</view>
    </view>
    <view class="card sage">
      <view class="list-row"><view class="list-main"><text class="list-title">时间</text><text class="list-note">{{activity.date}} · 连续3天</text></view></view>
      <view class="list-row"><view class="list-main"><text class="list-title">地点</text><text class="list-note">{{activity.city}}{{activity.place}} · 完整地点报名后可见</text></view></view>
      <view class="list-row"><view class="list-main"><text class="list-title">带领人</text><text class="list-note">{{activity.leader}}</text></view></view>
      <view class="list-row"><view class="list-main"><text class="list-title">费用</text><text class="list-note">¥{{activity.fee}}/人</text></view></view>
    </view>
    <view class="card">
      <view class="card-title">三天的节奏</view>
      <view wx:for="{{activity.days}}" wx:key="id" class="list-row">
        <view class="pill">0{{index + 1}}</view>
        <view class="list-main"><text class="list-title">{{item.theme}}</text><text class="list-note">{{item.time}}</text></view>
      </view>
    </view>
    <view class="card lavender">
      <view class="card-title">取消与改期</view>
      <view class="card-copy">具体规则以报名确认信息为准。</view>
    </view>
    <button wx:if="{{state.registration.status === 'none'}}" class="primary" bindtap="startRegistration">开始报名</button>
    <button wx:else class="primary" bindtap="openJourney">查看我的活动</button>
  </block>

  <block wx:elif="{{view === 'register'}}">
    <view class="progress">
      <view class="progress-item active"></view>
      <view class="progress-item {{step >= 2 ? 'active' : ''}}"></view>
      <view class="progress-item {{step >= 3 ? 'active' : ''}}"></view>
    </view>

    <block wx:if="{{step === 1}}">
      <view class="hero"><view class="hero-title">这次，谁会一起参加？</view><view class="hero-copy">记录分别归属于每名实际参与者，而不是报名发起人。</view></view>
      <view class="card">
        <view wx:for="{{state.registration.participants}}" wx:key="id" class="check-row" data-id="{{item.id}}" bindtap="toggleParticipant">
          <checkbox checked="{{item.selected}}" color="#A6B6A2"/>
          <view class="list-main"><text class="list-title">{{item.name}} · {{item.relation}}</text><text class="list-note">{{item.minor ? '未成年人 · 关联主要联系人' : '成年人 · 本人手机号已关联'}}</text></view>
        </view>
      </view>
      <view class="privacy-note">成年人正式报名必须使用本人手机号；未成年人不要求手机号，但生成独立参与者记录。</view>
    </block>

    <block wx:elif="{{step === 2}}">
      <view class="hero"><view class="hero-title">这一次，你最期待什么？</view><view class="hero-copy">只选择当下最接近的一项，后续可以调整。</view></view>
      <view class="chips">
        <button wx:for="{{motivationOptions}}" wx:key="*this" class="chip {{state.registration.motivation === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseMotivation">{{item}}</button>
      </view>
    </block>

    <block wx:else>
      <view class="hero"><view class="hero-title">确认本次报名，信息由你掌握。</view><view class="hero-copy">本期不经过用户端支付状态。</view></view>
      <view class="card">
        <view class="check-row" data-key="serviceConsent" bindtap="toggleConsent"><checkbox checked="{{state.registration.serviceConsent}}" color="#A6B6A2"/><view class="list-main"><text class="list-title">服务必要信息（必选）</text><text class="list-note">用于报名、签到与履约。</text></view></view>
        <view class="check-row" data-key="operationConsent" bindtap="toggleConsent"><checkbox checked="{{state.operationConsent}}" color="#A6B6A2"/><view class="list-main"><text class="list-title">运营联系（选填）</text><text class="list-note">用于后续活动信息。</text></view></view>
        <view class="check-row" data-key="aiConsent" bindtap="toggleConsent"><checkbox checked="{{state.aiConsent}}" color="#A6B6A2"/><view class="list-main"><text class="list-title">个性化分析（选填）</text><text class="list-note">需单独授权。</text></view></view>
      </view>
      <view class="privacy-note">个人感受和“我的轻体验”默认仅自己可见。</view>
    </block>

    <view class="button-row">
      <button wx:if="{{step > 1}}" class="secondary" bindtap="previousStep">上一步</button>
      <button wx:if="{{step < 3}}" class="primary" bindtap="nextStep">继续</button>
      <button wx:else class="primary" bindtap="submitRegistration">提交报名</button>
    </view>
  </block>

  <block wx:elif="{{view === 'success'}}">
    <view class="card sage">
      <view class="hero-title">{{state.registration.status === 'pending' ? '报名已提交，等待运营确认。' : '报名已经确认，接下来安心准备。'}}</view>
      <view class="card-copy">共 {{selectedCount}} 位参与者。</view>
    </view>
    <view wx:if="{{state.registration.status === 'pending'}}" class="privacy-note">运营确认后将通知你。</view>
    <button wx:else class="primary" bindtap="openJourney">查看三日准备卡</button>
    <button class="text-button" bindtap="backToCamp">返回轻体营</button>
  </block>

  <block wx:elif="{{view === 'journey'}}">
    <view class="hero"><view class="hero-title">三天的体验，按自己的节奏慢慢走。</view><view class="hero-copy">每天分别准备和签到，状态互不覆盖。</view></view>
    <view wx:if="{{state.registration.status === 'pending'}}" class="card clay">
      <view class="card-title">等待运营确认</view><view class="card-copy">确认后即可进入签到。</view>
    </view>
    <view wx:for="{{dayViews}}" wx:key="id" class="card {{item.checked ? 'sage' : ''}}">
      <view class="pill">{{item.label}} · {{item.checked ? '已签到' : '待签到'}}</view>
      <view class="card-title">{{item.theme}}</view>
      <view class="card-copy">{{item.time}} · {{selectedCount}} 位参与者</view>
      <button wx:if="{{!item.checked && state.registration.status !== 'pending'}}" class="primary" data-id="{{item.id}}" bindtap="checkDay">确认本日到场</button>
    </view>
    <button wx:if="{{allChecked}}" class="primary" bindtap="openExperience">查看我的轻体验</button>
  </block>

  <block wx:else>
    <view class="hero"><view class="hero-title">这段体验，已经为你保存。</view><view class="hero-copy">它是个人回看，不是医学报告或效果结论。</view></view>
    <view class="card lavender">
      <view class="pill">仅自己可见</view>
      <view class="card-title">我慢慢发现，身体会用自己的方式回应。</view>
      <view class="card-copy">活动前后状态、个人感受和回访记录保存在本期经历中。</view>
    </view>
    <view class="privacy-note">这份私人体验不会自动进入轻友动态，也不会自动生成营销案例。</view>
    <button class="secondary" bindtap="backToCamp">返回轻体营</button>
  </block>
</view>
