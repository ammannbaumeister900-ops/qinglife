.code-row { display: flex; gap: 14rpx; }.code-input { flex: 1; }.code-button { width: 210rpx; margin: 0; border-radius: 28rpx; background: #E7EDE4; color: #52624F; font-size: 24rpx; }
.habit-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.habit-day { display: flex; min-height: 120rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 28rpx; background: #FFFCF7; }
.habit-day text { font-size: 30rpx; }.habit-day .habit-note { margin-top: 8rpx; color: #857D75; font-size: 20rpx; }.habit-day.completed { background: #E4EBE1; }.habit-day.current { outline: 3rpx solid #B78369; }

.experience-hero { background: radial-gradient(circle at 88% 12%, rgba(255,244,209,.72), transparent 22%), radial-gradient(ellipse at 96% 100%, rgba(112,139,102,.28), transparent 36%), linear-gradient(145deg, rgba(250,246,233,.96), rgba(220,229,211,.86)) !important; }
.experience-tabs { display: flex; gap: 12rpx; overflow-x: auto; margin: -8rpx 0 26rpx; padding: 8rpx 2rpx 12rpx; white-space: nowrap; }
.experience-tab { flex-shrink: 0; margin: 0; padding: 16rpx 24rpx; border: 1rpx solid rgba(74,61,49,.10); border-radius: 999rpx; background: rgba(255,252,247,.78); color: #756D65; font-size: 23rpx; line-height: 1.4; }
.experience-tab.active { border-color: rgba(103,128,95,.34); background: #E4EBDD; color: #455441; box-shadow: 0 8rpx 22rpx rgba(57,74,51,.08); }
.experience-summary { padding: 38rpx; background: radial-gradient(circle at 96% 4%, rgba(229,207,191,.52), transparent 32%), rgba(255,252,247,.88) !important; }
.experience-summary-top { display: flex; align-items: center; justify-content: space-between; }
.experience-accordion { overflow: hidden; border: 1rpx solid rgba(255,255,255,.68); border-radius: 38rpx; background: rgba(255,252,247,.82); box-shadow: 0 16rpx 44rpx rgba(70,52,36,.06); }
.experience-detail { padding: 0 30rpx; border-bottom: 1rpx solid rgba(74,61,49,.08); }
.experience-detail:last-child { border-bottom: none; }
.experience-detail.open { background: linear-gradient(135deg, rgba(233,239,229,.76), rgba(255,252,247,.74)); }
.experience-detail-head { display: flex; min-height: 112rpx; align-items: center; gap: 20rpx; }
.detail-index { color: #A57B64; font-family: serif; font-size: 20rpx; letter-spacing: 2rpx; }
.detail-toggle { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(74,61,49,.10); border-radius: 50%; color: #7C6B60; font-size: 28rpx; }
.experience-detail-body { margin: -4rpx 0 28rpx 50rpx; color: #746D65; font-size: 24rpx; line-height: 1.7; animation: detail-enter 180ms ease both; }
@keyframes detail-enter { from { opacity: 0; transform: translateY(-6rpx); } to { opacity: 1; transform: translateY(0); } }
