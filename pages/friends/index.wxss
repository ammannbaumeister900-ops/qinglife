.friend-actions { display: flex; justify-content: flex-end; margin-bottom: 40rpx; }
.archive-button, .action-button { margin: 0; background: transparent; color: #8C604A; font-size: 24rpx; }
.daily-strip { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; border-radius: 34rpx; background: #E8EDE5; }
.daily-index, .post-avatar { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 50%; background: #A6B6A2; color: #FFFCF7; }
.post-head { display: flex; align-items: center; gap: 18rpx; }
.post-content { padding: 28rpx 0; font-size: 29rpx; line-height: 1.75; }
.post-actions { display: flex; gap: 28rpx; border-top: 1rpx solid rgba(74,61,49,.08); padding-top: 18rpx; }
.action-button.active { color: #B78369; }
.comment-button { display: flex; align-items: center; gap: 10rpx; }
.comment-icon { position: relative; box-sizing: border-box; width: 28rpx; height: 22rpx; border: 2rpx solid currentColor; border-radius: 9rpx; }
.comment-icon::after { content: ''; position: absolute; left: 4rpx; bottom: -7rpx; width: 8rpx; height: 8rpx; border-left: 2rpx solid currentColor; transform: skew(-28deg); }
.comment-panel { margin-top: 20rpx; padding: 24rpx; border-radius: 28rpx; background: rgba(238,232,239,.62); animation: comment-enter 180ms ease both; }
.comment-row { display: flex; gap: 14rpx; padding: 12rpx 0; color: #655E57; font-size: 24rpx; line-height: 1.55; }
.comment-author { flex-shrink: 0; color: #8C604A; font-weight: 600; }
.comment-content { flex: 1; }
.comment-empty { padding: 10rpx 0 18rpx; color: #8A8178; font-size: 23rpx; }
.comment-compose { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.comment-input { box-sizing: border-box; height: 72rpx; flex: 1; padding: 0 22rpx; border: 1rpx solid rgba(74,61,49,.10); border-radius: 24rpx; background: rgba(255,252,247,.88); font-size: 24rpx; }
.comment-submit { min-width: 104rpx; height: 72rpx; margin: 0; padding: 0 20rpx; border-radius: 24rpx; background: #A9775E; color: #FFF9F3; font-size: 23rpx; line-height: 72rpx; }
@keyframes comment-enter { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
