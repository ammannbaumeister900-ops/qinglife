<launch-splash />
<view class="page mine-page editorial-page">
  <view class="profile-head">
    <view class="profile-avatar">{{avatarText}}</view>
    <view class="list-main">
      <view class="eyebrow">MY QING LIFE</view>
      <view class="profile-title">{{state.loggedIn ? state.profile.nickname + '，今天也慢慢来。' : '登录后，留下自己的轻生活。'}}</view>
      <view class="section-note">{{profileLine}}</view>
    </view>
  </view>

  <view wx:if="{{!state.phoneLinked}}" class="card clay">
    <view class="card-title">关联手机号</view><view class="card-copy">用于识别报名、保护私人记录，并开放社区发布能力。</view>
    <button class="primary" data-view="auth" bindtap="openFlow">登录并关联</button>
  </view>

  <view class="section-head timeline-head"><view><view class="eyebrow">MY JOURNEY</view><view class="section-title">我与轻生活的相遇</view></view><view class="section-note">按参与经历沉淀</view></view>
  <view wx:if="{{participationTimeline.length}}" class="journey-timeline">
    <view wx:for="{{participationTimeline}}" wx:key="id" class="timeline-item" data-view="experience" data-id="{{item.id}}" bindtap="openFlow">
      <view class="timeline-axis"><view class="timeline-dot"></view><view wx:if="{{index < participationTimeline.length - 1}}" class="timeline-line"></view></view>
      <view class="timeline-content">
        <view class="timeline-meta"><text class="timeline-marker">{{item.marker}}</text><text class="timeline-status">{{item.status}}</text></view>
        <view class="timeline-title">{{item.title}}</view>
        <view class="timeline-place">{{item.meta}}</view>
        <view class="timeline-note">{{item.summary}}</view>
        <view class="timeline-link">查看这期经历 <text>›</text></view>
      </view>
    </view>
  </view>
  <view wx:else class="card mist"><view class="card-title">你的轻生活经历，会从这里开始。</view><button class="secondary" bindtap="openCamp">看看近期轻体营</button></view>

  <view class="section-head"><view class="section-title">其他服务</view><view class="section-note">需要时再进入</view></view>
  <view class="asset-grid">
    <button class="asset" data-view="collections" bindtap="openFlow"><view class="asset-icon mist-bg">藏</view><text>内容收藏</text><text class="asset-note">现有服务优先</text></button>
    <button class="asset" bindtap="openFriends"><view class="asset-icon lavender-bg">友</view><text>公开动态</text><text class="asset-note">{{state.newPosts.length}} 条</text></button>
    <button class="asset" data-view="privacy" bindtap="openFlow"><view class="asset-icon sage-bg">权</view><text>隐私授权</text><text class="asset-note">查看与管理</text></button>
    <button class="asset" data-view="auth" bindtap="openFlow"><view class="asset-icon clay-bg">号</view><text>账号信息</text><text class="asset-note">{{state.phoneLinked ? '已关联' : '待关联'}}</text></button>
  </view>
</view>
