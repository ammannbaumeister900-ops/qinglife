.profile-head { display: flex; align-items: center; gap: 24rpx; margin-bottom: 34rpx; }
.profile-avatar { display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; border-radius: 50%; background: #B78369; color: #fff; font-size: 34rpx; }
.profile-title { margin: 8rpx 0; font-family: serif; font-size: 34rpx; }
.mine-page { padding-top: 44rpx; }
.mine-page .profile-head { padding: 30rpx; border: 1rpx solid rgba(255,255,255,.65); border-radius: 40rpx 40rpx 16rpx 40rpx; background: radial-gradient(circle at 96% 2%, rgba(228,209,194,.58), transparent 34%), rgba(255,252,247,.80); box-shadow: 0 18rpx 48rpx rgba(70,52,36,.07); }
.timeline-head { align-items: flex-start; }
.timeline-head .section-title { margin-top: 0; }
.journey-timeline { position: relative; overflow: hidden; padding: 38rpx 34rpx 20rpx; border: 1rpx solid rgba(255,255,255,.68); border-radius: 42rpx; background: radial-gradient(circle at 100% 0, rgba(240,219,204,.58), transparent 30%), linear-gradient(145deg, rgba(255,252,247,.96), rgba(234,240,232,.82)); box-shadow: 0 20rpx 56rpx rgba(74,61,49,.08); }
.timeline-item { display: flex; gap: 24rpx; min-height: 112rpx; }
.timeline-axis { position: relative; width: 24rpx; flex-shrink: 0; }
.timeline-dot { position: relative; z-index: 2; box-sizing: border-box; width: 22rpx; height: 22rpx; margin-top: 7rpx; border: 6rpx solid #A9775E; border-radius: 50%; background: #FFF9F3; box-shadow: 0 0 0 8rpx rgba(169,119,94,.10); }
.timeline-line { position: absolute; top: 30rpx; left: 10rpx; bottom: -4rpx; width: 2rpx; background: linear-gradient(#CBAE9C, rgba(156,172,150,.42)); }
.timeline-content { flex: 1; padding-bottom: 28rpx; }
.timeline-meta { display: flex; align-items: center; justify-content: space-between; }
.timeline-marker { color: #8B6A58; font-size: 20rpx; letter-spacing: 3rpx; }
.timeline-status { padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(226,233,223,.92); color: #536551; font-size: 19rpx; }
.timeline-place { margin-top: 8rpx; color: #746D65; font-size: 23rpx; }
.timeline-item:active .timeline-content { opacity: .72; }
.asset-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.asset { display: flex; min-height: 210rpx; flex-direction: column; align-items: flex-start; justify-content: center; margin: 0; padding: 28rpx; border: 1rpx solid rgba(255,255,255,.60); border-radius: 34rpx 34rpx 14rpx 34rpx; background: radial-gradient(circle at 96% 4%, rgba(226,209,193,.24), transparent 30%), rgba(255,252,247,.80); box-shadow: 0 14rpx 38rpx rgba(70,52,36,.05); text-align: left; }
.asset:active { opacity: .76; transform: translateY(2rpx); }
.asset text { margin-top: 18rpx; font-weight: 600; }
.asset-icon { display: flex; width: 60rpx; height: 60rpx; align-items: center; justify-content: center; border-radius: 20rpx; }
.sage-bg { background: #E2E9DF; }.clay-bg { background: #F0E0D5; }.mist-bg { background: #E4ECEE; }.lavender-bg { background: #E9E1EB; }
