<launch-splash />
<view class="page">
  <view class="search-row">
    <input class="input search-input" value="{{query}}" placeholder="搜索身体困扰、穴位或内容" bindinput="onQueryInput"/>
    <button wx:if="{{query}}" class="search-clear" bindtap="clearSearch">清除</button>
  </view>

  <view class="content-switch">
    <button class="switch-button {{mode === 'recommend' ? 'active' : ''}}" data-mode="recommend" bindtap="setMode">推荐内容</button>
    <button class="switch-button {{mode === 'directory' ? 'active' : ''}}" data-mode="directory" bindtap="setMode">按问题找</button>
  </view>

  <view class="source-line">
    <view class="source-badge {{source === 'demo' ? 'demo' : ''}}">{{sourceText}}</view>
    <view wx:if="{{error}}" class="section-note">旧接口不可用时已安全回退</view>
  </view>

  <soft-loading wx:if="{{loading}}" text="正在读取内容…" />

  <block wx:elif="{{query}}">
    <view class="section-head"><view class="section-title">搜索结果</view><view class="section-note">{{visibleArticles.length}} 篇</view></view>
    <view wx:if="{{!visibleArticles.length}}" class="card mist">
      <view class="card-title">暂时没有找到相关内容</view>
      <view class="card-copy">可以换一个关键词，或使用“按问题找”。</view>
      <button class="secondary" data-mode="directory" bindtap="setMode">去按问题找</button>
    </view>
    <view wx:for="{{visibleArticles}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openArticle">
      <view class="pill">{{item.category}}</view><view class="card-title">{{item.title}}</view><view class="card-copy">{{item.summary}}</view>
    </view>
  </block>

  <block wx:elif="{{mode === 'recommend'}}">
    <view class="section-head"><view class="section-title">慢慢读</view><view class="section-note">文章与日常陪伴</view></view>
    <view wx:for="{{visibleArticles}}" wx:key="id" class="card {{index % 3 === 0 ? 'sage' : index % 3 === 1 ? 'mist' : 'lavender'}}" data-id="{{item.id}}" bindtap="openArticle">
      <view class="pill">{{item.category}}</view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-copy">{{item.summary}}</view>
      <view class="section-note">{{item.author}} · 阅读全文 ›</view>
    </view>

    <view class="section-head"><view class="section-title">通告</view><view class="section-note">按权限展示</view></view>
    <view class="card">
      <view wx:for="{{notices}}" wx:key="id" class="list-row">
        <view class="list-main"><text class="list-title">{{item.title}}</text><text class="list-note">{{item.note}}</text></view><text>›</text>
      </view>
    </view>

    <view class="section-head"><view class="section-title">拍打练习</view><view class="section-note">演示入口</view></view>
    <view class="card clay">
      <view wx:for="{{videos}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="showVideo">
        <view class="pill">▶</view><view class="list-main"><text class="list-title">{{item.title}}</text><text class="list-note">{{item.note}}</text></view><text>›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="hero"><view class="eyebrow">BODY CONTENT DIRECTORY</view><view class="hero-title">不知道拍哪里时，先从此刻的感受开始。</view><view class="hero-copy">困扰 → 区域与穴位 → 练习。仅用于日常内容导航，不构成医学诊断。</view></view>
    <view wx:for="{{hierarchy}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="selectConcern">
      <view class="eyebrow">0{{index + 1}}</view><view class="card-title">{{item.title}}</view><view class="card-copy">{{item.note}}</view>
    </view>
    <view wx:if="{{selectedConcern}}" class="card sage">
      <view class="pill">当前选择</view>
      <view class="card-title">{{selectedConcern.title}}</view>
      <view class="list-row"><view class="list-main"><text class="list-title">建议先了解的区域</text><text class="list-note">{{selectedConcern.region}}</text></view></view>
      <view class="list-row"><view class="list-main"><text class="list-title">相关穴位定位内容</text><text class="list-note">{{selectedConcern.points}}</text></view></view>
      <view class="privacy-note">{{selectedConcern.reminder}}</view>
    </view>
  </block>
</view>
