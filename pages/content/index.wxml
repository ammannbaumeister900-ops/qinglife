<launch-splash />
<view class="page content-page editorial-page">
  <view class="search-row">
    <input class="input search-input" value="{{query}}" placeholder="搜索身体困扰、穴位或内容" bindinput="onQueryInput"/>
    <button wx:if="{{query}}" class="search-clear" bindtap="clearSearch">清除</button>
  </view>

  <view class="content-switch">
    <button class="switch-button {{mode === 'recommend' ? 'active' : ''}}" data-mode="recommend" bindtap="setMode">推荐内容</button>
    <button class="switch-button {{mode === 'directory' ? 'active' : ''}}" data-mode="directory" bindtap="setMode">按问题找</button>
  </view>

  <soft-loading wx:if="{{loading}}" text="正在读取内容…" />

  <block wx:elif="{{query}}">
    <view class="section-head"><view class="section-title">搜索结果</view><view class="section-note">{{visibleArticles.length}} 篇</view></view>
    <view wx:if="{{!visibleArticles.length}}" class="card mist">
      <view class="card-title">暂时没有找到相关内容</view>
      <view class="card-copy">可以换一个关键词，或使用“按问题找”。</view>
      <button class="secondary" data-mode="directory" bindtap="setMode">去按问题找</button>
    </view>
    <view wx:for="{{visibleArticles}}" wx:key="id" class="card article-card" data-id="{{item.id}}" bindtap="openArticle">
      <view class="pill">{{item.category}}</view><view class="card-title">{{item.title}}</view><view class="card-copy">{{item.summary}}</view>
      <view class="article-footer"><text>{{item.author}}</text></view>
    </view>
  </block>

  <block wx:elif="{{mode === 'recommend'}}">
    <view class="section-head"><view class="section-title">慢慢读</view></view>
    <view wx:for="{{visibleArticles}}" wx:key="id" class="card article-card {{index % 3 === 0 ? 'sage' : index % 3 === 1 ? 'mist' : 'lavender'}}" data-id="{{item.id}}" bindtap="openArticle">
      <view class="pill">{{item.category}}</view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-copy">{{item.summary}}</view>
      <view class="article-footer"><text>{{item.author}}</text></view>
    </view>

    <view class="section-head"><view class="section-title">通告</view></view>
    <view class="card">
      <view wx:for="{{notices}}" wx:key="id" class="list-row">
        <view class="list-main"><text class="list-title">{{item.title}}</text><text class="list-note">{{item.note}}</text></view><text>›</text>
      </view>
    </view>

    <view class="section-head"><view class="section-title">拍打练习</view></view>
    <view class="card clay">
      <view wx:for="{{videos}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="showVideo">
        <view class="pill">▶</view><view class="list-main"><text class="list-title">{{item.title}}</text><text class="list-note">{{item.note}}</text></view><text>›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="directory-hero">
      <view class="directory-copy"><view class="eyebrow">从此刻的感受开始</view><view class="directory-title">今天，身体哪里想被照顾？</view><view class="directory-note">先选择接近的状态，再慢慢找到适合的内容。</view></view>
      <view class="scene-art"><view class="scene-sun"></view><view class="scene-leaf scene-leaf-one"></view><view class="scene-leaf scene-leaf-two"></view></view>
    </view>

    <view class="concern-grid">
      <button wx:for="{{hierarchy}}" wx:key="id" class="concern-tab {{selectedConcern.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectConcern">
        <text class="concern-number">0{{index + 1}}</text><text class="concern-name">{{item.shortTitle}}</text>
      </button>
    </view>

    <view wx:if="{{selectedConcern}}" class="directory-panel">
      <view class="panel-head"><view><view class="eyebrow">{{selectedConcern.shortTitle}}</view><view class="panel-title">{{selectedConcern.scene}}</view></view><view class="panel-mark">轻</view></view>
      <view class="subtopic-list">
        <view wx:for="{{selectedConcern.subtopics}}" wx:key="*this" class="subtopic-row"><view class="subtopic-dot"></view><text>{{item}}</text></view>
      </view>
      <view class="guide-summary"><view><text class="guide-label">建议先了解</text><text class="guide-text">{{selectedConcern.region}} · {{selectedConcern.points}}</text></view><button class="guide-action" data-mode="recommend" bindtap="setMode">查看相关文章</button></view>
      <view class="privacy-note">{{selectedConcern.reminder}}</view>
    </view>
  </block>
</view>
