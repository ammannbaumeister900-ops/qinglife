.search-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 22rpx; }
.search-input { flex: 1; }
.search-clear { margin: 0; padding: 0 16rpx; background: transparent; color: #9B6F58; font-size: 24rpx; }
.content-page .search-input { border-color: rgba(255,255,255,.68); background: rgba(255,252,247,.84); box-shadow: 0 12rpx 32rpx rgba(70,52,36,.05); }
.content-switch { display: flex; margin-bottom: 22rpx; padding: 8rpx; border: 1rpx solid rgba(255,255,255,.52); border-radius: 28rpx; background: linear-gradient(135deg, rgba(237,229,216,.88), rgba(231,236,226,.80)); box-shadow: 0 10rpx 28rpx rgba(70,52,36,.04); }
.switch-button { flex: 1; margin: 0; border-radius: 22rpx; background: transparent; color: #7D756D; font-size: 25rpx; }
.switch-button.active { background: #FFFCF7; color: #2C2A26; box-shadow: 0 6rpx 20rpx rgba(74, 61, 49, 0.06); }
.source-line { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }

.article-card { transition: transform 180ms ease, opacity 180ms ease; }
.content-page .article-card { border-radius: 38rpx 38rpx 16rpx 38rpx; }
.article-card:active { opacity: .86; transform: translateY(2rpx); }
.article-card .card-copy { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.article-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(74,61,49,.08); color: #8A8178; font-size: 22rpx; }
.read-more { color: #8C604A; font-weight: 600; letter-spacing: 1rpx; }

.directory-hero { position: relative; display: flex; min-height: 260rpx; overflow: hidden; margin-bottom: 22rpx; padding: 38rpx; border: 1rpx solid rgba(255,255,255,.7); border-radius: 42rpx; background: radial-gradient(circle at 92% 4%, rgba(255,244,211,.88), transparent 30%), linear-gradient(135deg, #DDE4D8, #B9C8B0 58%, #D8D4BF); box-shadow: 0 20rpx 54rpx rgba(64,79,58,.10); }
.directory-copy { position: relative; z-index: 2; width: 72%; }
.directory-title { margin-top: 18rpx; font-family: serif; font-size: 42rpx; line-height: 1.4; }
.directory-note { margin-top: 16rpx; color: #5F675A; font-size: 24rpx; line-height: 1.65; }
.scene-art { position: absolute; right: 0; bottom: 0; width: 230rpx; height: 250rpx; }
.scene-sun { position: absolute; top: 18rpx; right: 30rpx; width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,244,209,.62); }
.scene-leaf { position: absolute; bottom: -36rpx; width: 78rpx; height: 200rpx; border-radius: 90% 12% 88% 18%; background: rgba(69,93,63,.34); }
.scene-leaf-one { right: 18rpx; transform: rotate(24deg); }
.scene-leaf-two { right: 92rpx; bottom: -78rpx; background: rgba(85,111,77,.24); transform: rotate(-18deg); }

.concern-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.concern-tab { display: flex; min-height: 96rpx; align-items: center; gap: 14rpx; margin: 0; padding: 18rpx 20rpx; border: 1rpx solid rgba(74,61,49,.10); border-radius: 28rpx; background: rgba(255,252,247,.76); color: #655E57; font-size: 24rpx; text-align: left; line-height: 1.4; }
.concern-tab.active { border-color: rgba(114,139,105,.34); background: #E5EBE1; color: #354433; box-shadow: 0 10rpx 28rpx rgba(62,79,55,.08); }
.concern-number { color: #A57B64; font-family: serif; font-size: 20rpx; }
.concern-name { font-weight: 600; }

.directory-panel { margin-bottom: 24rpx; padding: 38rpx; border: 1rpx solid rgba(255,255,255,.68); border-radius: 40rpx; background: radial-gradient(circle at 100% 0, rgba(240,219,204,.54), transparent 34%), rgba(255,252,247,.90); box-shadow: 0 20rpx 54rpx rgba(74,61,49,.08); }
.panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; }
.panel-title { margin-top: 14rpx; font-family: serif; font-size: 36rpx; line-height: 1.45; }
.panel-mark { display: flex; width: 54rpx; height: 54rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 16rpx; background: #A9775E; color: #FFF9F3; font-family: serif; }
.subtopic-list { margin-top: 28rpx; border-top: 1rpx solid rgba(74,61,49,.08); }
.subtopic-row { display: flex; min-height: 84rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid rgba(74,61,49,.08); color: #48443F; }
.subtopic-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #9CAC96; }
.guide-summary { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 26rpx; }
.guide-label, .guide-text { display: block; }
.guide-label { color: #8A8178; font-size: 21rpx; }
.guide-text { margin-top: 8rpx; color: #57514B; font-size: 23rpx; line-height: 1.5; }
.guide-action { flex-shrink: 0; margin: 0; padding: 16rpx 20rpx; border-radius: 22rpx; background: #2C2A26; color: #FFFCF7; font-size: 22rpx; line-height: 1.4; }
