<view class="page">
  <view wx:if="{{loading}}" class="empty">正在读取文章…</view>
  <block wx:else>
    <view class="source-badge {{source === 'demo' ? 'demo' : ''}}">{{source === 'legacy' ? '现有文章服务' : '演示内容'}}</view>
    <view class="hero">
      <view class="eyebrow">{{article.category}}</view>
      <view class="hero-title">{{article.title}}</view>
      <view class="hero-copy">{{article.author}} · {{article.date}}</view>
    </view>
    <view class="card article-body">
      <rich-text nodes="{{article.content || article.summary}}"></rich-text>
    </view>
    <view class="privacy-note">健康相关内容仅用于日常生活方式参考；明显、持续或突然出现的不适应停止练习并寻求专业评估。</view>
    <button class="primary" bindtap="toggleCollect">{{collected ? '取消收藏' : '收藏文章'}}</button>
    <button class="secondary" open-type="share">分享这篇内容</button>
  </block>
</view>

