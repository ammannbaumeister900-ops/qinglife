.home-page {
  position: relative;
  overflow: hidden;
  padding-top: 44rpx;
  background:
    radial-gradient(circle at 94% 3%, rgba(216, 193, 173, 0.42), transparent 27%),
    radial-gradient(circle at 2% 42%, rgba(166, 182, 162, 0.22), transparent 31%),
    repeating-linear-gradient(115deg, rgba(90, 75, 58, 0.018) 0 1rpx, transparent 1rpx 7rpx),
    #F4EFE5;
}

.home-page > view:not(.home-air):not(.botanical-shadow) {
  position: relative;
  z-index: 2;
}

.home-air {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
}

.home-air-clay {
  top: 180rpx;
  right: -170rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(183, 131, 105, 0.13);
}

.home-air-sage {
  top: 760rpx;
  left: -240rpx;
  width: 520rpx;
  height: 520rpx;
  background: rgba(166, 182, 162, 0.08);
}

.botanical-shadow {
  position: absolute;
  z-index: 1;
  width: 104rpx;
  height: 230rpx;
  border-radius: 90% 14% 82% 20%;
  background: rgba(103, 126, 94, 0.09);
  pointer-events: none;
}

.botanical-shadow-top {
  top: 106rpx;
  right: -44rpx;
  transform: rotate(30deg);
}

.home-section-head {
  margin-top: 0;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.home-section-head .section-title {
  max-width: 440rpx;
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.34;
  letter-spacing: 1rpx;
}

.home-section-head .section-note {
  margin-top: 50rpx;
}

.home-task {
  position: relative;
  overflow: hidden;
  padding: 42rpx;
  border-color: rgba(255, 255, 255, 0.72);
  background:
    radial-gradient(circle at 100% 0, rgba(195, 208, 214, 0.40), transparent 31%),
    linear-gradient(145deg, rgba(255, 252, 247, 0.96), rgba(246, 237, 226, 0.90));
  box-shadow: 0 24rpx 64rpx rgba(70, 52, 36, 0.09);
}

.home-task::after {
  content: '';
  position: absolute;
  right: -34rpx;
  bottom: -86rpx;
  width: 250rpx;
  height: 250rpx;
  border: 1rpx solid rgba(183, 131, 105, 0.13);
  border-radius: 50%;
}

.home-task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-mark {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: #A9775E;
  color: #FFF9F3;
  font-family: serif;
  font-size: 24rpx;
}

.home-task-title {
  max-width: 520rpx;
  margin-top: 24rpx;
  font-size: 40rpx;
  line-height: 1.45;
}

.home-task-copy {
  max-width: 520rpx;
}

.home-task .primary {
  position: relative;
  z-index: 1;
  min-width: 246rpx;
  border-radius: 26rpx;
  background: #A9775E;
  box-shadow: 0 12rpx 28rpx rgba(169, 119, 94, 0.22);
}

.daily-guide,
.journey-card {
  border-color: rgba(255, 255, 255, 0.62);
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.7), transparent 27%),
    rgba(232, 238, 226, 0.82);
  box-shadow: 0 18rpx 46rpx rgba(62, 79, 55, 0.07);
}

.journey-card {
  background:
    radial-gradient(circle at 92% 8%, rgba(255, 255, 255, 0.74), transparent 27%),
    rgba(227, 237, 238, 0.84);
}

.latest-section {
  margin-top: 48rpx;
}

.latest-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.latest-section-title {
  font-size: 34rpx;
}

.latest-article {
  display: flex;
  gap: 28rpx;
  overflow: hidden;
  padding: 18rpx;
  border-color: rgba(74, 61, 49, 0.08);
  background: rgba(255, 252, 247, 0.72);
  box-shadow: none;
  transition: transform 180ms ease, opacity 180ms ease;
}

.latest-article:active {
  opacity: 0.86;
  transform: translateY(2rpx);
}

.latest-visual {
  position: relative;
  width: 210rpx;
  min-height: 260rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 28% 20%, rgba(250, 234, 191, 0.86), transparent 18%),
    linear-gradient(145deg, #D8D7BF, #9BAA8F 55%, #CBD2C1);
}

.latest-sun {
  position: absolute;
  top: 24rpx;
  left: 28rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 244, 209, 0.68);
}

.latest-leaf {
  position: absolute;
  width: 72rpx;
  height: 150rpx;
  border-radius: 90% 12% 88% 18%;
  background: rgba(67, 91, 61, 0.46);
}

.latest-leaf-one {
  right: 24rpx;
  bottom: -22rpx;
  transform: rotate(27deg);
}

.latest-leaf-two {
  right: 86rpx;
  bottom: -64rpx;
  background: rgba(89, 111, 78, 0.30);
  transform: rotate(-18deg);
}

.latest-visual-label {
  position: absolute;
  bottom: 18rpx;
  left: 18rpx;
  color: rgba(255, 252, 247, 0.88);
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.latest-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 10rpx 16rpx 10rpx 0;
}

.latest-content .card-title {
  margin-top: 14rpx;
  font-size: 31rpx;
  line-height: 1.45;
}

.latest-content .card-copy {
  display: -webkit-box;
  overflow: hidden;
  font-size: 23rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.latest-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  color: #8B6A58;
  font-size: 20rpx;
}
