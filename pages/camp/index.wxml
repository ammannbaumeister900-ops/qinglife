<launch-splash />
<view class="page camp-page">
  <view class="camp-air camp-air-sage"></view>
  <view class="camp-air camp-air-clay"></view>
  <view class="camp-leaf-shadow"></view>

  <view class="hero camp-hero">
    <view class="hero-title">三日轻体营，是轻生活的线下起点。</view>
    <view class="hero-copy">连续三天慢下来，从饮食、呼吸与身体感受中，找到适合自己的生活节奏。</view>
    <view class="camp-hero-line"></view>
    <view class="camp-hero-note">饮食 · 呼吸 · 身体感受</view>
  </view>

  <view wx:if="{{state.registration.status !== 'none'}}" class="card sage current-camp">
    <view class="pill">{{state.registration.status === 'pending' ? '待运营确认' : state.registration.status === 'completed' ? '已结束' : '报名成功'}}</view>
    <view class="card-title">{{current.name}}</view>
    <view class="card-copy">{{current.date}} · {{current.city}}{{current.place}}</view>
    <button class="primary" bindtap="openCurrent">{{state.registration.status === 'completed' ? '查看体验记录' : '查看活动行程'}}</button>
  </view>

  <view class="section-head camp-section-head">
    <view class="section-title">近期轻体营</view>
  </view>

  <view
    wx:for="{{activities}}"
    wx:key="id"
    class="card activity-card"
    data-id="{{item.id}}"
    bindtap="openActivity"
  >
    <view class="activity-top">
      <view class="pill">第 {{item.sessionNumber}} 期 · {{item.status}}</view>
      <view class="activity-arrow">↗</view>
    </view>
    <view class="card-title">{{item.name}}</view>
    <view class="activity-details">
      <view class="activity-detail">
        <view class="activity-detail-label">日期</view>
        <view class="card-copy">{{item.date}}</view>
      </view>
      <view class="activity-detail">
        <view class="activity-detail-label">地点</view>
        <view class="card-copy">{{item.city}}{{item.place}}</view>
      </view>
    </view>
    <view class="activity-footer">
      <view class="activity-fee">¥{{item.fee}}<text>/人</text></view>
      <view class="activity-link">查看详情 ›</view>
    </view>
  </view>

  <view class="section-head camp-section-head">
    <view class="section-title">本期带领人</view>
  </view>

  <view class="card leader-card">
    <view wx:for="{{leaders}}" wx:key="name" class="leader-row">
      <view class="leader-avatar {{item.tone}}">
        <view class="leader-avatar-light"></view>
        <text>{{item.avatarText}}</text>
      </view>
      <view class="list-main">
        <view class="leader-name">{{item.name}}</view>
        <view class="leader-intro">{{item.intro}}</view>
      </view>
    </view>
  </view>
</view>
