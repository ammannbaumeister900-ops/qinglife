<launch-splash />
<view class="page">
  <view class="brand-row">
    <view>
      <view class="brand-cn">轻体营</view>
      <view class="brand-en">THE CORE EXPERIENCE</view>
    </view>
  </view>

  <view class="hero">
    <view class="hero-title">三日轻体营，是轻生活的线下起点。</view>
    <view class="hero-copy">连续三天慢下来，从饮食、呼吸与身体感受中，找到适合自己的生活节奏。</view>
  </view>

  <view wx:if="{{state.registration.status !== 'none'}}" class="card sage">
    <view class="pill">{{state.registration.status === 'pending' ? '待运营确认' : state.registration.status === 'completed' ? '已结束' : '报名成功'}}</view>
    <view class="card-title">{{current.name}}</view>
    <view class="card-copy">{{current.date}} · {{current.city}}{{current.place}}</view>
    <view class="card-copy">每名实际参与者分别保留报名和签到记录。</view>
    <button class="primary" bindtap="openCurrent">{{state.registration.status === 'completed' ? '查看体验记录' : '查看活动行程'}}</button>
  </view>

  <view class="section-head">
    <view class="section-title">近期轻体营</view>
    <view class="section-note">了解与报名</view>
  </view>

  <view
    wx:for="{{activities}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    bindtap="openActivity"
  >
    <view class="pill">第 {{item.sessionNumber}} 期 · {{item.status}}</view>
    <view class="card-title">{{item.name}}</view>
    <view class="card-copy">{{item.date}} · {{item.city}}{{item.place}}</view>
    <view class="card-copy">¥{{item.fee}}/人 · 费用仅展示</view>
    <view class="divider"></view>
    <view class="activity-link">查看详情 ›</view>
  </view>

  <view class="section-head">
    <view class="section-title">本期带领人</view>
    <view class="section-note">固定陪伴团队</view>
  </view>

  <view class="card leader-card">
    <view wx:for="{{leaders}}" wx:key="name" class="leader-row">
      <view class="leader-avatar {{item.tone}}">{{item.avatarText}}</view>
      <view class="list-main">
        <view class="leader-name">{{item.name}}</view>
        <view class="leader-intro">{{item.intro}}</view>
      </view>
    </view>
  </view>
</view>
