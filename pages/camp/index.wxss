.camp-page {
  position: relative;
  overflow: hidden;
  padding-top: 44rpx;
  background:
    radial-gradient(circle at 92% 6%, rgba(166, 182, 162, 0.34), transparent 28%),
    radial-gradient(circle at 2% 54%, rgba(216, 193, 173, 0.22), transparent 31%),
    repeating-linear-gradient(115deg, rgba(76, 91, 69, 0.018) 0 1rpx, transparent 1rpx 7rpx),
    #F2F0E7;
}

.camp-page > view:not(.camp-air):not(.camp-leaf-shadow) {
  position: relative;
  z-index: 2;
}

.camp-air {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
}

.camp-air-sage {
  top: 170rpx;
  right: -210rpx;
  width: 480rpx;
  height: 480rpx;
  border: 1rpx solid rgba(95, 119, 84, 0.15);
}

.camp-air-clay {
  top: 1080rpx;
  left: -270rpx;
  width: 560rpx;
  height: 560rpx;
  background: rgba(216, 193, 173, 0.09);
}

.camp-leaf-shadow {
  position: absolute;
  z-index: 1;
  top: 96rpx;
  right: -48rpx;
  width: 122rpx;
  height: 270rpx;
  border-radius: 90% 12% 86% 17%;
  background: rgba(76, 105, 68, 0.10);
  transform: rotate(28deg);
  pointer-events: none;
}

.camp-hero {
  box-sizing: border-box;
  min-height: 400rpx;
  margin-bottom: 46rpx;
  padding: 38rpx 34rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 48rpx 48rpx 18rpx 48rpx;
  background:
    radial-gradient(circle at 84% 15%, rgba(255, 248, 218, 0.68), transparent 20%),
    radial-gradient(ellipse at 95% 100%, rgba(95, 122, 85, 0.38), transparent 36%),
    linear-gradient(145deg, rgba(247, 244, 231, 0.94), rgba(215, 225, 205, 0.84));
  box-shadow: 0 24rpx 66rpx rgba(55, 72, 49, 0.10);
}

.camp-hero .eyebrow {
  color: #6C8065;
}

.camp-hero .hero-title {
  max-width: 560rpx;
  margin-top: 28rpx;
  font-size: 49rpx;
  line-height: 1.42;
  letter-spacing: 1rpx;
}

.camp-hero .hero-copy {
  max-width: 570rpx;
  font-size: 27rpx;
}

.camp-hero-line {
  width: 52rpx;
  height: 2rpx;
  margin-top: 34rpx;
  background: rgba(74, 95, 67, 0.38);
}

.camp-hero-note {
  margin-top: 14rpx;
  color: #70806A;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.current-camp {
  border-color: rgba(255, 255, 255, 0.65);
  background:
    radial-gradient(circle at 92% 6%, rgba(255, 255, 255, 0.70), transparent 28%),
    rgba(229, 237, 224, 0.86);
  box-shadow: 0 18rpx 50rpx rgba(56, 73, 50, 0.08);
}

.current-camp .primary {
  background: #687C5F;
  box-shadow: 0 12rpx 28rpx rgba(84, 107, 76, 0.20);
}

.camp-section-head {
  margin-top: 52rpx;
  margin-bottom: 24rpx;
}

.camp-section-head .section-title {
  font-size: 38rpx;
}

.activity-card {
  padding: 38rpx;
  border-color: rgba(74, 61, 49, 0.08);
  background:
    radial-gradient(circle at 100% 0, rgba(216, 193, 173, 0.17), transparent 31%),
    rgba(255, 252, 247, 0.80);
  box-shadow: 0 18rpx 48rpx rgba(70, 52, 36, 0.055);
  transition: transform 180ms ease, opacity 180ms ease;
}

.activity-card:active {
  opacity: 0.88;
  transform: translateY(3rpx);
}

.activity-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.activity-arrow {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(83, 101, 81, 0.16);
  border-radius: 50%;
  color: #657462;
  font-size: 25rpx;
}

.activity-card .card-title {
  margin-top: 26rpx;
  font-size: 38rpx;
}

.activity-details {
  display: flex;
  gap: 28rpx;
  margin-top: 26rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(74, 61, 49, 0.07);
  border-bottom: 1rpx solid rgba(74, 61, 49, 0.07);
}

.activity-detail {
  min-width: 0;
  flex: 1;
}

.activity-detail + .activity-detail {
  padding-left: 28rpx;
  border-left: 1rpx solid rgba(74, 61, 49, 0.07);
}

.activity-detail-label {
  margin-bottom: 7rpx;
  color: #8B847C;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.activity-details .card-copy {
  font-size: 24rpx;
}

.activity-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
}

.activity-fee {
  color: #4D554A;
  font-family: serif;
  font-size: 32rpx;
}

.activity-fee text {
  margin-left: 4rpx;
  color: #827B74;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 20rpx;
}

.activity-link {
  color: #6F8069;
  font-size: 23rpx;
  text-align: right;
}

.leader-card {
  padding: 14rpx 34rpx;
  border-color: rgba(74, 61, 49, 0.08);
  background:
    radial-gradient(circle at 94% 8%, rgba(166, 182, 162, 0.18), transparent 27%),
    rgba(255, 252, 247, 0.76);
  box-shadow: none;
}

.leader-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(74, 61, 49, 0.08);
}

.leader-row:last-child {
  border-bottom: none;
}

.leader-avatar {
  position: relative;
  display: flex;
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 52% 48% 55% 45%;
  color: #4A4039;
  font-family: serif;
  font-size: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(70, 52, 36, 0.08);
  transform: rotate(-3deg);
}

.leader-avatar text {
  position: relative;
  z-index: 2;
  transform: rotate(3deg);
}

.leader-avatar-light {
  position: absolute;
  top: -14rpx;
  left: -10rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.38);
}

.leader-avatar.clay { background: linear-gradient(145deg, #EFDCCF, #D7BCAA); }
.leader-avatar.mist { background: linear-gradient(145deg, #E4EDEF, #BFCFD1); }
.leader-avatar.sage { background: linear-gradient(145deg, #E5EBDD, #BECBBA); }

.leader-name {
  font-family: serif;
  font-size: 30rpx;
  font-weight: 500;
}

.leader-intro {
  margin-top: 8rpx;
  color: #746D65;
  font-size: 24rpx;
  line-height: 1.6;
}
